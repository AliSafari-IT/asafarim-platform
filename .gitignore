# dependencies
node_modules/

# builds
.next/
.next-corrupt-*/
dist/
build/
out/

# turborepo
.turbo/

# environment
.env
.env.*
!.env.example
!.env.local.example
!.env.production.example

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# misc
.DS_Store
Thumbs.db
*.tsbuildinfo

# Local document-generation work files
tmp/pdfs/

# IDE
.vscode/
.idea/

# --- envage managed ---
# Decrypted env files — never commit
.env*
!.env*.age
!.env.example
!.env.*.example
!.env.template
# Age keys: commit only the public recipient, never the private identity
.age/*
!.age/key.pub
# --- end envage ---

# Vionto app artifacts
apps/vionto/worker-dist/
apps/vionto/.local-storage/
apps/appbuilder/.local-storage/
apps/resumatch/.local-storage/
apps/testora/.local-storage/

# CI status script output (scripts/ci-status-summary.mts), regenerated per run
/ci-status-artifact/

# Playwright artifacts (test-results/, HTML reports, and saved E2E session
# cookies from e2e/global-setup.ts — never commit an authenticated session)
apps/*/test-results/
apps/*/playwright-report/
apps/*/e2e/.auth/

# review documents
docs/review/

# billable AI eval report artifacts (evals/run.ts, JM-045) — regenerated
# per run against a real provider, never committed
apps/*/evals/reports/

next-env.d.ts

# ResuMatch's own Prisma client is generated into the app (see
# apps/resumatch/prisma/schema.prisma for why it cannot live in node_modules).
apps/resumatch/lib/db/generated/

# TasksAI's own Prisma client, same reason (docs/adr/0001-dedicated-database.md).
apps/tasks-ai/lib/db/generated/

# Local AI tooling config (not repo content).
.claude.json

# Deploy concurrency lock (infra/scripts/vps-deploy.sh) — created on the VPS's
# own checkout via `exec 9>`/`flock` so overlapping deploy runs can't race
# each other. It's local machine state, never repo content.
/.vps-deploy.lock
/.deploy/

# Untracked, per-commit copy of vps-deploy.sh that deploy.yml/deploy-prod.sh
# extract via `git show <ref>:path` and run directly, so opening it can never
# race the tracked file it's a snapshot of (see infra/scripts/deploy-prod.sh).
# Self-removed on exit; ignored here only as a safety net against a crash.
/infra/scripts/.vps-deploy.*.sh

# Synthetic TasksAI test identities/credentials (#742): local output of
# db:seed:tasksai-identities and apps/tasks-ai test-data. Never commit.
.tasksai-test/

# Compiled app manifests (asafarim-os `platform manifest compile`): generated in CI
# for the drift report, never committed; the source is apps/*/platform.app.ts.
apps/*/platform.app.json
