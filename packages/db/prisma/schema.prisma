// ASafarIM Platform — Prisma Schema
// Foundation only: Auth.js v5 required tables + RBAC + audit log.
// Migrated from asafarim-digital (source of truth); product-specific models
// (Edu*, Vionto*, Content*, Marketing*, Tenant/billing) follow in later PRs.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

// ─── Auth.js Required Models ───────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  username      String?   @unique
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  jobTitle      String?
  company       String?
  website       String?
  location      String?
  bio           String?   @db.Text

  // Cross-app profile fields — kept minimal and generic so any app can rely
  // on them without asserting product-specific meaning (e.g. no "gradeLevel"
  // here; that belongs on a future product-specific profile extension).
  phone           String?
  preferredLocale String?
  timezone        String?

  isActive      Boolean   @default(true)
  deactivatedAt DateTime?

  // Auth.js relations
  accounts Account[]
  sessions Session[]

  // RBAC: many-to-many roles
  userRoles UserRole[]

  // Audit trail
  auditLogs AuditLog[]

  // Structured, multi-app-scoped addresses (see UserLocation below)
  locations UserLocation[]

  // EduMatch — AI learning support and tutor marketplace
  eduStudentProfile             EduStudentProfile?
  eduTutorProfile               EduTutorProfile?
  eduInquiries                  EduInquiry[]
  eduQuotes                     EduQuote[]
  eduStudentBookings            EduBooking[]               @relation("EduBookingStudent")
  eduTutorBookings              EduBooking[]               @relation("EduBookingTutor")
  eduTransactions               EduTransaction[]
  eduWallet                     EduWallet?
  eduNotifications              EduNotification[]
  eduMessages                   EduMessage[]
  eduNotificationPrefs          EduNotificationPreference?
  eduTutorVerifications         EduTutorVerification[]     @relation("EduTutorVerificationTutor")
  eduTutorVerificationsReviewed EduTutorVerification[]     @relation("EduTutorVerificationReviewer")
  eduVerificationMessages       EduVerificationMessage[]   @relation("EduVerificationMessageTutor")
  eduVerificationMessagesSent   EduVerificationMessage[]   @relation("EduVerificationMessageSender")
  eduAuditEventsActor           EduAuditEvent[]            @relation("EduAuditActor")

  // EduMatch — learning-brief experience (conversational intake → journey)
  eduLearningBriefs        EduLearningBrief[]
  eduMatchCandidates       EduMatchCandidate[]
  eduSessionRecordsStudent EduSessionRecord[]  @relation("EduSessionRecordStudent")
  eduSessionRecordsTutor   EduSessionRecord[]  @relation("EduSessionRecordTutor")
  eduReviewsWritten        EduReview[]         @relation("EduReviewStudent")
  eduReviewsReceived       EduReview[]         @relation("EduReviewTutor")

  // EduMatch — age-aware accounts (parent-managed minors)
  eduParentProfile EduParentProfile?

  // Vionto — photo-to-story video pipeline
  viontoProjects         ViontoProject[]
  viontoAuditEvents      ViontoAuditEvent[]      @relation("ViontoAuditActor")
  viontoUsageMetrics     ViontoUsageMetric[]
  viontoSharesSent       ViontoProjectShare[]    @relation("ViontoSharesSent")
  viontoSharesReceived   ViontoProjectShare[]    @relation("ViontoSharesReceived")
  googlePhotosConnection GooglePhotosConnection?

  // Contact inbox — messages this user sent through the contact workspace
  contactMessages ContactMessage[]

  // TimelineAI — visual timeline builder
  timelineTimelines   Timeline[]
  timelineModerations TimelineModerationEvent[] @relation("TimelineModerationActor")

  // Seed Data management — control-plane history and schedules this user owns
  seedOperations       SeedOperation[]          @relation("SeedOperationActor")
  seedSchedulesCreated SeedValidationSchedule[] @relation("SeedScheduleCreator")
  seedSchedulesUpdated SeedValidationSchedule[] @relation("SeedScheduleUpdater")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([username])
  @@index([isActive])
}

/// Structured address, reusable across apps (e.g. a future EduMatch tutor
/// service radius, a shipping address for a storefront). A user may have
/// several — home/work/billing/etc — each optionally scoped to specific apps
/// via `appScope`. Ported shape from the asafarim-digital `UserLocation`
/// model; trimmed to what this platform actually needs today.
model UserLocation {
  id     String  @id @default(cuid())
  userId String
  type   String  @default("home") // home, work, billing, shipping, other
  label  String? // custom label, e.g. "My apartment"

  // Address components
  formatted   String? // full formatted address
  street1     String?
  street2     String?
  city        String?
  state       String? // state/province/region
  postalCode  String?
  country     String? // ISO 3166-1 alpha-2 (e.g. "US", "NL")
  countryName String?

  // Geolocation (decimal degrees, WGS84)
  lat      Float?
  lng      Float?
  accuracy Float? // GPS accuracy in meters, if from a browser

  // Metadata
  timezone   String? // IANA timezone, e.g. "Europe/Amsterdam"
  isPrimary  Boolean @default(false)
  isVerified Boolean @default(false) // verified via geocoding?
  source     String  @default("manual") // manual, browser, geocoded, ip

  // Optional per-app scoping — an empty array means "visible to every app".
  appScope String[] @default([])

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, type, label])
  @@index([userId])
  @@index([userId, type])
  @@index([lat, lng])
  @@index([country, city])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Email One-Time Login Code ──────────────────────────────────

/// Short-lived 6-character OTP used for passwordless email-code login.
/// Codes are single-use and expire after EMAIL_LOGIN_CODE_TTL_MINUTES (default 10).
/// Rate limits: max 5 requests per email per 15 min; max 5 failed verify attempts.
model EmailLoginCode {
  id        String    @id @default(cuid())
  /// The email address the code was sent to (lowercased)
  email     String
  /// SHA-256 hex digest of the uppercased 6-character code
  codeHash  String
  /// When this code expires
  expiresAt DateTime
  /// Set when the code is successfully consumed
  usedAt    DateTime?
  /// Number of failed verification attempts against this code
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([email, createdAt])
  @@index([expiresAt])
}

// ─── RBAC Models ───────────────────────────────────────────────

model Role {
  id          String  @id @default(cuid())
  name        String  @unique
  displayName String
  description String? @db.Text
  isSystem    Boolean @default(false)
  isDefault   Boolean @default(false)

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([isDefault])
}

model Permission {
  id          String  @id @default(cuid())
  name        String  @unique
  displayName String
  description String?
  group       String

  rolePermissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([group])
}

model UserRole {
  id         String   @id @default(cuid())
  userId     String
  roleId     String
  assignedAt DateTime @default(now())
  assignedBy String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

// ─── Platform Settings ─────────────────────────────────────────

/// Bounded, database-editable platform configuration. Only keys declared in
/// the admin app's typed setting catalog (apps/admin/lib/settings.ts) are
/// ever written here — this is intentionally NOT a free-form key/value
/// store, and secrets never belong in it. Environment configuration
/// (URLs, credentials) stays in env vars and is read-only in the UI.
model PlatformSetting {
  id        String  @id @default(cuid())
  key       String  @unique
  value     Json
  updatedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
}

// ─── Audit Log ─────────────────────────────────────────────────

model AuditLog {
  id        String  @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  changes   Json?
  ipAddress String?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity])
  @@index([action])
  @@index([createdAt])
}

// ─── Vionto — Photo-to-Story Video Pipeline ──────────────────
//
// Ported from asafarim-digital (source of truth). Differences from the
// legacy schema: the platform has no multi-tenancy, so Tenant relations
// were dropped (ViontoUsageMetric keeps a plain optional tenantId column
// for data compatibility).

model ViontoProject {
  id     String @id @default(cuid())
  userId String

  title       String
  description String? @db.Text

  // Story mode: narrative arc vs. simple slideshow
  mode String @default("story") // story, slideshow, documentary

  // Story narrative mode: genre/style of narration
  storyMode String? @default("memory_film") // memory_film, travel_recap, family_archive, event_recap, social_reel, documentary

  // Emotional tone: feeling/mood of the narration
  emotionalTone String? @default("nostalgic") // nostalgic, joyful, calm, epic, funny, romantic, reflective

  // Visual style: render treatment for filters, captions, framing, and overlays
  visualStyle String? @default("clean_modern_slideshow") // film_grain, polaroid_memory, clean_modern_slideshow, travel_map_overlay, vhs_archive, wedding_cinematic, social_vertical_captions

  // Subtitle configuration (JSON): presetId, style, timing, export options
  subtitleSettings Json? // SubtitleConfig object — null means use default preset

  // Music selection: soundtrack direction for the video
  musicOption    String? @default("no_music") // calm_piano, cinematic_strings, travel_upbeat, family_warm_acoustic, no_music, upload_own
  musicTrackId   String? // Pixabay track ID if a specific track was selected
  musicUploadKey String? // Storage key for user-uploaded music
  musicMetadata  Json? // Track metadata (title, artist, duration, tags, downloadUrl, license, etc.)

  // Target locale for narration / captions
  locale String @default("en-US")

  // Lifecycle: draft -> ready -> rendering -> completed -> archived
  status String @default("draft") // draft, ready, rendering, completed, archived

  aspectRatio           String  @default("16:9") // 16:9, 9:16, 1:1, 4:3
  resolution            String? // 720p, 1080p, 4k; null = auto
  targetDurationSeconds Int? // User target; null = auto

  // Deletion/retention policy for this project
  retentionPolicy String @default("soft_delete") // soft_delete, hard_delete, archive

  // Relations
  assets        ViontoAsset[]
  albums        ViontoAlbum[]
  videoVersions ViontoVideoVersion[]
  scripts       ViontoScript[]
  audioTracks   ViontoAudioTrack[]
  renderJobs    ViontoRenderJob[]
  exports       ViontoExport[]
  usageMetrics  ViontoUsageMetric[]
  aiClips       ViontoAiClip[]

  // Ownership
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Shares: who else can access this project
  shares ViontoProjectShare[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

// ─── Vionto Project Sharing ──────────────────────────────────

model ViontoProjectShare {
  id               String  @id @default(cuid())
  projectId        String
  sharedByUserId   String
  // Null when the invitee is not yet registered
  sharedWithUserId String?
  // Email used for the invite (canonical, lowercase)
  email            String

  // Permission level: viewer can access, editor can rename/upload (future)
  permission String @default("viewer") // viewer, editor

  project    ViontoProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sharedBy   User          @relation("ViontoSharesSent", fields: [sharedByUserId], references: [id], onDelete: Cascade)
  sharedWith User?         @relation("ViontoSharesReceived", fields: [sharedWithUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([projectId, email])
  @@index([projectId])
  @@index([sharedWithUserId])
  @@index([email])
}

model ViontoAsset {
  id        String @id @default(cuid())
  projectId String
  userId    String

  // Asset classification
  type String @default("source_image") // source_image, thumbnail, extracted_frame, overlay

  // Display / storage URLs
  originalUrl         String?
  thumbnailUrl        String?
  storageKey          String? // S3 / object-store key for original
  thumbnailStorageKey String? // S3 / object-store key for thumbnail

  // Dimensions
  width         Int?
  height        Int?
  fileSizeBytes Int?

  // Ordering within the project timeline
  orderIndex Int @default(0)

  // AI-generated caption for vision-aware story generation
  caption            String?   @db.Text
  captionProvider    String? // openai, anthropic, google, manual
  captionModel       String? // e.g. gpt-4o-mini, claude-3-haiku
  captionGeneratedAt DateTime?

  // EXIF and technical metadata (JSON blob)
  metadata Json?

  // Content safety moderation
  moderationOutcome  String? // ALLOW, REVIEW, REFUSE
  moderationCategory String? // NSFW, VIOLENCE, HATE, OTHER, NONE
  moderationReason   String?   @db.Text
  moderatedAt        DateTime?

  // Ownership
  project    ViontoProject     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  albumItems ViontoAlbumItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([userId])
  @@index([type])
  @@index([orderIndex])
}

model ViontoScript {
  id        String  @id @default(cuid())
  projectId String
  versionId String?
  userId    String

  // Generation provenance
  promptVersion String? // Which prompt template / version produced this
  provider      String? // openai, anthropic, custom, manual
  model         String? // e.g. gpt-4.1-mini, claude-haiku-4-5

  // Content
  narrationText String? @db.Text // Plain-text narration
  srtText       String? @db.Text // SubRip subtitle text

  // Music selection for this script generation
  musicOption   String? // calm_piano, cinematic_strings, travel_upbeat, family_warm_acoustic, no_music, upload_own
  musicTrackId  String? // Pixabay track ID if a specific track was selected
  musicMetadata Json? // Track metadata (title, artist, duration, tags, downloadUrl, license, etc.)

  // User override tracking
  isUserEdited Boolean @default(false)

  // Audit / quality metadata
  promptTokens     Int?
  completionTokens Int?
  totalTokens      Int?
  latencyMs        Int?

  // Content safety moderation
  moderationOutcome  String? // ALLOW, REVIEW, REFUSE
  moderationCategory String? // NSFW, VIOLENCE, HATE, OTHER, NONE
  moderationReason   String?   @db.Text
  moderatedAt        DateTime?

  project ViontoProject       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version ViontoVideoVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([versionId])
  @@index([userId])
  @@index([isUserEdited])
}

model ViontoAudioTrack {
  id        String  @id @default(cuid())
  projectId String
  versionId String?
  userId    String

  // Classification
  type   String @default("narration") // narration, music, sfx
  source String @default("tts") // tts, upload, generated

  // Voice / instrument metadata
  voiceId   String?
  voiceName String?

  // Duration in seconds
  durationSeconds Int?

  // Storage
  storageKey String?

  // Mix settings: volume, fadeIn, fadeOut, startOffset (JSON)
  mixSettings Json?

  // Content safety moderation
  moderationOutcome  String? // ALLOW, REVIEW, REFUSE
  moderationCategory String? // NSFW, VIOLENCE, HATE, OTHER, NONE
  moderationReason   String?   @db.Text
  moderatedAt        DateTime?

  project ViontoProject       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version ViontoVideoVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([versionId])
  @@index([userId])
  @@index([type])
}

model ViontoRenderJob {
  id        String  @id @default(cuid())
  projectId String
  versionId String?
  userId    String

  // External queue / worker ID (e.g. BullMQ, Celery, etc.)
  queueId String?

  // State machine
  state String @default("queued") // queued, running, paused, completed, failed, cancelled

  // Progress 0-100
  progressPercent Int @default(0)

  // Worker logs (last N lines)
  logs String? @db.Text

  // Retry handling
  retryCount   Int     @default(0)
  errorSummary String? @db.Text

  // Timing
  startedAt   DateTime?
  completedAt DateTime?

  // Relations
  project ViontoProject       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version ViontoVideoVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)
  exports ViontoExport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([versionId])
  @@index([userId])
  @@index([state])
  @@index([queueId])
  @@index([createdAt])
}

model ViontoExport {
  id          String  @id @default(cuid())
  projectId   String
  versionId   String?
  renderJobId String?
  userId      String

  // Output storage
  storageKey String

  // Technical metadata
  durationSeconds Int?
  fileSizeBytes   Int?
  format          String  @default("mp4") // mp4, mov, webm
  resolution      String? // 1080p, 4k, 720p
  filename        String?
  userMode        String? // cinematic, slideshow, social
  renderMode      String? // worker/render manifest mode
  aspectRatio     String? // 16:9, 9:16, 1:1
  aspectLabel     String? // landscape, portrait, 1by1
  visualStyle     String? // film_grain, polaroid_memory, clean_modern_slideshow, travel_map_overlay, vhs_archive, wedding_cinematic, social_vertical_captions
  storyMode       String? // memory_film, travel_recap, family_archive, event_recap, social_reel, documentary — snapshotted at render time
  emotionalTone   String? // nostalgic, joyful, calm, epic, funny, romantic, reflective — snapshotted at render time
  storyKeywords   Json?
  previewTitle    String?
  previewSubtitle String? @db.Text

  // Music selection used for this export
  musicOption   String? // calm_piano, cinematic_strings, travel_upbeat, family_warm_acoustic, no_music, upload_own
  musicTrackId  String? // Pixabay track ID if a specific track was selected
  musicMetadata Json? // Track metadata (title, artist, duration, tags, downloadUrl, license, etc.)

  // Signed URL for direct download (time-limited)
  signedUrl          String?
  signedUrlExpiresAt DateTime?

  // Content safety moderation
  moderationOutcome  String? // ALLOW, REVIEW, REFUSE
  moderationCategory String? // NSFW, VIOLENCE, HATE, OTHER, NONE
  moderationReason   String?   @db.Text
  moderatedAt        DateTime?

  // Relations
  project   ViontoProject       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version   ViontoVideoVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)
  renderJob ViontoRenderJob?    @relation(fields: [renderJobId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([versionId])
  @@index([renderJobId])
  @@index([userId])
  @@index([userId, createdAt])
  @@index([userId, userMode, createdAt])
  @@index([userId, aspectRatio, createdAt])
  @@index([format])
}

// Domain-specific audit trail for Vionto operations.
// Complements the generic AuditLog with render-pipeline transitions.
model ViontoAuditEvent {
  id        String  @id @default(cuid())
  actorId   String? // null for system / worker events
  actorRole String? // CREATOR, ADMIN, SYSTEM, WORKER
  action    String // PROJECT_CREATED, ASSET_UPLOADED, SCRIPT_GENERATED, RENDER_STARTED, RENDER_COMPLETED, EXPORT_DOWNLOADED, ...
  entity    String // ViontoProject, ViontoAsset, ViontoScript, ViontoRenderJob, ViontoExport
  entityId  String?
  prevState String?
  nextState String?
  reason    String? @db.Text
  metadata  Json?

  createdAt DateTime @default(now())

  actor User? @relation("ViontoAuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([entity])
  @@index([entityId])
  @@index([action])
  @@index([createdAt])
}

// ─── Vionto Video Versioning ──────────────────────────────────
//
// A ViontoVideoVersion is one configured video output from a project.
// It owns the creative settings (mode, story, tone, style, music, etc.)
// and is the parent of scripts, audio tracks, render jobs, and exports.
// A project may have many versions, each targeting a different album or
// creative direction.  Existing projects are migrated with one default
// version that copies settings from the overloaded ViontoProject columns.

model ViontoVideoVersion {
  id        String @id @default(cuid())
  projectId String
  userId    String

  /// Which album this version renders from (null = all project assets).
  albumId String?

  /// User-facing label, e.g. "Family version", "Social reel".
  name String @default("Version 1")

  /// Optional guided template used to prefill this version.
  templateId       String?
  templateSettings Json?

  // ── Creative settings (migrated from ViontoProject) ──
  mode                  String  @default("story") // story, slideshow, documentary
  storyMode             String? @default("memory_film")
  emotionalTone         String? @default("nostalgic")
  visualStyle           String? @default("clean_modern_slideshow")
  subtitleSettings      Json?
  musicOption           String? @default("no_music")
  musicTrackId          String?
  musicUploadKey        String?
  musicMetadata         Json?
  aspectRatio           String  @default("16:9") // 16:9, 9:16, 1:1, 4:3
  resolution            String? // 720p, 1080p, 4k; null = auto
  targetDurationSeconds Int?

  // ── Story structure & caption overlays ──
  /// Narrative structure: opening title, chapters, climax, closing, dedication.
  storyStructure         Json?
  /// Caption overlay toggles: scene/date/location/people, placement, style.
  captionOverlaySettings Json?

  // ── Relations ──
  project     ViontoProject      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  album       ViontoAlbum?       @relation(fields: [albumId], references: [id], onDelete: SetNull)
  scripts     ViontoScript[]
  audioTracks ViontoAudioTrack[]
  renderJobs  ViontoRenderJob[]
  exports     ViontoExport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([userId])
  @@index([albumId])
  @@index([templateId])
}

// ─── Vionto Album Management ──────────────────────────────────
//
// ViontoAlbum is a logical collection/ordering of ViontoAssets.
// Every project has exactly one base album (isBase = true) created automatically.
// Users may create additional derived albums referencing subsets of the base images.
// No image files are duplicated — albums are pure metadata/reference layers.

model ViontoAlbum {
  id        String @id @default(cuid())
  projectId String
  userId    String

  name        String
  description String? @db.Text

  /// true for the system-managed "Base album" that mirrors all project assets.
  isBase Boolean @default(false)

  /// Optional cover image — references a ViontoAsset id.
  coverAssetId String?

  /// Album-level metadata (arbitrary JSON, e.g. tags, notes, theme).
  metadata Json?

  /// Workflow progress for the album's creation pipeline.
  lifecycleStage String @default("draft") // draft, photos_uploaded, story_generated, audio_ready, video_rendered, published_exported

  /// User-facing organization buckets. Favorites are also mirrored in isFavorite.
  collections String[] @default([])
  isFavorite  Boolean  @default(false)

  /// Structured metadata fields for queries and indexing.
  dateFrom     DateTime?
  dateTo       DateTime?
  location     String?
  people       String[]  @default([])
  occasion     String?
  mood         String?
  privacyLevel String    @default("private") // private, unlisted, public

  project       ViontoProject        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items         ViontoAlbumItem[]
  videoVersions ViontoVideoVersion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Enforce at most one base album per project at the DB level.
  // Partial-index semantics are not available in all DBs via Prisma; we enforce
  // uniqueness on (projectId, isBase) only when isBase is true via app logic.
  @@index([projectId])
  @@index([userId])
  @@index([projectId, isBase])
  @@index([lifecycleStage])
  @@index([isFavorite])
}

/// A single image reference inside an album.
/// orderIndex controls display/render order independently per album.
model ViontoAlbumItem {
  id      String @id @default(cuid())
  albumId String
  assetId String

  /// Display/render position within this album (0-based, lower = earlier).
  orderIndex Int @default(0)

  /// Album-specific semantic metadata for this image.
  /// Flexible JSON — field names vary per image and per album.
  /// Examples: { "place": "Bern", "personName": "Sara", "occasion": "graduation" }
  /// Max validated size: 8 KB.
  metadata Json?

  /// Soft-hide from this album without removing the reference.
  hidden Boolean @default(false)

  /// User-marked favourite within this album.
  favorite Boolean @default(false)

  album ViontoAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)
  asset ViontoAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Each image may appear at most once per album.
  @@unique([albumId, assetId])
  @@index([albumId, orderIndex])
  @@index([assetId])
}

/// AI-generated motion clip for a single album image (Kling image-to-video).
/// The clip replaces the static pan-and-zoom segment for its asset during
/// final rendering when status=succeeded and accepted=true.
model ViontoAiClip {
  id          String  @id @default(cuid())
  projectId   String
  userId      String
  versionId   String?
  albumId     String?
  /// Album item the clip was generated from (kept loose: item may be
  /// removed from the album without invalidating the clip).
  albumItemId String?
  assetId     String

  provider        String  @default("kling")
  model           String
  mode            String  @default("std") // std, pro
  prompt          String  @db.Text
  negativePrompt  String? @db.Text
  /// Requested clip duration (Kling supports 5 or 10 seconds).
  durationSeconds Int     @default(5)

  /// Provider-side task id used for polling.
  taskId       String?
  /// pending -> submitted -> processing -> succeeded | failed
  status       String  @default("pending")
  errorMessage String? @db.Text

  /// Storage key of the downloaded clip in our own object storage.
  outputStorageKey      String?
  /// Actual duration reported by the provider, seconds.
  outputDurationSeconds Float?

  /// Whether the clip should be used in the final render.
  accepted Boolean @default(true)

  /// Provider metadata: request ids, credit/cost info, raw task result.
  providerMetadata Json?

  project ViontoProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([assetId])
  @@index([userId])
  @@index([status])
}

// Vionto-specific usage metrics for quota enforcement and billing.
// tenantId is kept as a plain optional column for legacy-data compatibility;
// the platform has no Tenant model.
model ViontoUsageMetric {
  id          String    @id @default(cuid())
  tenantId    String?
  userId      String?
  projectId   String?
  metric      String // images_uploaded, storage_mb, tts_seconds, render_minutes, exports
  value       Int
  periodStart DateTime
  periodEnd   DateTime?
  metadata    Json?

  user    User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  project ViontoProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@unique([tenantId, metric, periodStart])
  @@index([tenantId])
  @@index([userId])
  @@index([projectId])
  @@index([metric])
  @@index([periodStart])
}

// Vionto plan quotas - limits per plan code
model ViontoPlanQuota {
  id           String @id @default(cuid())
  planCode     String // vionto_free, vionto_pro, vionto_enterprise
  metric       String // images_per_month, storage_mb, tts_seconds_per_month, render_minutes_per_month, exports_per_month
  limitValue   Int
  overagePrice Int? // price per unit over limit in cents
  currency     String @default("USD")

  @@unique([planCode, metric])
  @@index([planCode])
  @@index([metric])
}

/// Bring-your-own-key credential for an AI provider (OpenAI, fal.ai, Kling, …).
/// The plaintext key/secret never touch the database — stored AES-256-GCM
/// encrypted (iv.authTag.ciphertext, base64url), see google-photos/crypto.ts.
/// Resolution order at call time: user's credential → server env fallback.
model ViontoProviderCredential {
  id       String @id @default(cuid())
  userId   String
  /// Provider id from the AI registry (e.g. "openai", "fal", "kling").
  provider String

  /// Encrypted API key. Format: iv.authTag.ciphertext (base64url).
  apiKeyEnc    String  @db.Text
  /// Encrypted secret for providers that use key+secret (e.g. Kling).
  apiSecretEnc String? @db.Text

  /// Optional user-facing label, and a masked hint like "sk-…4f2a" for the UI.
  label     String?
  maskedKey String?

  /// active | invalid (last validation failed)
  status         String    @default("active")
  lastError      String?   @db.Text
  lastVerifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, provider])
  @@index([userId])
}

// ─── Google Photos Integration (Vionto) ───────────────────────
//
// OAuth tokens are stored encrypted at rest (AES-256-GCM). The plaintext
// access/refresh tokens never touch the database — see
// apps/vionto/lib/server/google-photos/crypto.ts.

model GooglePhotosConnection {
  id     String @id @default(cuid())
  userId String @unique

  // Google account that granted access (may differ from the Vionto login email).
  googleAccountEmail String?
  googleAccountSub   String? // Google "sub" — stable account identifier

  // Encrypted OAuth tokens. Format: iv.authTag.ciphertext (all base64url).
  accessTokenEnc  String  @db.Text
  refreshTokenEnc String? @db.Text

  // Granted OAuth scopes and access-token expiry.
  scopes    String[]  @default([])
  expiresAt DateTime?

  // Connection lifecycle.
  status         String    @default("active") // active | revoked | error
  lastError      String?   @db.Text
  lastRefreshAt  DateTime?
  lastImportedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

// ─── Contact Inbox ─────────────────────────────────────────────
// A message sent through the /contact workspace. Anonymous submissions go out
// as email only (no row); signed-in users get a tracked record here, with
// pasted HTML content and file attachments, surfaced back to them as an inbox.

model ContactMessage {
  id     String  @id @default(cuid())
  // Null for anonymous submissions that are still persisted (currently only
  // authenticated messages are stored); SetNull keeps the record if the user
  // is ever deleted.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  name     String
  email    String
  subject  String?
  // Raw HTML the user pasted/typed. Rendered inside a sandboxed <iframe> (no
  // script execution), never with dangerouslySetInnerHTML.
  bodyHtml String  @db.Text
  // Best-effort plain-text version for previews and the email fallback.
  bodyText String? @db.Text

  // sent | read | archived
  status    String  @default("sent")
  // Whether the notification email to the site owner went out.
  emailSent Boolean @default(false)

  attachments ContactAttachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model ContactAttachment {
  id        String         @id @default(cuid())
  messageId String
  message   ContactMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  fileName    String
  contentType String
  sizeBytes   Int
  // Object-storage key (@asafarim/storage). Files are served only through an
  // ownership-checked download route, never a public URL.
  storageKey  String

  createdAt DateTime @default(now())

  @@index([messageId])
}

/**
 * Public-site email capture (asafarim.com homepage). Independent of
 * ContactMessage: this is a standing subscriber list, not a one-off
 * inquiry. No userId relation — most subscribers aren't platform accounts.
 */
model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  // Where the signup happened, e.g. "web-home". Lets future sources
  // (per-app signup forms) share one table without guessing origin.
  source         String    @default("web-home")
  // Soft opt-out — keep the row (suppress re-sends, avoid re-adding on a
  // repeat submit) instead of deleting on unsubscribe.
  unsubscribedAt DateTime?

  // A null timestamp means the guide has not been delivered yet and a repeat
  // signup may retry without creating a duplicate subscriber.
  incentiveSentAt    DateTime?
  incentiveMessageId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([source])
}

// EduMatch — AI learning support and tutor marketplace

model EduStudentProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  gradeLevel         String // K12, UNDERGRAD, GRAD
  subjectsOfInterest String[] @default([])
  homeAddress        Json?
  homeLat            Float?
  homeLng            Float?

  // Preferred teaching language, as a base language code ("en", "nl", ...).
  // Used as the default for a learning brief when the student doesn't say.
  preferredLanguage String?

  // Safeguarding. `isMinor` is student-declared and drives two things: only
  // tutors cleared to work with minors are matched, and bookings require
  // guardian approval before payment. Guardian contact is stored only when
  // the student is a minor.
  isMinor       Boolean @default(false)
  guardianName  String?
  guardianEmail String?

  // Source of truth for age-gated rules — the avatar system's under-13 photo
  // restriction and the account model's under-16 independence cutoff (see
  // lib/server/age.ts). Optional so legacy profiles keep working; a missing
  // value is treated as the most restrictive age everywhere it's read.
  dateOfBirth DateTime?

  // Set when this profile is parent-managed (student is under 16 and cannot
  // act independently — see lib/server/student-guard.ts). Null for an
  // independent 16+ student. The parent is the User who owns the
  // EduParentProfile this student belongs to.
  parentUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent EduParentProfile?  @relation(fields: [parentUserId], references: [userId], onDelete: SetNull)

  @@index([gradeLevel])
  @@index([isMinor])
  @@index([dateOfBirth])
  @@index([parentUserId])
}

// A user with an EduParentProfile is the parent/guardian of one or more
// EduStudentProfile rows (via EduStudentProfile.parentUserId). Deliberately
// minimal today — the fields a real parent dashboard needs (billing address,
// emergency contact, marketing consent) can be added without a migration
// that touches the student side.
model EduParentProfile {
  id     String @id @default(cuid())
  userId String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  children EduStudentProfile[]
}

model EduTutorProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  bio             String?  @db.Text
  subjectsTaught  String[] @default([])
  levelsTaught    String[] @default([])
  hourlyRateCents Int      @default(0)
  onlineOnly      Boolean  @default(false)
  serviceRadiusKm Int      @default(10)
  homeAddress     Json?
  homeLat         Float?
  homeLng         Float?

  // Stripe Connect (Phase 4)
  stripeAccountId String? @unique
  payoutEnabled   Boolean @default(false)

  // Trust & quality
  verifiedAt  DateTime?
  ratingAvg   Float     @default(0)
  ratingCount Int       @default(0)

  // Cached per-aspect averages, mirroring ratingAvg/ratingCount, kept fresh by
  // refreshTutorRating() so the compare/matching list can filter without
  // recomputing from EduReview on every request. Null until at least one
  // aspected review exists.
  clarityAvg     Float?
  reliabilityAvg Float?
  engagementAvg  Float?
  aspectedCount  Int    @default(0)

  // ── Matching signals (learning-brief experience) ────────────────────────
  // Everything a brief can be matched on. None of these is purchasable — see
  // EduMatchCandidate for why that matters.
  languagesTaught String[] @default([]) // base language codes: ["nl", "en"]
  qualifications  String[] @default([]) // free text, shown on comparison
  // STRUCTURED, EXAM_FOCUSED, EXPLORATORY, PATIENT — self-declared, used as a
  // soft tiebreak against the brief's objective, never as a hard filter.
  teachingStyle   String?
  // Recurring weekly availability: [{ day: "MON".."SUN", from, to }]. Used to
  // score schedule compatibility against the brief before any tutor replies.
  weeklyAvailability Json?

  // Safeguarding: a tutor is only matched to a minor's brief once an admin has
  // cleared them. Written by the verification workflow, never self-service.
  clearedForMinorsAt DateTime?

  // Responsiveness and fairness inputs, maintained by the matching and
  // proposal services.
  medianResponseMinutes Int? // null until the tutor has answered an invite
  invitesReceived       Int       @default(0)
  proposalsSent         Int       @default(0)
  lastMatchedAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([onlineOnly])
  @@index([hourlyRateCents])
  @@index([ratingAvg])
  @@index([verifiedAt])
  @@index([clearedForMinorsAt])
  @@index([lastMatchedAt])
  @@index([clarityAvg])
  @@index([reliabilityAvg])
  @@index([engagementAvg])
}

model EduInquiry {
  id          String  @id @default(cuid())
  studentId   String
  subject     String
  gradeLevel  String
  description String  @db.Text
  attachments Json? // [{ type, url, mime, sizeBytes }]
  aiSummary   String? @db.Text
  status      String  @default("NEW") // NEW, AI_RESPONDED, TUTOR_REQUESTED, BOOKED, CLOSED, REFUSED

  // Moderation snapshot taken at the time of inquiry/AI generation. Null until
  // a moderation decision has been made. Decisions are also logged on each
  // EduAiResponse so we keep history if the inquiry is re-asked.
  moderationOutcome  String? // ALLOW, REVIEW, REFUSE
  moderationCategory String? // CHEATING, EXAM_BYPASS, PLAGIARISM, UNSAFE_PERSONAL, OTHER, NONE
  moderationReason   String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student       User              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  aiResponses   EduAiResponse[]
  quoteRequests EduQuoteRequest[]
  brief         EduLearningBrief?

  @@index([studentId])
  @@index([status])
  @@index([subject])
  @@index([createdAt])
  @@index([moderationOutcome])
}

model EduAiResponse {
  id               String  @id @default(cuid())
  inquiryId        String
  modelUsed        String
  promptVersion    String
  explanation      String  @db.Text
  studyPlan        Json?
  practiceProblems Json?
  promptTokens     Int?
  completionTokens Int?
  totalTokens      Int?
  tokenCostMicros  Int? // 1/1,000,000 of a USD, integer math for billing
  latencyMs        Int?
  truncated        Boolean @default(false)
  stopReason       String?

  // Moderation snapshot for this specific generation attempt. ALLOW responses
  // contain regular AI output; REFUSE responses contain a redirection message.
  moderationOutcome  String? // ALLOW, REVIEW, REFUSE
  moderationCategory String? // CHEATING, EXAM_BYPASS, PLAGIARISM, UNSAFE_PERSONAL, OTHER, NONE
  moderationReason   String? @db.Text

  createdAt DateTime @default(now())

  inquiry EduInquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)

  @@index([inquiryId])
  @@index([createdAt])
  @@index([moderationOutcome])
}

model EduQuoteRequest {
  id          String   @id @default(cuid())
  inquiryId   String
  studentId   String
  requestedAt DateTime @default(now())
  expiresAt   DateTime
  status      String   @default("OPEN") // OPEN, FULFILLED, EXPIRED, CANCELLED

  // Set when the request came from a confirmed EduLearningBrief. Brief-driven
  // requests are invite-only: exactly the tutors in EduMatchCandidate may quote.
  briefId String?

  inquiry         EduInquiry          @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  quotes          EduQuote[]
  brief           EduLearningBrief?   @relation(fields: [briefId], references: [id], onDelete: SetNull)
  matchCandidates EduMatchCandidate[]

  @@index([briefId])
  @@index([inquiryId])
  @@index([studentId])
  @@index([status])
  @@index([expiresAt])
}

model EduQuote {
  id                String  @id @default(cuid())
  quoteRequestId    String
  tutorId           String
  hourlyRateCents   Int
  estimatedHours    Float
  totalCents        Int
  currency          String  @default("eur")
  availabilitySlots Json? // [{ start, end, mode }]
  notes             String? @db.Text
  pdfUrl            String?
  status            String  @default("PENDING") // DRAFT, PENDING, SENT, ACCEPTED, DECLINED, EXPIRED

  // ── Prepared lesson proposal ────────────────────────────────────────────
  // A quote that originates from a confirmed EduLearningBrief starts life as
  // a DRAFT that the platform pre-fills from the brief and the tutor's own
  // profile. The tutor reviews it, optionally adjusts it, and only then does
  // it become PENDING (visible to the student). Nothing is ever sent to the
  // student without `sentAt` being stamped by an explicit tutor action.
  briefId            String?
  sessionCount       Int? // number of lessons in the proposed plan
  sessionMinutes     Int? // duration of each lesson
  mode               String? // ONLINE, IN_PERSON
  language           String? // teaching language for this proposal
  earliestStartAt    DateTime? // soonest the tutor can begin
  planOutline        Json? // [{ session, focus, outcome }]
  preparationNotes   String?   @db.Text
  cancellationPolicy String? // FLEXIBLE, MODERATE, STRICT
  aiDrafted          Boolean   @default(false)
  tutorAdjusted      Boolean   @default(false)
  declineReason      String?   @db.Text
  sentAt             DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quoteRequest EduQuoteRequest   @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  tutor        User              @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  booking      EduBooking?
  brief        EduLearningBrief? @relation(fields: [briefId], references: [id], onDelete: SetNull)

  @@unique([quoteRequestId, tutorId])
  @@index([quoteRequestId])
  @@index([tutorId])
  @@index([status])
  @@index([briefId])
}

model EduBooking {
  id                    String    @id @default(cuid())
  quoteId               String    @unique
  studentId             String
  tutorId               String
  scheduledAt           DateTime
  durationMinutes       Int
  mode                  String // ONLINE, IN_PERSON
  meetingUrl            String?
  stripePaymentIntentId String?   @unique
  status                String    @default("SCHEDULED") // SCHEDULED, COMPLETED, CANCELLED, DISPUTED
  completedAt           DateTime?
  cancelledAt           DateTime?
  cancellationReason    String?

  // Who is legally/financially responsible for this booking: the student's
  // own userId if they can act independently (16+, no parent), otherwise
  // their parent's userId. Deliberately a plain scalar, not a relation — see
  // lib/server/student-guard.ts's getPayerId() for how it's derived. This is
  // the smallest possible payment-responsibility fix; it does not touch
  // EduTransaction.
  payerId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quote         EduQuote          @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  student       User              @relation("EduBookingStudent", fields: [studentId], references: [id], onDelete: Cascade)
  tutor         User              @relation("EduBookingTutor", fields: [tutorId], references: [id], onDelete: Cascade)
  transactions  EduTransaction[]
  messages      EduMessage[]
  sessionRecord EduSessionRecord?
  review        EduReview?

  @@index([studentId])
  @@index([tutorId])
  @@index([status])
  @@index([scheduledAt])
  @@index([payerId])
}

model EduTransaction {
  id               String  @id @default(cuid())
  bookingId        String
  tutorId          String
  type             String // CHARGE, REFUND, PAYOUT, PLATFORM_FEE
  grossCents       Int
  platformFeeCents Int     @default(0)
  netCents         Int
  currency         String  @default("EUR")
  stripeChargeId   String?
  stripePayoutId   String?

  createdAt DateTime @default(now())

  booking EduBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  tutor   User       @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([tutorId])
  @@index([type])
  @@index([createdAt])
  @@index([stripeChargeId])
}

model EduWallet {
  tutorId              String    @id
  balanceCents         Int       @default(0)
  pendingCents         Int       @default(0)
  payoutThresholdCents Int       @default(5000)
  currency             String    @default("EUR")
  lastPayoutAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tutor User @relation(fields: [tutorId], references: [id], onDelete: Cascade)
}

model EduNotification {
  id      String    @id @default(cuid())
  userId  String
  type    String // INQUIRY_RECEIVED, AI_RESPONSE_READY, QUOTE_RECEIVED, BOOKING_CONFIRMED, PAYOUT_SENT, ...
  payload Json?
  readAt  DateTime?
  sentAt  DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([readAt])
  @@index([createdAt])
}

model EduMessage {
  id        String @id @default(cuid())
  bookingId String
  senderId  String
  body      String @db.Text

  createdAt DateTime @default(now())

  booking EduBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  sender  User       @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([senderId])
  @@index([createdAt])
}

// ─── EduMatch trust & safety ──────────────────────────────────────────────
//
// EduTutorProfile.verifiedAt remains the canonical "is verified now?" field.
// EduTutorVerification records the workflow around it: each review attempt,
// the checklist results, admin notes, and the resolution. The current row
// (latest by createdAt) holds the active workflow status; older rows preserve
// audit history. A tutor is verified when their profile has verifiedAt set,
// which is written by the admin verification routes when status -> VERIFIED.

model EduTutorVerification {
  id         String  @id @default(cuid())
  tutorId    String
  reviewerId String?

  // Workflow status for this review iteration.
  status String @default("PENDING") // PENDING, NEEDS_CHANGES, VERIFIED, REJECTED

  // Optional structured checklist outcome.
  // Shape (free-form JSON): {
  //   identityVerified: boolean,
  //   credentialsVerified: boolean,
  //   backgroundCheck: boolean,
  //   profileComplete: boolean,
  //   notes?: string,
  // }
  checklist Json?

  // Free-form admin notes shown only to admins.
  adminNotes String? @db.Text

  // If status === NEEDS_CHANGES, this is the message shown to the tutor.
  tutorMessage String? @db.Text

  // When the review was resolved (VERIFIED, REJECTED, or NEEDS_CHANGES sent).
  resolvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tutor    User  @relation("EduTutorVerificationTutor", fields: [tutorId], references: [id], onDelete: Cascade)
  reviewer User? @relation("EduTutorVerificationReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([tutorId])
  @@index([status])
  @@index([reviewerId])
  @@index([createdAt])
}

// A two-way message thread between admins and a tutor about that tutor's
// verification. The thread is keyed by `tutorId` (the verification subject).
// `senderRole` records whether a message came from an ADMIN or the TUTOR.
// `readAt` is stamped when the *other* party reads the message, powering
// unread badges on both the admin panel and the tutor's verification page.
model EduVerificationMessage {
  id          String    @id @default(cuid())
  tutorId     String
  senderId    String
  senderRole  String // ADMIN | TUTOR
  body        String    @db.Text
  // Optional attachments: array of { key, mime, filename, sizeBytes }. Keys are
  // storage object keys scoped to the uploader; URLs are signed on read because
  // the bucket is private.
  attachments Json?
  // Emoji reactions: { [emoji]: userId[] } — emoji keys are restricted to the
  // supported set (thumbsup, thumbsdown, check, question, eyes, tada).
  reactions   Json?
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  tutor  User @relation("EduVerificationMessageTutor", fields: [tutorId], references: [id], onDelete: Cascade)
  sender User @relation("EduVerificationMessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([tutorId])
  @@index([senderId])
  @@index([createdAt])
}

// User-level notification preferences for EduMatch domain events. Created
// lazily on first lookup; absence of a row means "all defaults" (everything
// in-app, email enabled where the dispatcher considers it safe).
model EduNotificationPreference {
  userId String @id

  // In-app delivery toggles.
  inAppInquiryReceived    Boolean @default(true)
  inAppAiResponseReady    Boolean @default(true)
  inAppQuoteReceived      Boolean @default(true)
  inAppBookingConfirmed   Boolean @default(true)
  inAppCancellationUpdate Boolean @default(true)
  inAppDisputeUpdate      Boolean @default(true)
  inAppPayoutSent         Boolean @default(true)

  // Email delivery toggles. Defaults are conservative — opt-in for marketing-
  // adjacent flows, opt-out for transactional safety flows.
  emailInquiryReceived    Boolean @default(true)
  emailAiResponseReady    Boolean @default(false)
  emailQuoteReceived      Boolean @default(true)
  emailBookingConfirmed   Boolean @default(true)
  emailCancellationUpdate Boolean @default(true)
  emailDisputeUpdate      Boolean @default(true)
  emailPayoutSent         Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Append-only audit trail for EduMatch state changes. Distinct from the
// generic AuditLog so EduMatch flows can record domain-specific transitions
// (prevState → nextState) without polluting the platform-wide log. The
// generic AuditLog remains in use elsewhere.
model EduAuditEvent {
  id        String  @id @default(cuid())
  actorId   String? // null for system events (e.g. webhook-driven payouts)
  actorRole String? // STUDENT, TUTOR, ADMIN, SYSTEM
  action    String // INQUIRY_CREATED, AI_RESPONSE_GENERATED, AI_RESPONSE_REFUSED, ...
  entity    String // EduInquiry, EduAiResponse, EduQuote, EduBooking, EduTutorProfile, ...
  entityId  String?
  prevState String?
  nextState String?
  reason    String? @db.Text
  metadata  Json?

  createdAt DateTime @default(now())

  actor User? @relation("EduAuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([entity])
  @@index([entityId])
  @@index([action])
  @@index([createdAt])
}

// ─── EduMatch learning-brief experience ───────────────────────────────────
//
// The learning brief is the spine of the product: the student describes a
// problem in their own words, the assistant asks only the questions that are
// still missing, helps immediately where it can, and distils everything into
// one structured, student-confirmed document. That document is what tutors
// receive — never a bare "student needs maths help" lead.
//
// Lifecycle:
//   DRAFT      — being built from the conversation; the student may still edit
//   CONFIRMED  — the student reviewed and approved it; safe to share
//   MATCHED    — tutors have been invited and prepared proposals exist
//   ARCHIVED   — closed out (booked and completed, or abandoned)
//
// A brief keeps its own copy of the intake facts rather than pointing at the
// originating EduInquiry, because the inquiry is the legacy single-shot intake
// and its fields (subject/gradeLevel/description) are a strict subset. The
// optional `inquiryId` link exists so the AI-answer, moderation, and quote
// plumbing that already hangs off EduInquiry keeps working unchanged.

model EduLearningBrief {
  id        String  @id @default(cuid())
  studentId String
  inquiryId String? @unique

  // ── What the student is learning ──
  subject              String
  topic                String?
  educationalLevel     String // K12, UNDERGRAD, GRAD — matches GRADE_LEVELS
  schoolYear           String? // free text, e.g. "5 VWO", "Year 11", "L2"
  learningObjective    String? @db.Text
  currentUnderstanding String? @db.Text

  // Specific difficulties the student named, and prerequisite topics the
  // assistant judged to be missing underneath them.
  difficulties     String[] @default([])
  prerequisiteGaps String[] @default([])

  // ── How they want to be taught ──
  language           String  @default("en") // teaching language, base language code
  mode               String  @default("EITHER") // ONLINE, IN_PERSON, EITHER
  locationCity       String?
  locationLat        Float?
  locationLng        Float?
  availability       Json? // [{ day: "MON".."SUN", from: "16:00", to: "19:00" }]
  deadlineAt         DateTime?
  deadlineKind       String? // EXAM, ASSIGNMENT, NONE
  accessibilityNeeds String?   @db.Text

  // ── Proposed shape of the help ──
  estimatedSessions Int?
  sessionMinutes    Int?

  // ── Triage ──
  // SELF_STUDY        — an explanation, exercises, and a plan are enough
  // TUTOR_RECOMMENDED — ready to match
  // NEEDS_DIAGNOSTIC  — one short diagnostic step before tutors are selected
  triageOutcome    String?
  triageRationale  String? @db.Text
  // 0..1 — how confident the extraction is that the brief is complete enough
  // to act on. Never inferred as "high" from a bare subject name; see
  // computeBriefCompleteness().
  confidence       Float   @default(0)
  diagnosticResult Json? // { questions: [...], answers: [...], scorePct }

  // Uploaded exercises and materials, same shape as EduInquiry.attachments.
  attachments Json?

  status      String    @default("DRAFT")
  confirmedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student         User                @relation(fields: [studentId], references: [id], onDelete: Cascade)
  inquiry         EduInquiry?         @relation(fields: [inquiryId], references: [id], onDelete: SetNull)
  turns           EduIntakeTurn[]
  matchCandidates EduMatchCandidate[]
  quotes          EduQuote[]
  quoteRequests   EduQuoteRequest[]
  sessionRecords  EduSessionRecord[]

  @@index([studentId])
  @@index([status])
  @@index([subject])
  @@index([triageOutcome])
  @@index([createdAt])
}

// One message in the intake conversation. Kept as rows rather than a JSON blob
// so the "ask one clear question at a time" rule is auditable: every ASSISTANT
// turn of kind QUESTION records which brief field it was trying to fill, and
// we can prove we never asked the same field twice.
model EduIntakeTurn {
  id      String @id @default(cuid())
  briefId String

  role String // STUDENT, ASSISTANT
  kind String // MESSAGE, QUESTION, HELP, SUMMARY

  content     String  @db.Text
  // For QUESTION turns: the EduLearningBrief field this question targets.
  field       String?
  attachments Json?

  createdAt DateTime @default(now())

  brief EduLearningBrief @relation(fields: [briefId], references: [id], onDelete: Cascade)

  @@index([briefId])
  @@index([createdAt])
}

// A tutor the platform selected for a brief, with the full score breakdown
// that produced the selection. Persisted (rather than recomputed on read) so
// the ranking a student saw can always be explained after the fact, and so
// "tutors cannot buy position" is a checkable property: there is no field
// here that money could write to. `rotationBoost` marks a qualified tutor who
// was included through the fair-rotation slot rather than on raw score.
model EduMatchCandidate {
  id             String  @id @default(cuid())
  briefId        String
  quoteRequestId String?
  tutorId        String

  rank          Int
  score         Float
  breakdown     Json // { subject: 0.25, level: 0.15, ... } contributions
  reasons       String[] @default([])
  rotationBoost Boolean  @default(false)

  // Stamped when this tutor was actually invited to prepare a proposal.
  invitedAt DateTime?

  createdAt DateTime @default(now())

  brief        EduLearningBrief @relation(fields: [briefId], references: [id], onDelete: Cascade)
  quoteRequest EduQuoteRequest? @relation(fields: [quoteRequestId], references: [id], onDelete: SetNull)
  tutor        User             @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  @@unique([briefId, tutorId])
  @@index([briefId])
  @@index([quoteRequestId])
  @@index([tutorId])
}

// What actually happened in a lesson. Written by the tutor after the session;
// the student sees a summary and the next recommended step. This is what turns
// a one-off booking into a learning journey.
model EduSessionRecord {
  id        String  @id @default(cuid())
  bookingId String  @unique
  briefId   String?
  tutorId   String
  studentId String

  attendance     String   @default("ATTENDED") // ATTENDED, PARTIAL, NO_SHOW
  topicsCovered  String[] @default([])
  tutorNotes     String?  @db.Text
  studentSummary String?  @db.Text
  homework       String?  @db.Text
  nextStep       String?  @db.Text
  resources      Json? // [{ label, url }]

  // 0-100 against the brief's learning objective, as judged by the tutor.
  goalProgress Int?
  // Topics the tutor flagged as still shaky — feeds the "areas that still
  // require attention" section of the learning record.
  openConcerns String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  booking EduBooking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  brief   EduLearningBrief? @relation(fields: [briefId], references: [id], onDelete: SetNull)
  tutor   User              @relation("EduSessionRecordTutor", fields: [tutorId], references: [id], onDelete: Cascade)
  student User              @relation("EduSessionRecordStudent", fields: [studentId], references: [id], onDelete: Cascade)

  @@index([briefId])
  @@index([studentId])
  @@index([tutorId])
  @@index([createdAt])
}

// A review is only creatable against a COMPLETED booking, which is why there
// is no `verified` flag: existence is the verification. One review per booking.
model EduReview {
  id        String @id @default(cuid())
  bookingId String @unique
  studentId String
  tutorId   String

  rating  Int // 1-5, derived (weighted average of the three aspects below) for
  // new reviews; for legacy reviews (clarity/reliability/engagement all null)
  // this is the only signal and is entered as-is.
  comment String? @db.Text

  // Sub-aspect ratings, 1-5. Nullable so legacy reviews keep working — null
  // means "not asked", not "zero".
  clarity     Int?
  reliability Int?
  engagement  Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  booking EduBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  student User       @relation("EduReviewStudent", fields: [studentId], references: [id], onDelete: Cascade)
  tutor   User       @relation("EduReviewTutor", fields: [tutorId], references: [id], onDelete: Cascade)

  @@index([tutorId])
  @@index([studentId])
  @@index([createdAt])
}

// ─── TimelineAI — visual timeline builder ─────────────────────
//
// Ownership: `ownerUserId` for a Hub-authenticated owner, or `guestIdHash`
// (a keyed hash of the submitting IP — never the raw IP) for a guest
// submission. Exactly one of the two is set; enforced in the service layer,
// not the DB, since Prisma has no portable XOR constraint.
//
// Lifecycle is modeled as independent axes rather than one combined status,
// per the product spec:
//   visibility       — private | public | unlisted
//   moderationStatus — not_required | pending | approved | rejected
//   editingState     — draft | published
// Authenticated owners default to moderationStatus=not_required and may
// self-publish (editingState=published, visibility=public) without admin
// review. Guest submissions default to moderationStatus=pending and stay
// non-public until an admin approves them.
//
// `publicId` is a short unguessable slug (nanoid, generated in the service
// layer) used for public share URLs — the internal `id` (cuid) is never
// exposed in a public route.

model Timeline {
  id       String @id @default(cuid())
  publicId String @unique

  ownerUserId String?
  guestIdHash String? // keyed hash of the submitting IP; never the raw IP

  title       String
  subtitle    String?
  description String? @db.Text

  // General timeline category the editor pre-fills from, independent of
  // rendering — e.g. "project", "historical", "roadmap", "gantt",
  // "calendar", "interactive", "general".
  timelineType String @default("general")

  // Presentation mode. Content (events) is layout-independent; switching
  // layout must never drop event data.
  layout String @default("vertical") // vertical, horizontal, zigzag, radial, roadmap, gantt, calendar, calendar-board, interactive, branch

  // Theme/rendering settings: palette, background, accent/connector colors,
  // font family + size preset, date format, card style, spacing, visibility
  // toggles for description/date/image/icon. Kept as JSON so new presets
  // don't require a migration; validated against a Zod schema in the app.
  theme Json?

  visibility       String  @default("private") // private, public, unlisted
  moderationStatus String  @default("not_required") // not_required, pending, approved, rejected
  moderationReason String? @db.Text
  editingState     String  @default("draft") // draft, published

  // Optimistic-concurrency guard for concurrent editor saves.
  version Int @default(1)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  submittedAt DateTime? // guest: when the submission was made
  approvedAt  DateTime?
  publishedAt DateTime?

  owner            User?                     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  events           TimelineEvent[]
  moderationEvents TimelineModerationEvent[]

  @@index([ownerUserId])
  @@index([guestIdHash])
  @@index([visibility])
  @@index([moderationStatus])
  @@index([editingState])
  @@index([createdAt])
}

model TimelineEvent {
  id         String @id @default(cuid())
  timelineId String

  // Precise date/time (used for chronological sorting and Gantt/calendar
  // rendering). `displayDate` overrides what's shown when set, so
  // approximate/historical dates ("circa 1200 BCE") don't need a real
  // DateTime.
  startAt     DateTime?
  endAt       DateTime? // Gantt-style duration bars use start+end
  displayDate String?

  title       String
  description String? @db.Text

  imageUrl        String?
  imageStorageKey String? // @asafarim/storage object key, when uploaded

  icon  String?
  label String? // category/label chip

  link        String?
  accentColor String?

  // Manual ordering mode position; chronological mode sorts by startAt at
  // render time and ignores this field.
  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  timeline Timeline @relation(fields: [timelineId], references: [id], onDelete: Cascade)

  @@index([timelineId])
  @@index([timelineId, sortOrder])
  @@index([timelineId, startAt])
}

/// Moderation and administrative-action audit trail, distinct from the
/// generic AuditLog so admin review history (approve/reject/edit/delete
/// reasons) stays queryable per timeline without joining the platform log.
model TimelineModerationEvent {
  id          String  @id @default(cuid())
  timelineId  String
  adminUserId String? // null for system/self-publish events

  action   String // SUBMITTED, APPROVED, REJECTED, EDITED, DELETED, PUBLISHED, UNPUBLISHED, VISIBILITY_CHANGED
  reason   String? @db.Text
  metadata Json?

  createdAt DateTime @default(now())

  timeline Timeline @relation(fields: [timelineId], references: [id], onDelete: Cascade)
  admin    User?    @relation("TimelineModerationActor", fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([timelineId])
  @@index([adminUserId])
  @@index([action])
  @@index([createdAt])
}

// ─── Unified Shopping Cart ─────────────────────────────────────

// ─── Seed Data Management (Admin Console control plane) ──────
//
// History and scheduling for the Seed Data page. These rows are the control
// plane only — they record what was asked for and what happened, never the
// seeded data itself and never a connection string. Everything written here
// has already passed through the seed-manager redaction layer.
//
// Status/kind/level are validated string unions rather than Prisma enums, to
// match the convention used elsewhere in this schema.

/// One requested seed operation. Created before the job is enqueued, so a
/// crash between request and execution is still visible in history.
model SeedOperation {
  id String @id @default(cuid())

  providerId  String
  appId       String
  environment String // development | staging | production
  operation   String // validate | status | seed | reconcile | remove
  dryRun      Boolean @default(false)

  /// queued | validating | inspecting | planning | awaiting_execution |
  /// executing | verifying | succeeded | partially_succeeded | failed |
  /// cancelled | stale
  status String @default("queued")
  /// Finer-grained progress label within the current status.
  stage    String?
  progress Int     @default(0)

  requestedByUserId String?
  /// Deduplicates double submissions of the same intent.
  idempotencyKey String @unique

  /// Checksum of the approved dry-run plan, revalidated before execution.
  planChecksum String?
  /// Version + checksum of the seed definitions this ran against.
  definitionVersion  String?
  definitionChecksum String?

  /// Structured, redacted summaries — never raw provider output.
  planSummary   Json?
  resultSummary Json?

  errorCode    String?
  errorMessage String? @db.Text

  queuedAt                DateTime  @default(now())
  startedAt               DateTime?
  /// Set the moment the first write happens. Cancellation is refused after.
  mutationStartedAt       DateTime?
  completedAt             DateTime?
  heartbeatAt             DateTime?
  cancellationRequestedAt DateTime?

  /// Links a retry back to the operation it replaces.
  retryOfOperationId String?
  retryOf            SeedOperation?  @relation("SeedOperationRetry", fields: [retryOfOperationId], references: [id], onDelete: SetNull)
  retries            SeedOperation[] @relation("SeedOperationRetry")

  /// Shared by every child of one bulk action.
  bulkGroupId String?

  requestedBy User? @relation("SeedOperationActor", fields: [requestedByUserId], references: [id], onDelete: SetNull)

  events SeedOperationEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([providerId, environment, status])
  @@index([requestedByUserId])
  @@index([createdAt])
  @@index([status, heartbeatAt])
  @@index([bulkGroupId])
}

/// Append-only, sanitized log line for one operation.
model SeedOperationEvent {
  id          String @id @default(cuid())
  operationId String

  level   String // debug | info | warn | error
  stage   String
  message String @db.Text
  /// Redacted structured context. Never contains secrets or SQL text.
  metadata Json?

  createdAt DateTime @default(now())

  operation SeedOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)

  @@index([operationId, createdAt])
  @@index([level])
}

/// A recurring, strictly read-only validation run. Mutating operations can
/// never be scheduled — there is no field here that could express one.
model SeedValidationSchedule {
  id String @id @default(cuid())

  providerId  String
  environment String
  enabled     Boolean @default(true)

  /// Bounded cadence key (e.g. "hourly", "daily", "weekly") rather than a
  /// free-form cron string, so a schedule cannot be made to run unboundedly.
  cadence String

  createdByUserId String?
  updatedByUserId String?

  lastRunAt DateTime?
  nextRunAt DateTime?

  createdBy User? @relation("SeedScheduleCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy User? @relation("SeedScheduleUpdater", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([providerId, environment])
  @@index([enabled, nextRunAt])
}
