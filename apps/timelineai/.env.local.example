# TimelineAI — environment template
# Copy to .env.local and fill in real values. Never commit .env.local.

NODE_ENV=development

# ─── Public base URL ──────────────────────────────────────────
NEXT_PUBLIC_TIMELINEAI_URL=http://localhost:3007
NEXT_PUBLIC_BASE_PATH=

# ─── Centralized auth (Hub SSO) ────────────────────────────────
# AUTH_SECRET must match the value used by hub/web so cross-app sessions
# decode correctly. Generate once with: openssl rand -base64 32
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3007
# Leave blank for localhost; set to `.asafarim.com` in production.
AUTH_COOKIE_DOMAIN=

# ─── Cross-app platform URLs ───────────────────────────────────
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_HUB_URL=http://localhost:3001
NEXT_PUBLIC_SHOWCASE_URL=http://localhost:3002
NEXT_PUBLIC_ADMIN_URL=http://localhost:3003
NEXT_PUBLIC_VIONTO_URL=http://localhost:3004
NEXT_PUBLIC_TESTORA_URL=http://localhost:3005
NEXT_PUBLIC_APPBUILDER_URL=http://localhost:3006
NEXT_PUBLIC_EDUMATCH_URL=http://localhost:3009

# ─── Database (shared platform Postgres via @asafarim/db / Prisma) ────
DATABASE_URL=postgresql://asafarim:asafarim@localhost:55432/asafarim?schema=public

# ─── Redis (guest rate limiting) ───────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Guest identity ─────────────────────────────────────────────
# HMAC key used to hash guest IPs before storing them (never store raw IPs).
# Generate once with: openssl rand -hex 32
TIMELINEAI_GUEST_IP_HASH_KEY=

# Comma-separated list of trusted reverse-proxy hop count / CIDRs, matching
# the platform's reverse-proxy setup — only trust X-Forwarded-For this many
# hops deep. Defaults to 1 (Caddy) in production; 0 (no proxy) in dev.
TIMELINEAI_TRUSTED_PROXY_HOPS=0

# ─── Object storage (@asafarim/storage) — event images ─────────
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL_BASE=

# ─── Export rendering (Puppeteer/Chromium) ─────────────────────
# Skipped in local dev if a system Chromium is available; see Dockerfile for
# the production PUPPETEER_SKIP_DOWNLOAD / PUPPETEER_EXECUTABLE_PATH setup.
PUPPETEER_EXECUTABLE_PATH=
