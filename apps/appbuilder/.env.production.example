# Most vars are already provided by the monorepo root .env.local / .env
# (loaded automatically by next.config.ts). Set app-only overrides here in an
# apps/appbuilder/.env.production if you need them.
#
# DO NOT commit real secrets to version control.

# ─── Database ──────────────────────────────────────────────────
# AppBuilder keeps its OWN database, separate from the platform's shared
# Prisma Postgres and from testora's. Matches the `appbuilder-postgres`
# service in the root docker-compose.yml (host port 55436).
APPBUILDER_DB_PASSWORD=<base64-encoded 24-byte password>
APPBUILDER_DATABASE_URL=postgres://appbuilder:<password>@appbuilder-postgres:5432/appbuilder

# DISTINCT scratch database for `pnpm test:integration` — required by
# lib/db/testDbGuard.ts. Never point this at the same database as
# APPBUILDER_DATABASE_URL.
APPBUILDER_TEST_DATABASE_URL=postgres://appbuilder:<password>@appbuilder-postgres:5432/appbuilder_test

# ─── Auth ──────────────────────────────────────────────────────
# AppBuilder authenticates via the shared platform SSO session — it has no
# auth vars of its own. AUTH_SECRET, AUTH_COOKIE_DOMAIN, and every
# NEXT_PUBLIC_*_URL (used for the trusted-origin/callback allowlist and the
# app switcher) come from the monorepo root .env.local / .env, same as
# every other app. See docs/appbuilder-architecture.md for the SSO flow.

# ─── OpenAI ────────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-<your-openai-key>
OPENAI_MODEL=gpt-5-mini
OPENAI_MAX_OUTPUT_TOKENS=32000

# ─── Anthropic ─────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-<your-anthropic-key>
ANTHROPIC_MODEL=claude-haiku-4-5
ANTHROPIC_MAX_TOKENS=2000

# ─── AI Provider Selection ─────────────────────────────────────
APPBUILDER_AI_PROVIDER=openai
APPBUILDER_AI_OPENAI_API_KEY=sk-proj-<your-openai-key>

# Full-spec generation with structured output can exceed the 30s default,
# causing a misleading "provider was temporarily unavailable" error.
APPBUILDER_AI_REQUEST_TIMEOUT_MS=120000