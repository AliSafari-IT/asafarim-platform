# EduMatch — production environment template.
#
# In production, edumatch does NOT have its own .env.production file. It reads
# from the ROOT .env.production via `env_file: .env.production` in
# docker-compose.prod.yml (see the `edumatch` service). The compose
# `environment:` block overrides these at runtime:
#   NODE_ENV=production
#   DATABASE_URL=${DATABASE_URL}            # from root .env.production
#   REDIS_URL=redis://redis:6379            # internal compose network
#   NEXT_PUBLIC_APP_URL=https://edumatch.asafarim.com
#   NEXT_PUBLIC_EDUMATCH_URL=https://edumatch.asafarim.com
#   AUTH_URL=https://edumatch.asafarim.com
#
# Build-time NEXT_PUBLIC_* args come from the shared `&public-build-args`
# anchor in docker-compose.prod.yml, which interpolates from .env.production.
#
# This file documents the edumatch-specific vars that MUST be present in the
# root .env.production for edumatch to function. Copy them into the root file.

NODE_ENV=production

# ─── Public base URL ──────────────────────────────────────────
# Overridden by docker-compose — shown for reference.
NEXT_PUBLIC_APP_URL=https://edumatch.asafarim.com

# ─── Centralized auth ─────────────────────────────────────────
# AUTH_SECRET is shared across all apps (set once in root .env.production).
# AUTH_URL is overridden by docker-compose to https://edumatch.asafarim.com.
# AUTH_COOKIE_DOMAIN must be .asafarim.com for cross-subdomain SSO.
AUTH_SECRET=<openssl rand -base64 32 — must match the web app>
AUTH_URL=https://edumatch.asafarim.com
NEXTAUTH_URL=https://edumatch.asafarim.com
AUTH_COOKIE_DOMAIN=.asafarim.com

# ─── Cross-app platform URLs ──────────────────────────────────
# These are build-time args (see Dockerfile ARG lines) and also available at
# runtime via the root .env.production. Already defined in the root file, but
# listed here for completeness.
PORTAL_URL=https://asafarim.com
NEXT_PUBLIC_WEB_URL=https://asafarim.com
NEXT_PUBLIC_HUB_URL=https://hub.asafarim.com
NEXT_PUBLIC_SHOWCASE_URL=https://showcase.asafarim.com
NEXT_PUBLIC_ADMIN_URL=https://admin.asafarim.com
NEXT_PUBLIC_VIONTO_URL=https://vionto.asafarim.com
NEXT_PUBLIC_TESTORA_URL=https://testora.asafarim.com
NEXT_PUBLIC_APPBUILDER_URL=https://appbuilder.asafarim.com
EDUMATCH_URL=https://edumatch.asafarim.com
NEXT_PUBLIC_EDUMATCH_URL=https://edumatch.asafarim.com

# ─── Database ─────────────────────────────────────────────────
# Overridden by docker-compose to use the internal compose hostname.
# Shown for reference — the root .env.production owns the real value.
# DATABASE_URL=postgresql://asafarim:POSTGRES_PASSWORD@postgres:5432/asafarim

# ─── AI providers ─────────────────────────────────────────────
# Shared keys — already in root .env.production. Listed here for reference.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_MAX_OUTPUT_TOKENS=8000
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5
# ANTHROPIC_MAX_TOKENS=2000

# ElevenLabs (text-to-speech for accessibility features)
# ELEVENLABS_API_KEY=

# ─── Redis / BullMQ job queue ─────────────────────────────────
# Overridden by docker-compose to redis://redis:6379 (internal network).
# REDIS_URL=redis://redis:6379

# ─── Object storage ───────────────────────────────────────────
# DigitalOcean Spaces / S3-compatible.
#
# ⚠️ NAMING MISMATCH: edumatch's lib/server/storage.ts reads
#    DO_SPACES_ACCESS_KEY (or DO_SPACES_KEY) and DO_SPACES_SECRET,
#    but the root .env.production.example uses DO_SPACES_ACCESS_KEY_ID
#    and DO_SPACES_SECRET_ACCESS_KEY. You must set BOTH naming
#    conventions in the root .env.production, or edumatch storage
#    will silently fail. See lib/server/storage.ts lines 58-67.
DO_SPACES_ENDPOINT=https://fra1.digitaloceanspaces.com
DO_SPACES_REGION=fra1
DO_SPACES_BUCKET=asafarim-edumatch
# EduMatch reads these names (storage.ts):
DO_SPACES_ACCESS_KEY=
DO_SPACES_KEY=
DO_SPACES_SECRET=
# Root .env.production uses these names (for other apps):
# DO_SPACES_ACCESS_KEY_ID=
# DO_SPACES_SECRET_ACCESS_KEY=
DO_SPACES_PUBLIC_URL=https://asafarim-edumatch.fra1.digitaloceanspaces.com

# ─── Stripe Connect ───────────────────────────────────────────
# EduMatch-specific — NOT in the root .env.production.example.
# Add these to the root .env.production.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Set to false in production (true = bypass Stripe API with mock responses).
STRIPE_MOCK_MODE=false

# ─── Google Maps ──────────────────────────────────────────────
# EduMatch-specific — NOT in the root .env.production.example.
# Used for tutor geocoding / nearby search. Add to the root .env.production.
GOOGLE_MAPS_API_KEY=

# ─── Email notifications ──────────────────────────────────────
# RESEND_API_KEY and FROM_EMAIL are shared — already in root .env.production.
# EduMatch uses its own FROM_EMAIL value; set this in the root file if you
# want edumatch emails to come from a dedicated address.
# RESEND_API_KEY=
FROM_EMAIL=EduMatch <noreply@asafarim.com>
