# EduMatch — environment template
# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development

# ─── Public base URL ──────────────────────────────────────────
# Used by client-side links, og tags, callbacks.
NEXT_PUBLIC_APP_URL=http://localhost:3009

# Optional sub-path mount (leave empty for root)
NEXT_PUBLIC_BASE_PATH=

# ─── Centralized auth ─────────────────────────────────────────
# Reuses the portal-managed NextAuth session.
# AUTH_SECRET *must* match the value in the web app's .env so cross-app
# sessions decode correctly. Generate once with:
#   openssl rand -base64 32
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3009

# Cookie domain for cross-subdomain SSO. Leave blank for localhost; set to
# `.asafarim.com` in production so portal & edumatch share the session cookie.
AUTH_COOKIE_DOMAIN=

# ─── Cross-app platform URLs ──────────────────────────────────
# Port assignments match this repo's docker-compose / pnpm dev (see
# packages/ui/src/links.ts). web is the portal/marketing site; edumatch
# treats it as PORTAL_URL (used by app/admin/layout.tsx).
PORTAL_URL=http://localhost:3000
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_HUB_URL=http://localhost:3001
NEXT_PUBLIC_SHOWCASE_URL=http://localhost:3002
NEXT_PUBLIC_ADMIN_URL=http://localhost:3003
NEXT_PUBLIC_VIONTO_URL=http://localhost:3004
NEXT_PUBLIC_TESTORA_URL=http://localhost:3005
NEXT_PUBLIC_APPBUILDER_URL=http://localhost:3006
EDUMATCH_URL=http://localhost:3009
NEXT_PUBLIC_EDUMATCH_URL=http://localhost:3009

# ─── Database ─────────────────────────────────────────────────
# Reuses packages/db Prisma client. Values must match docker-compose.yml
# (host port 55435) and the root .env.local.
POSTGRES_USER=asafarim
POSTGRES_PASSWORD=
POSTGRES_DB=asafarim
DATABASE_URL=postgresql://asafarim:POSTGRES_PASSWORD@127.0.0.1:55435/asafarim

# ─── AI providers ─────────────────────────────────────────────
# OpenAI is primary; supports vision (gpt-4o) and chat (gpt-4o-mini).
# Whisper-1 is used automatically for audio transcription.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_MAX_OUTPUT_TOKENS=4000

# Anthropic is failover when OpenAI fails or is unavailable.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
ANTHROPIC_MAX_TOKENS=8000

# ElevenLabs (text-to-speech for accessibility features)
ELEVENLABS_API_KEY=

# ─── Redis / BullMQ job queue ─────────────────────────────────
# Required for async AI processing. Use rediss:// for TLS (Upstash,
# ElastiCache). Not required for local streaming.
REDIS_URL=redis://127.0.0.1:6379

# ─── Object storage ───────────────────────────────────────────
# DigitalOcean Spaces / S3-compatible.
DO_SPACES_ENDPOINT=https://<bucket>.fra1.digitaloceanspaces.com
DO_SPACES_REGION=fra1
DO_SPACES_BUCKET=
DO_SPACES_KEY=
DO_SPACES_ACCESS_KEY=
DO_SPACES_SECRET=
# DO_SPACES_PUBLIC_URL=  # optional, defaults to ${endpoint}/${bucket}

# ─── Stripe Connect ───────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_MOCK_MODE=true

# ─── Google Maps ──────────────────────────────────────────────
# Used for tutor geocoding / nearby search (Phase 1.3 / 3.1).
GOOGLE_MAPS_API_KEY=

# ─── Email notifications ──────────────────────────────────────
# Get API key from https://resend.com
RESEND_API_KEY=
FROM_EMAIL=EduMatch <noreply@asafarim.com>
