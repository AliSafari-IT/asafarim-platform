# TasksAI environment (M01). Copy relevant values into the monorepo-root
# .env.local for local dev; production values come from the encrypted
# .env.production.age. Never commit real secrets. See README.md#environment.

# --- Required in staging/production, defaulted locally ---
# Dedicated TasksAI database. MUST NOT equal the platform DATABASE_URL.
TASKSAI_DATABASE_URL=postgres://tasksai:tasksai_dev@127.0.0.1:55438/tasksai
# Public origin of this app (inlined at build time by Next.js).
NEXT_PUBLIC_TASKSAI_URL=http://localhost:3013

# --- Optional / defaulted ---
# Redis for the BullMQ worker. Defaults to the local platform Redis.
TASKSAI_REDIS_URL=redis://localhost:6390
# "staging" on the staging deploy; unset in production and dev.
# TASKSAI_ENVIRONMENT=staging
# Shadow DB for `prisma migrate` drift checks (CI + local migrate dev).
# TASKSAI_SHADOW_DATABASE_URL=postgres://tasksai:tasksai_dev@127.0.0.1:55438/tasksai_shadow
# Throwaway DB for integration tests. MUST NOT equal TASKSAI_DATABASE_URL.
# TASKSAI_TEST_DATABASE_URL=postgres://tasksai:tasksai_ci@127.0.0.1:55438/tasksai_test

# --- Inherited from the platform (do not duplicate here in real envs) ---
# AUTH_SECRET=...            # shared Auth.js secret
# NEXT_PUBLIC_HUB_URL=...    # sign-in gateway origin

# --- M05 capture ---
# Bearer token for POST /api/inbound/email. Unset => the route 404s.
# TASKSAI_INBOUND_WEBHOOK_SECRET=change-me
