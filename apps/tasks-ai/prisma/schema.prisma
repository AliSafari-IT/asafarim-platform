// TasksAI dedicated schema — isolated from the platform Prisma client.
// Client is generated into apps/tasks-ai/lib/db/generated so it can never
// collide with @asafarim/db's client. See docs/adr/0001-dedicated-database.md.
//
// M02: the multi-tenant work graph. Every tenant-owned row carries
// workspaceId (docs/adr/0002-tenant-model.md) and a soft-delete marker.
// Every mutation writes ActivityEvent + OutboxEvent in the same transaction
// (docs/adr/0005-event-outbox-strategy.md).

generator client {
  provider = "prisma-client-js"
  // Generated into the app rather than node_modules: pnpm symlinks that
  // path to the shared store where the PLATFORM client already lives. Two
  // schemas, two clients, no clobbering.
  output        = "../lib/db/generated"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  // url is supplied by prisma.config.ts (datasource.url) so `prisma generate`
  // works in CI/postinstall without a .env file. Matches the jobmatch pattern.
}

/// A single row updated by the readiness probe / migration rehearsal.
model HealthProbe {
  id        String   @id @default("singleton")
  checkedAt DateTime @updatedAt
  note      String?

  @@map("health_probe")
}

// ─────────────────────────────────────────────────────────────────────────
// Tenancy
// ─────────────────────────────────────────────────────────────────────────

enum MemberRole {
  owner
  admin
  member
  guest
}

enum ProjectVisibility {
  workspace
  private
}

/// The tenant boundary. Everything below hangs off a workspace.
model Workspace {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  archivedAt DateTime?

  memberships   Membership[]
  teams         Team[]
  projects      Project[]
  goals         Goal[]
  cycles        Cycle[]
  tasks         Task[]
  statuses      Status[]
  labels        Label[]
  customFields  CustomFieldDef[]
  savedViews    SavedView[]
  activityEvents ActivityEvent[]
  auditEvents   AuditEvent[]
  outboxEvents  OutboxEvent[]
  invitations   Invitation[]
  comments      Comment[]
  attachments   Attachment[]
  watchers      Watcher[]
  notifications Notification[]

  @@map("workspace")
}

/// A platform user's membership in a workspace. platformUserId is the
/// opaque Auth.js session id — no email/name is copied here.
model Membership {
  id             String     @id @default(cuid())
  workspaceId    String
  platformUserId String
  role           MemberRole @default(member)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  archivedAt     DateTime?

  workspace         Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  teamMemberships   TeamMembership[]
  projectMemberships ProjectMembership[]
  assignedTasks     Task[]             @relation("TaskAssignee")
  createdTasks      Task[]             @relation("TaskCreator")
  sentInvitations   Invitation[]       @relation("InvitationInviter")
  comments          Comment[]
  reactions         CommentReaction[]
  watchers          Watcher[]
  notifications     Notification[]
  notificationPreference NotificationPreference?
  uploadedAttachments Attachment[]

  @@unique([workspaceId, platformUserId])
  @@index([workspaceId])
  @@map("membership")
}

model Team {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  key         String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  archivedAt  DateTime?

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members   TeamMembership[]
  projects  Project[]

  @@unique([workspaceId, key])
  @@index([workspaceId])
  @@map("team")
}

model TeamMembership {
  id           String @id @default(cuid())
  teamId       String
  membershipId String

  team       Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([teamId, membershipId])
  @@map("team_membership")
}

// ─────────────────────────────────────────────────────────────────────────
// Structure
// ─────────────────────────────────────────────────────────────────────────

model Project {
  id          String            @id @default(cuid())
  workspaceId String
  teamId      String?
  name        String
  key         String
  description String?
  visibility  ProjectVisibility @default(workspace)
  archivedAt  DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  /// Optimistic-concurrency token; bumped on every update.
  version     Int               @default(0)

  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  team        Team?               @relation(fields: [teamId], references: [id], onDelete: SetNull)
  tasks       Task[]
  statuses    Status[]
  members     ProjectMembership[]
  goalLinks   GoalProject[]

  @@unique([workspaceId, key])
  @@index([workspaceId])
  @@index([workspaceId, archivedAt])
  @@map("project")
}

model ProjectMembership {
  id           String     @id @default(cuid())
  projectId    String
  membershipId String
  role         MemberRole @default(member)

  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([projectId, membershipId])
  @@map("project_membership")
}

model Goal {
  id          String   @id @default(cuid())
  workspaceId String
  title       String
  description String?
  targetDate  DateTime?
  archivedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projects  GoalProject[]

  @@index([workspaceId])
  @@map("goal")
}

model GoalProject {
  goalId    String
  projectId String

  goal    Goal    @relation(fields: [goalId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([goalId, projectId])
  @@map("goal_project")
}

model Cycle {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  startsAt    DateTime
  endsAt      DateTime
  closedAt    DateTime?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@index([workspaceId])
  @@map("cycle")
}

model Status {
  id          String   @id @default(cuid())
  workspaceId String
  projectId   String?
  name        String
  category    String   @default("todo") // todo | in_progress | done | canceled
  position    Int      @default(0)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@index([workspaceId])
  @@map("status")
}

model Label {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  color       String   @default("#8b8b8b")

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks     TaskLabel[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("label")
}

model CustomFieldDef {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  kind        String   // text | number | date | select | checkbox
  options     Json?
  createdAt   DateTime @default(now())

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  values    CustomFieldValue[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("custom_field_def")
}

model CustomFieldValue {
  id      String @id @default(cuid())
  fieldId String
  taskId  String
  value   Json

  field CustomFieldDef @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  task  Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([fieldId, taskId])
  @@map("custom_field_value")
}

// ─────────────────────────────────────────────────────────────────────────
// Tasks
// ─────────────────────────────────────────────────────────────────────────

enum RelationKind {
  blocks
  relates
  duplicates
}

model Task {
  id          String    @id @default(cuid())
  workspaceId String
  projectId   String
  parentId    String?
  cycleId     String?
  statusId    String?
  title       String
  description String?
  assigneeId  String?
  creatorId   String?
  estimate    Float?
  startDate   DateTime?
  dueDate     DateTime?
  completedAt DateTime?
  position    Float     @default(0)
  recurrence  Json?
  /// "manual" | "quick_capture" | "import" | "proposal"
  source      String    @default("manual")
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  /// Optimistic-concurrency token; bumped on every update.
  version     Int       @default(0)

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent     Task?     @relation("TaskHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children   Task[]    @relation("TaskHierarchy")
  cycle      Cycle?    @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  status     Status?   @relation(fields: [statusId], references: [id], onDelete: SetNull)
  assignee   Membership? @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creator    Membership? @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: SetNull)

  labels            TaskLabel[]
  customFieldValues CustomFieldValue[]
  outgoingRelations TaskRelation[]     @relation("RelationFrom")
  incomingRelations TaskRelation[]     @relation("RelationTo")
  comments          Comment[]
  attachments       Attachment[]
  watchers          Watcher[]

  @@index([workspaceId])
  @@index([workspaceId, projectId])
  @@index([workspaceId, assigneeId])
  @@index([workspaceId, dueDate])
  @@index([projectId, archivedAt])
  @@map("task")
}

model TaskLabel {
  taskId  String
  labelId String

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
  @@map("task_label")
}

model TaskRelation {
  id          String       @id @default(cuid())
  workspaceId String
  fromTaskId  String
  toTaskId    String
  kind        RelationKind
  createdAt   DateTime     @default(now())

  fromTask Task @relation("RelationFrom", fields: [fromTaskId], references: [id], onDelete: Cascade)
  toTask   Task @relation("RelationTo", fields: [toTaskId], references: [id], onDelete: Cascade)

  @@unique([fromTaskId, toTaskId, kind])
  @@index([workspaceId])
  @@map("task_relation")
}

// ─────────────────────────────────────────────────────────────────────────
// Views
// ─────────────────────────────────────────────────────────────────────────

model SavedView {
  id          String   @id @default(cuid())
  workspaceId String
  ownerId     String?
  name        String
  /// "inbox" | "my_work" | "list" | "board" | "calendar" | "timeline"
  viewType    String
  /// Serialized filter AST + sort + grouping.
  config      Json
  isShared    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("saved_view")
}

// ─────────────────────────────────────────────────────────────────────────
// Events — activity, audit, outbox (docs/adr/0005)
// ─────────────────────────────────────────────────────────────────────────

model ActivityEvent {
  id            String   @id @default(cuid())
  workspaceId   String
  name          String
  actorType     String   // user | system | automation | ai
  actorId       String?
  targetType    String
  targetId      String
  data          Json
  correlationId String?
  occurredAt    DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, occurredAt])
  @@index([workspaceId, targetType, targetId])
  @@map("activity_event")
}

model AuditEvent {
  id            String   @id @default(cuid())
  workspaceId   String?
  name          String
  actorType     String
  actorId       String?
  onBehalfOf    Json?
  targetType    String?
  targetId      String?
  data          Json
  correlationId String?
  occurredAt    DateTime @default(now())

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([workspaceId, occurredAt])
  @@map("audit_event")
}

enum OutboxStatus {
  pending
  processing
  done
  failed
  dead
}

model OutboxEvent {
  id          String       @id @default(cuid())
  workspaceId String
  type        String
  payload     Json
  status      OutboxStatus @default(pending)
  attempts    Int          @default(0)
  dedupeKey   String?
  availableAt DateTime     @default(now())
  lastError   String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([dedupeKey])
  @@index([status, availableAt])
  @@index([workspaceId])
  @@map("outbox_event")
}

/// Idempotency-Key dedupe records for POST /api/v1 mutations.
model IdempotencyKey {
  id          String   @id @default(cuid())
  workspaceId String
  actorId     String
  key         String
  method      String
  path        String
  requestHash String
  responseCode Int
  responseBody Json
  createdAt   DateTime @default(now())

  @@unique([workspaceId, actorId, key])
  @@index([createdAt])
  @@map("idempotency_key")
}

// ─────────────────────────────────────────────────────────────────────────
// M04 — collaboration, realtime, notifications
// ─────────────────────────────────────────────────────────────────────────

enum InvitationStatus {
  pending
  accepted
  revoked
  expired
}

model Invitation {
  id          String           @id @default(cuid())
  workspaceId String
  email       String
  emailHash   String
  role        MemberRole       @default(member)
  status      InvitationStatus @default(pending)
  token       String           @unique
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime         @default(now())

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy Membership @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: Cascade)

  @@unique([workspaceId, emailHash, status])
  @@index([workspaceId])
  @@map("invitation")
}

model Comment {
  id          String   @id @default(cuid())
  workspaceId String
  taskId      String
  authorId    String
  body        String
  /// membershipIds mentioned via @, resolved server-side at create time.
  mentions    String[]
  editedAt    DateTime?
  deletedAt   DateTime?
  createdAt   DateTime @default(now())

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task      Task              @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author    Membership        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  reactions CommentReaction[]

  @@index([workspaceId, taskId, createdAt])
  @@map("comment")
}

model CommentReaction {
  id           String @id @default(cuid())
  commentId    String
  membershipId String
  emoji        String

  comment    Comment    @relation(fields: [commentId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([commentId, membershipId, emoji])
  @@map("comment_reaction")
}

enum ScanState {
  pending
  clean
  quarantined
  skipped
}

/// Attachment metadata only. Bytes live in private object storage; the app
/// hands out signed, time-limited download URLs and never proxies the file.
/// A quarantine decision is recorded per object (docs: M00 attachment
/// security decision) — pending uploads are not downloadable.
model Attachment {
  id           String    @id @default(cuid())
  workspaceId  String
  taskId       String
  uploadedById String
  storageKey   String    @unique
  filename     String
  contentType  String
  byteSize     Int
  scanState    ScanState @default(pending)
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  workspace  Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task       Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedBy Membership @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([workspaceId, taskId])
  @@map("attachment")
}

model Watcher {
  id           String   @id @default(cuid())
  workspaceId  String
  taskId       String
  membershipId String
  createdAt    DateTime @default(now())

  workspace  Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task       Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([taskId, membershipId])
  @@index([workspaceId, membershipId])
  @@map("watcher")
}

enum NotificationChannel {
  in_app
  email
}

model Notification {
  id           String   @id @default(cuid())
  workspaceId  String
  recipientId  String
  kind         String   // mention | assigned | comment | watched_change | invite_accepted
  taskId       String?
  actorId      String?
  data         Json
  /// Set once the recipient has seen it in the inbox.
  readAt       DateTime?
  /// Set once it has been included in a delivered email digest.
  digestedAt   DateTime?
  dedupeKey    String?
  createdAt    DateTime @default(now())

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  recipient Membership @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([dedupeKey])
  @@index([recipientId, readAt, createdAt])
  @@map("notification")
}

model NotificationPreference {
  membershipId    String  @id
  emailDigest     Boolean @default(true)
  /// "off" | "hourly" | "daily"
  digestCadence   String  @default("daily")
  mentionEmail    Boolean @default(true)
  assignmentEmail Boolean @default(true)
  /// Local-time quiet-hours window, e.g. "22:00-07:00", or null.
  quietHours      String?

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@map("notification_preference")
}
