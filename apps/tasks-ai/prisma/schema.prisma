// TasksAI dedicated schema — isolated from the platform Prisma client.
// Client is generated into apps/tasks-ai/lib/db/generated so it can never
// collide with @asafarim/db's client. See docs/adr/0001-dedicated-database.md.
//
// M02: the multi-tenant work graph. Every tenant-owned row carries
// workspaceId (docs/adr/0002-tenant-model.md) and a soft-delete marker.
// Every mutation writes ActivityEvent + OutboxEvent in the same transaction
// (docs/adr/0005-event-outbox-strategy.md).
// M01 keeps this schema deliberately minimal: just enough to exercise a
// real migration, a real connection, and the readiness probe. The
// multi-tenant work graph (Workspace, Project, Task, events, outbox …)
// lands in M02 — docs/adr/0002 and docs/adr/0005.

generator client {
  provider = "prisma-client-js"
  // Generated into the app rather than node_modules: pnpm symlinks that
  // path to the shared store where the PLATFORM client already lives. Two
  // schemas, two clients, no clobbering.
  output        = "../lib/db/generated"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  // url is supplied by prisma.config.ts (datasource.url) so `prisma generate`
  // works in CI/postinstall without a .env file. Matches the jobmatch pattern.
}

/// A single row updated by the readiness probe / migration rehearsal.
/// Lets `/api/health` and the worker prove they can round-trip the
/// dedicated database without depending on any domain table.
model HealthProbe {
  id        String   @id @default("singleton")
  checkedAt DateTime @updatedAt
  note      String?

  @@map("health_probe")
}

// ─────────────────────────────────────────────────────────────────────────
// Tenancy
// ─────────────────────────────────────────────────────────────────────────

enum MemberRole {
  owner
  admin
  member
  guest
}

enum ProjectVisibility {
  workspace
  private
}

/// The tenant boundary. Everything below hangs off a workspace.
model Workspace {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  archivedAt DateTime?

  memberships   Membership[]
  teams         Team[]
  projects      Project[]
  goals         Goal[]
  cycles        Cycle[]
  tasks         Task[]
  statuses      Status[]
  labels        Label[]
  customFields  CustomFieldDef[]
  savedViews    SavedView[]
  activityEvents ActivityEvent[]
  auditEvents   AuditEvent[]
  outboxEvents  OutboxEvent[]
  invitations   Invitation[]
  comments      Comment[]
  attachments   Attachment[]
  watchers      Watcher[]
  notifications Notification[]

  @@map("workspace")
}

/// A platform user's membership in a workspace. platformUserId is the
/// opaque Auth.js session id — no email/name is copied here.
model Membership {
  id             String     @id @default(cuid())
  workspaceId    String
  platformUserId String
  role           MemberRole @default(member)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  archivedAt     DateTime?

  workspace         Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  teamMemberships   TeamMembership[]
  projectMemberships ProjectMembership[]
  assignedTasks     Task[]             @relation("TaskAssignee")
  createdTasks      Task[]             @relation("TaskCreator")
  sentInvitations   Invitation[]       @relation("InvitationInviter")
  comments          Comment[]
  reactions         CommentReaction[]
  watchers          Watcher[]
  notifications     Notification[]
  notificationPreference NotificationPreference?
  uploadedAttachments Attachment[]

  @@unique([workspaceId, platformUserId])
  @@index([workspaceId])
  @@map("membership")
}

model Team {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  key         String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  archivedAt  DateTime?

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members   TeamMembership[]
  projects  Project[]

  @@unique([workspaceId, key])
  @@index([workspaceId])
  @@map("team")
}

model TeamMembership {
  id           String @id @default(cuid())
  teamId       String
  membershipId String

  team       Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([teamId, membershipId])
  @@map("team_membership")
}

// ─────────────────────────────────────────────────────────────────────────
// Structure
// ─────────────────────────────────────────────────────────────────────────

model Project {
  id          String            @id @default(cuid())
  workspaceId String
  teamId      String?
  name        String
  key         String
  description String?
  visibility  ProjectVisibility @default(workspace)
  archivedAt  DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  /// Optimistic-concurrency token; bumped on every update.
  version     Int               @default(0)

  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  team        Team?               @relation(fields: [teamId], references: [id], onDelete: SetNull)
  tasks       Task[]
  statuses    Status[]
  members     ProjectMembership[]
  goalLinks   GoalProject[]

  @@unique([workspaceId, key])
  @@index([workspaceId])
  @@index([workspaceId, archivedAt])
  @@map("project")
}

model ProjectMembership {
  id           String     @id @default(cuid())
  projectId    String
  membershipId String
  role         MemberRole @default(member)

  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([projectId, membershipId])
  @@map("project_membership")
}

model Goal {
  id          String   @id @default(cuid())
  workspaceId String
  title       String
  description String?
  targetDate  DateTime?
  archivedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projects  GoalProject[]

  @@index([workspaceId])
  @@map("goal")
}

model GoalProject {
  goalId    String
  projectId String

  goal    Goal    @relation(fields: [goalId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([goalId, projectId])
  @@map("goal_project")
}

model Cycle {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  startsAt    DateTime
  endsAt      DateTime
  closedAt    DateTime?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@index([workspaceId])
  @@map("cycle")
}

model Status {
  id          String   @id @default(cuid())
  workspaceId String
  projectId   String?
  name        String
  category    String   @default("todo") // todo | in_progress | done | canceled
  position    Int      @default(0)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@index([workspaceId])
  @@map("status")
}

model Label {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  color       String   @default("#8b8b8b")

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks     TaskLabel[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("label")
}

model CustomFieldDef {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  kind        String   // text | number | date | select | checkbox
  options     Json?
  createdAt   DateTime @default(now())

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  values    CustomFieldValue[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("custom_field_def")
}

model CustomFieldValue {
  id      String @id @default(cuid())
  fieldId String
  taskId  String
  value   Json

  field CustomFieldDef @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  task  Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([fieldId, taskId])
  @@map("custom_field_value")
}

// ─────────────────────────────────────────────────────────────────────────
// Tasks
// ─────────────────────────────────────────────────────────────────────────

enum RelationKind {
  blocks
  relates
  duplicates
}

model Task {
  id          String    @id @default(cuid())
  workspaceId String
  projectId   String
  parentId    String?
  cycleId     String?
  statusId    String?
  title       String
  description String?
  assigneeId  String?
  creatorId   String?
  estimate    Float?
  startDate   DateTime?
  dueDate     DateTime?
  completedAt DateTime?
  position    Float     @default(0)
  recurrence  Json?
  /// "manual" | "quick_capture" | "import" | "proposal"
  source      String    @default("manual")
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  /// Optimistic-concurrency token; bumped on every update.
  version     Int       @default(0)

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent     Task?     @relation("TaskHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children   Task[]    @relation("TaskHierarchy")
  cycle      Cycle?    @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  status     Status?   @relation(fields: [statusId], references: [id], onDelete: SetNull)
  assignee   Membership? @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creator    Membership? @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: SetNull)

  labels            TaskLabel[]
  customFieldValues CustomFieldValue[]
  outgoingRelations TaskRelation[]     @relation("RelationFrom")
  incomingRelations TaskRelation[]     @relation("RelationTo")
  comments          Comment[]
  attachments       Attachment[]
  watchers          Watcher[]

  @@index([workspaceId])
  @@index([workspaceId, projectId])
  @@index([workspaceId, assigneeId])
  @@index([workspaceId, dueDate])
  @@index([projectId, archivedAt])
  @@map("task")
}

model TaskLabel {
  taskId  String
  labelId String

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
  @@map("task_label")
}

model TaskRelation {
  id          String       @id @default(cuid())
  workspaceId String
  fromTaskId  String
  toTaskId    String
  kind        RelationKind
  createdAt   DateTime     @default(now())

  fromTask Task @relation("RelationFrom", fields: [fromTaskId], references: [id], onDelete: Cascade)
  toTask   Task @relation("RelationTo", fields: [toTaskId], references: [id], onDelete: Cascade)

  @@unique([fromTaskId, toTaskId, kind])
  @@index([workspaceId])
  @@map("task_relation")
}

// ─────────────────────────────────────────────────────────────────────────
// Views
// ─────────────────────────────────────────────────────────────────────────

model SavedView {
  id          String   @id @default(cuid())
  workspaceId String
  ownerId     String?
  name        String
  /// "inbox" | "my_work" | "list" | "board" | "calendar" | "timeline"
  viewType    String
  /// Serialized filter AST + sort + grouping.
  config      Json
  isShared    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("saved_view")
}

// ─────────────────────────────────────────────────────────────────────────
// Events — activity, audit, outbox (docs/adr/0005)
// ─────────────────────────────────────────────────────────────────────────

model ActivityEvent {
  id            String   @id @default(cuid())
  workspaceId   String
  name          String
  actorType     String   // user | system | automation | ai
  actorId       String?
  targetType    String
  targetId      String
  data          Json
  correlationId String?
  occurredAt    DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, occurredAt])
  @@index([workspaceId, targetType, targetId])
  @@map("activity_event")
}

model AuditEvent {
  id            String   @id @default(cuid())
  workspaceId   String?
  name          String
  actorType     String
  actorId       String?
  onBehalfOf    Json?
  targetType    String?
  targetId      String?
  data          Json
  correlationId String?
  occurredAt    DateTime @default(now())

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([workspaceId, occurredAt])
  @@map("audit_event")
}

enum OutboxStatus {
  pending
  processing
  done
  failed
  dead
}

model OutboxEvent {
  id          String       @id @default(cuid())
  workspaceId String
  type        String
  payload     Json
  status      OutboxStatus @default(pending)
  attempts    Int          @default(0)
  dedupeKey   String?
  availableAt DateTime     @default(now())
  lastError   String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([dedupeKey])
  @@index([status, availableAt])
  @@index([workspaceId])
  @@map("outbox_event")
}

/// Idempotency-Key dedupe records for POST /api/v1 mutations.
model IdempotencyKey {
  id          String   @id @default(cuid())
  workspaceId String
  actorId     String
  key         String
  method      String
  path        String
  requestHash String
  responseCode Int
  responseBody Json
  createdAt   DateTime @default(now())

  @@unique([workspaceId, actorId, key])
  @@index([createdAt])
  @@map("idempotency_key")
}

// ─────────────────────────────────────────────────────────────────────────
// M04 — collaboration, realtime, notifications
// ─────────────────────────────────────────────────────────────────────────

enum InvitationStatus {
  pending
  accepted
  revoked
  expired
}

model Invitation {
  id          String           @id @default(cuid())
  workspaceId String
  email       String
  emailHash   String
  role        MemberRole       @default(member)
  status      InvitationStatus @default(pending)
  token       String           @unique
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime         @default(now())

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy Membership @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: Cascade)

  @@unique([workspaceId, emailHash, status])
  @@index([workspaceId])
  @@map("invitation")
}

model Comment {
  id          String   @id @default(cuid())
  workspaceId String
  taskId      String
  authorId    String
  body        String
  /// membershipIds mentioned via @, resolved server-side at create time.
  mentions    String[]
  editedAt    DateTime?
  deletedAt   DateTime?
  createdAt   DateTime @default(now())

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task      Task              @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author    Membership        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  reactions CommentReaction[]

  @@index([workspaceId, taskId, createdAt])
  @@map("comment")
}

model CommentReaction {
  id           String @id @default(cuid())
  commentId    String
  membershipId String
  emoji        String

  comment    Comment    @relation(fields: [commentId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([commentId, membershipId, emoji])
  @@map("comment_reaction")
}

enum ScanState {
  pending
  clean
  quarantined
  skipped
}

/// Attachment metadata only. Bytes live in private object storage; the app
/// hands out signed, time-limited download URLs and never proxies the file.
/// A quarantine decision is recorded per object (docs: M00 attachment
/// security decision) — pending uploads are not downloadable.
model Attachment {
  id           String    @id @default(cuid())
  workspaceId  String
  taskId       String
  uploadedById String
  storageKey   String    @unique
  filename     String
  contentType  String
  byteSize     Int
  scanState    ScanState @default(pending)
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  workspace  Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task       Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedBy Membership @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([workspaceId, taskId])
  @@map("attachment")
}

model Watcher {
  id           String   @id @default(cuid())
  workspaceId  String
  taskId       String
  membershipId String
  createdAt    DateTime @default(now())

  workspace  Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task       Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([taskId, membershipId])
  @@index([workspaceId, membershipId])
  @@map("watcher")
}

enum NotificationChannel {
  in_app
  email
}

model Notification {
  id           String   @id @default(cuid())
  workspaceId  String
  recipientId  String
  kind         String   // mention | assigned | comment | watched_change | invite_accepted
  taskId       String?
  actorId      String?
  data         Json
  /// Set once the recipient has seen it in the inbox.
  readAt       DateTime?
  /// Set once it has been included in a delivered email digest.
  digestedAt   DateTime?
  dedupeKey    String?
  createdAt    DateTime @default(now())

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  recipient Membership @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([dedupeKey])
  @@index([recipientId, readAt, createdAt])
  @@map("notification")
}

model NotificationPreference {
  membershipId    String  @id
  emailDigest     Boolean @default(true)
  /// "off" | "hourly" | "daily"
  digestCadence   String  @default("daily")
  mentionEmail    Boolean @default(true)
  assignmentEmail Boolean @default(true)
  /// Local-time quiet-hours window, e.g. "22:00-07:00", or null.
  quietHours      String?

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@map("notification_preference")
}

// ─────────────────────────────────────────────────────────────────────────
// M05 — capture, search, import, portability
// ─────────────────────────────────────────────────────────────────────────

model SavedSearch {
  id           String   @id @default(cuid())
  workspaceId  String
  membershipId String
  name         String
  query        String
  filters      Json?
  createdAt    DateTime @default(now())

  @@index([workspaceId, membershipId])
  @@map("saved_search")
}

model SearchHistory {
  id           String   @id @default(cuid())
  workspaceId  String
  membershipId String
  query        String
  ranAt        DateTime @default(now())

  @@index([workspaceId, membershipId, ranAt])
  @@map("search_history")
}

enum ImportKind {
  csv
  json
}

enum ImportState {
  validating
  dry_run_ready
  applying
  completed
  failed
}

/// A resumable import job. Rows are staged in `rows` (Json) with a stable
/// `rowKey` per source row so a re-run applies each row exactly once.
model ImportJob {
  id           String      @id @default(cuid())
  workspaceId  String
  membershipId String
  kind         ImportKind
  filename     String
  mapping      Json
  state        ImportState @default(validating)
  totalRows    Int         @default(0)
  appliedRows  Int         @default(0)
  failedRows   Int         @default(0)
  errors       Json        @default("[]")
  /// Staged, validated source rows: [{ rowKey, data, status }]
  rows         Json        @default("[]")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([workspaceId, state])
  @@map("import_job")
}

/// A unique inbound-email address per workspace for capture-by-email.
/// `secret` signs the local-part so a guessed address cannot inject tasks.
model InboundAddress {
  id          String   @id @default(cuid())
  workspaceId String   @unique
  localPart   String   @unique
  secret      String
  projectId   String?
  createdAt   DateTime @default(now())

  @@map("inbound_address")
}

/// Replay guard for inbound email: a message-id is accepted at most once
/// per workspace.
model InboundMessage {
  id          String   @id @default(cuid())
  workspaceId String
  messageId   String
  taskId      String?
  receivedAt  DateTime @default(now())

  @@unique([workspaceId, messageId])
  @@map("inbound_message")
}

// ─────────────────────────────────────────────────────────────────────────
// M06 — AI safety, evaluation, provider boundary
// ─────────────────────────────────────────────────────────────────────────

enum AiJobState {
  queued
  running
  succeeded
  failed
  cancelled
  degraded
}

/// One AI generation request. The state machine and the usage ledger row
/// are written together. `promptVersion` + `provider` + `model` make every
/// result reproducible from versioned inputs.
model AiJob {
  id            String     @id @default(cuid())
  workspaceId   String
  membershipId  String
  kind          String     // extract_plan | decompose | acceptance_criteria | summarize | nl_query
  state         AiJobState @default(queued)
  provider      String
  model         String
  promptVersion String
  /// sha256 of the (redacted) rendered prompt — the cache key.
  cacheKey      String
  inputTokens   Int?
  outputTokens  Int?
  costUsd       Float?
  latencyMs     Int?
  error         String?
  cancelledAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  proposal Proposal?

  @@index([workspaceId, state])
  @@index([workspaceId, cacheKey])
  @@map("ai_job")
}

/// Append-only spend ledger. One row per billable (or fixture, cost 0)
/// call. Reconciled against AiJob and used for per-workspace budgets.
model AiUsageLedger {
  id           String   @id @default(cuid())
  workspaceId  String
  aiJobId      String
  provider     String
  model        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  costUsd      Float    @default(0)
  fixture      Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([workspaceId, createdAt])
  @@map("ai_usage_ledger")
}

/// Per-workspace AI controls. `enabled=false` is the kill switch: AI
/// features stop, core task management is untouched.
model AiSettings {
  workspaceId       String  @id
  enabled           Boolean @default(true)
  /// Monthly spend cap in USD. null = provider/plan default.
  monthlyBudgetUsd  Float?
  /// Monthly job cap. null = unlimited within budget.
  monthlyJobQuota   Int?
  /// Max entities a single proposal may create/update/link.
  maxBlastRadius    Int     @default(50)
  provider          String  @default("fixture")
  model             String  @default("fixture-1")
  updatedAt         DateTime @updatedAt

  @@map("ai_settings")
}

enum ProposalState {
  draft
  previewed
  applied
  partially_applied
  rejected
  undone
  regenerating
}

/// The only way AI affects data (docs/adr/0004): a reviewable, cited,
/// undoable set of operations. Nothing here mutates a domain row until a
/// user applies it.
model Proposal {
  id           String        @id @default(cuid())
  workspaceId  String
  aiJobId      String        @unique
  membershipId String
  kind         String
  state        ProposalState @default(draft)
  /// Grouped operations with per-fact citations / assumptions + confidence.
  operations   Json
  /// Inverse operations captured at apply time.
  undoPlan     Json?
  summary      String?
  appliedAt    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  aiJob AiJob @relation(fields: [aiJobId], references: [id], onDelete: Cascade)

  @@index([workspaceId, state])
  @@map("proposal")
}

// ─────────────────────────────────────────────────────────────────────────
// M07 — AI copilot: proposal feedback + duplicate suggestions
// ─────────────────────────────────────────────────────────────────────────

model ProposalFeedback {
  id           String   @id @default(cuid())
  workspaceId  String
  proposalId   String
  membershipId String
  /// accepted | partially_accepted | rejected | regenerated
  outcome      String
  /// 0..1 normalized edit distance between generated and applied ops
  editDistance Float?
  /// user's estimate of minutes saved
  timeSavedMin Int?
  /// free-text reason when correcting/rejecting
  correctionReason String?
  /// 1..5 trust rating for this interaction
  trust        Int?
  createdAt    DateTime @default(now())

  @@index([workspaceId, createdAt])
  @@index([proposalId])
  @@map("proposal_feedback")
}

// ─────────────────────────────────────────────────────────────────────────
// M08 — focus, risk & workload intelligence
// ─────────────────────────────────────────────────────────────────────────

model SignalPreference {
  id           String   @id @default(cuid())
  workspaceId  String
  membershipId String
  /// signal type key, e.g. "due_date_risk" | "stale_work" | "blocker_chain"
  signalType   String
  enabled      Boolean  @default(true)
  /// per-user weight multiplier for focus-ranking factors, 0..2
  weight       Float    @default(1)
  updatedAt    DateTime @updatedAt

  @@unique([workspaceId, membershipId, signalType])
  @@map("signal_preference")
}

model SignalFeedback {
  id           String   @id @default(cuid())
  workspaceId  String
  membershipId String
  signalType   String
  targetType   String
  targetId     String
  /// false_alarm | missed | helpful | wrong_evidence
  verdict      String
  /// the rule/model version the signal was produced by (reproducibility)
  ruleVersion  String
  note         String?
  createdAt    DateTime @default(now())

  @@index([workspaceId, signalType, createdAt])
  @@map("signal_feedback")
}

// ─────────────────────────────────────────────────────────────────────────
// M09 — rules, automations & integration platform
// ─────────────────────────────────────────────────────────────────────────

enum RuleState {
  draft
  active
  paused
}

enum RunState {
  dry_run
  succeeded
  failed
  skipped
  dead
}

model AutomationRule {
  id           String    @id @default(cuid())
  workspaceId  String
  membershipId String
  name         String
  state        RuleState @default(draft)
  /// { event: "task.status_changed", filters: [{field,op,value}] }
  trigger      Json
  /// [{field,op,value}] — ANDed
  conditions   Json      @default("[]")
  /// [{type: "set_status"|"assign"|"add_label"|"comment"|"webhook", params}]
  actions      Json
  /// per-rule cap to stop runaway executions in a window
  maxRunsPerHour Int     @default(60)
  lastRunAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  runs AutomationRun[]

  @@index([workspaceId, state])
  @@map("automation_rule")
}

model AutomationRun {
  id          String   @id @default(cuid())
  workspaceId String
  ruleId      String
  state       RunState
  /// the triggering event envelope (redacted)
  trigger     Json
  /// per-action outcome log
  log         Json     @default("[]")
  error       String?
  attempts    Int      @default(0)
  /// correlation to prevent an action re-triggering its own rule (loop guard)
  causationId String?
  createdAt   DateTime @default(now())

  rule AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([workspaceId, ruleId, createdAt])
  @@map("automation_run")
}

/// Scoped API token. Only the sha256 hash is stored; the plaintext is shown
/// once at creation.
model ApiToken {
  id           String    @id @default(cuid())
  workspaceId  String
  membershipId String
  name         String
  tokenHash    String    @unique
  prefix       String    // first 8 chars, for display / lookup hint
  /// ["tasks:read","tasks:write","projects:read", ...]
  scopes       String[]
  lastUsedAt   DateTime?
  expiresAt    DateTime?
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())
  rotatedFrom  String?

  @@index([workspaceId])
  @@map("api_token")
}

model WebhookEndpoint {
  id          String   @id @default(cuid())
  workspaceId String
  url         String
  /// signing secret (sha256-HMAC of the body); rotatable
  secret      String
  /// event names this endpoint wants
  events      String[]
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  deliveries WebhookDelivery[]

  @@index([workspaceId])
  @@map("webhook_endpoint")
}

model WebhookDelivery {
  id          String   @id @default(cuid())
  workspaceId String
  endpointId  String
  event       String
  /// idempotency: an event is delivered to an endpoint at most once
  dedupeKey   String
  payload     Json
  status      String   @default("pending") // pending | delivered | failed | dead
  responseCode Int?
  attempts    Int      @default(0)
  nextAttemptAt DateTime @default(now())
  createdAt   DateTime @default(now())

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@unique([endpointId, dedupeKey])
  @@index([status, nextAttemptAt])
  @@map("webhook_delivery")
}

model Integration {
  id          String   @id @default(cuid())
  workspaceId String
  provider    String   // "github"
  /// external identifier (repo full name for github)
  externalRef String
  config      Json     @default("{}")
  /// inbound webhook signing secret from the provider
  secret      String
  createdAt   DateTime @default(now())

  @@unique([workspaceId, provider, externalRef])
  @@map("integration")
}

model IntegrationEvent {
  id            String   @id @default(cuid())
  workspaceId   String
  provider      String
  externalId    String
  kind          String
  taskId        String?
  receivedAt    DateTime @default(now())

  @@unique([provider, externalId])
  @@map("integration_event")
}

// ─────────────────────────────────────────────────────────────────────────
// M10 — goals, cycles, time & portfolio analytics
// ─────────────────────────────────────────────────────────────────────────

model KeyResult {
  id           String   @id @default(cuid())
  workspaceId  String
  goalId       String
  name         String
  /// numeric target; progress is current/target
  startValue   Float    @default(0)
  targetValue  Float
  currentValue Float    @default(0)
  unit         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([workspaceId, goalId])
  @@map("key_result")
}

model TimeEntry {
  id           String   @id @default(cuid())
  workspaceId  String
  taskId       String
  membershipId String
  minutes      Int
  spentOn      DateTime
  note         String?
  createdAt    DateTime @default(now())

  @@index([workspaceId, taskId])
  @@index([workspaceId, spentOn])
  @@map("time_entry")
}

/// Point-in-time metric snapshot. Written when a metric definition changes
/// or on a schedule, so history survives redefinition (docs: M10).
model MetricSnapshot {
  id           String   @id @default(cuid())
  workspaceId  String
  scope        String   // "workspace" | "project:<id>" | "cycle:<id>"
  metric       String   // "cycle_time_p50" | "throughput_7d" | ...
  value        Float
  /// the semantics version this value was computed under
  defVersion   String
  windowStart  DateTime
  windowEnd    DateTime
  createdAt    DateTime @default(now())

  @@index([workspaceId, scope, metric, createdAt])
  @@map("metric_snapshot")
}

/// A saved forecast with its assumptions + confidence band, versioned so a
/// later methodology change is attributable.
model Forecast {
  id            String   @id @default(cuid())
  workspaceId   String
  scope         String
  /// remaining scope (task count) the forecast is for
  remaining     Int
  /// { p50, p80, p95 } completion dates (ISO)
  bands         Json
  assumptions   Json
  method        String   @default("throughput-sample@1")
  createdAt     DateTime @default(now())

  @@index([workspaceId, scope, createdAt])
  @@map("forecast")
}

// ─────────────────────────────────────────────────────────────────────────
// M12 — security, privacy, admin & reliability
// ─────────────────────────────────────────────────────────────────────────

enum DsrKind {
  export
  delete
}

enum DsrState {
  requested
  processing
  completed
  failed
}

/// A data-subject request (GDPR). `export` produces a manifest + bundle;
/// `delete` runs the verified-deletion job and records what was removed.
model DataSubjectRequest {
  id             String   @id @default(cuid())
  workspaceId    String
  /// opaque platform user id the request concerns
  subjectUserId  String
  requestedBy    String
  kind           DsrKind
  state          DsrState @default(requested)
  /// manifest of what was found / removed
  manifest       Json     @default("{}")
  verification   Json     @default("{}")
  completedAt    DateTime?
  createdAt      DateTime @default(now())

  @@index([workspaceId, state])
  @@map("data_subject_request")
}

/// Time-boxed elevated access for support / incident response. Every use is
/// audited; the grant self-expires.
model BreakGlassGrant {
  id           String   @id @default(cuid())
  workspaceId  String
  grantedTo    String   // platform user id of the operator
  reason       String
  ticketRef    String?
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime @default(now())

  @@index([workspaceId, expiresAt])
  @@map("break_glass_grant")
}

/// Sliding-window rate-limit counters (privileged ops + write bursts).
model RateCounter {
  id        String   @id @default(cuid())
  bucketKey String   @unique
  count     Int      @default(0)
  windowEnd DateTime

  @@index([windowEnd])
  @@map("rate_counter")
}

// ─────────────────────────────────────────────────────────────────────────
// M13 — design-partner beta & product-market validation
// ─────────────────────────────────────────────────────────────────────────

model BetaConsent {
  id             String   @id @default(cuid())
  workspaceId    String
  membershipId   String
  /// version of the beta terms consented to
  termsVersion   String
  consentedAt    DateTime @default(now())

  @@unique([workspaceId, membershipId, termsVersion])
  @@map("beta_consent")
}

/// Per-workspace beta enrolment + cohort tag for the concierge study.
model BetaEnrollment {
  workspaceId  String   @id
  cohort       String   // "concierge" | "self_serve"
  teamType     String?  // "agency" | "consultancy" | "product"
  enrolledAt   DateTime @default(now())
  segment      String?
  decision     String?  // "continue" | "narrow" | "remediate" | "stop"
  decidedAt    DateTime?

  @@map("beta_enrollment")
}

enum FeedbackSeverity {
  blocker
  major
  minor
  idea
}

enum FeedbackState {
  triage
  accepted
  in_progress
  resolved
  wont_do
}

/// Feedback triage (docs: M13). Every item has severity, source, owner and
/// a response-SLA deadline; links to the product/rule/model change that
/// addressed it.
model FeedbackItem {
  id           String           @id @default(cuid())
  workspaceId  String
  reportedBy   String
  source       String           // "in_app" | "interview" | "email" | "support" | "observed"
  severity     FeedbackSeverity
  state        FeedbackState    @default(triage)
  title        String
  detail       String
  ownerId      String?
  /// response-SLA deadline derived from severity at creation
  respondBy    DateTime
  respondedAt  DateTime?
  /// e.g. "prompt:extract_plan@2" | "rule:signals@1" | "pr:#221"
  linkedChange String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([workspaceId, state, severity])
  @@index([workspaceId, respondBy])
  @@map("feedback_item")
}

// ─────────────────────────────────────────────────────────────────────────
// M14 — billing, packaging & public launch
// ─────────────────────────────────────────────────────────────────────────

enum PlanTier {
  free
  pro
  business
  enterprise
}

enum SubStatus {
  trialing
  active
  past_due
  grace
  canceled
}

model Subscription {
  workspaceId       String    @id
  tier              PlanTier  @default(free)
  status            SubStatus @default(active)
  seats             Int       @default(3)
  /// Stripe ids (test mode) — null on the free plan.
  stripeCustomerId  String?
  stripeSubId       String?
  trialEndsAt       DateTime?
  currentPeriodEnd  DateTime?
  graceEndsAt       DateTime?
  canceledAt        DateTime?
  updatedAt         DateTime  @updatedAt

  @@map("subscription")
}

/// A metered allowance window (AI proposals, automation runs). Reset each
/// billing period; overage is blocked, not silently charged.
model UsageMeter {
  id           String   @id @default(cuid())
  workspaceId  String
  meter        String   // "ai_proposals" | "automation_runs"
  periodStart  DateTime
  periodEnd    DateTime
  used         Int      @default(0)
  included     Int
  /// paid top-up units added on top of `included`
  topUp        Int      @default(0)
  updatedAt    DateTime @updatedAt

  @@unique([workspaceId, meter, periodStart])
  @@index([workspaceId, meter])
  @@map("usage_meter")
}

model Invoice {
  id               String   @id @default(cuid())
  workspaceId      String
  stripeInvoiceId  String?  @unique
  amountCents      Int
  currency         String   @default("eur")
  status           String   // "draft" | "open" | "paid" | "void" | "uncollectible"
  periodStart      DateTime
  periodEnd        DateTime
  hostedUrl        String?
  createdAt        DateTime @default(now())

  @@index([workspaceId, createdAt])
  @@map("invoice")
}

/// Idempotency for Stripe webhook events.
model BillingEvent {
  id          String   @id
  type        String
  workspaceId String?
  processedAt DateTime @default(now())

  @@map("billing_event")
}

model Referral {
  id          String   @id @default(cuid())
  workspaceId String
  code        String   @unique
  redeemedBy  String?  // workspace id that signed up with this code
  redeemedAt  DateTime?
  createdAt   DateTime @default(now())

  @@map("referral")
}

// ─────────────────────────────────────────────────────────────────────────
// M15 — enterprise readiness & ecosystem expansion
// ─────────────────────────────────────────────────────────────────────────

/// A verified email domain a workspace controls. Once verified, invites to
/// that domain can be auto-approved and SCIM/SAML bound to it.
model DomainClaim {
  id           String    @id @default(cuid())
  workspaceId  String
  domain       String    @unique
  verifyToken  String
  verifiedAt   DateTime?
  autoJoin     Boolean   @default(false)
  createdAt    DateTime  @default(now())

  @@index([workspaceId])
  @@map("domain_claim")
}

/// A non-human principal (CI, an internal service). Bearer credential is a
/// hashed API token via the M09 ApiToken table; this row holds the policy.
model ServiceAccount {
  id           String    @id @default(cuid())
  workspaceId  String
  name         String
  tokenId      String?   // the ApiToken minted for it
  /// CIDR allowlist for calls made with this account, or null = any
  ipAllowlist  String[]
  disabledAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([workspaceId])
  @@map("service_account")
}

/// Per-workspace retention overrides (enterprise, justified). null = the
/// platform default from the retention schedule.
model RetentionPolicy {
  workspaceId        String  @id
  activityDays       Int?
  auditDays          Int?
  outboxDays         Int?
  notificationDays   Int?
  updatedAt          DateTime @updatedAt

  @@map("retention_policy")
}

/// A legal hold suspends retention deletion for matching data until lifted.
model LegalHold {
  id           String    @id @default(cuid())
  workspaceId  String
  reason       String
  scope        String    // "workspace" | "project:<id>"
  placedBy     String
  liftedAt     DateTime?
  liftedBy     String?
  createdAt    DateTime  @default(now())

  @@index([workspaceId, liftedAt])
  @@map("legal_hold")
}

/// Streams audit events to an external SIEM endpoint (signed, like webhooks).
model AuditStream {
  id           String    @id @default(cuid())
  workspaceId  String    @unique
  url          String
  secret       String
  active       Boolean   @default(true)
  cursor       DateTime  @default(now())
  createdAt    DateTime  @default(now())

  @@map("audit_stream")
}

/// SCIM-style provisioning log — one row per push, for reconciliation.
model ScimEvent {
  id           String   @id @default(cuid())
  workspaceId  String
  externalId   String
  op           String   // "create" | "update" | "deactivate"
  membershipId String?
  receivedAt   DateTime @default(now())

  @@unique([workspaceId, externalId, op, receivedAt])
  @@index([workspaceId])
  @@map("scim_event")
}
