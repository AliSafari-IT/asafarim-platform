{
  "name": "@asafarim/tasks-ai",
  "version": "0.1.0",
  "private": true,
  "description": "TasksAI - AI-native work execution: scattered intent to trusted execution (tasks-ai.asafarim.com)",
  "type": "module",
  "scripts": {
    "dev": "pnpm db:generate && next dev --port 3013",
    "worker:dev": "tsx watch worker/index.ts",
    "worker:start": "tsx worker/index.ts",
    "prebuild": "pnpm db:generate",
    "build": "next build",
    "start": "next start --port 3013",
    "postinstall": "prisma generate --schema prisma/schema.prisma",
    "typecheck": "pnpm db:generate && tsc --noEmit",
    "lint": "echo \"Lint skipped for Next.js 16 app; covered by typecheck/build\"",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "e2e": "playwright test",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "dotenv -e ../../.env.local -e ../../.env -- prisma migrate dev --schema prisma/schema.prisma",
    "db:migrate:deploy": "dotenv -e ../../.env.local -e ../../.env -- prisma migrate deploy --schema prisma/schema.prisma",
    "db:studio": "dotenv -e ../../.env.local -e ../../.env -- prisma studio --schema prisma/schema.prisma --port 5558 --browser none",
    "db:seed": "dotenv -e ../../.env.local -e ../../.env -- tsx prisma/seed.ts"
  },
  "dependencies": {
    "@asafarim/auth": "workspace:*",
    "@asafarim/storage": "workspace:*",
    "@asafarim/theme-toggle": "workspace:*",
    "@asafarim/ui": "workspace:*",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "@prisma/client-runtime-utils": "7.8.0",
    "bullmq": "^5.34.0",
    "dotenv": "^17.4.2",
    "ioredis": "^5.4.2",
    "next": "^16.2.10",
    "pino": "^9.6.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@asafarim/config": "workspace:*",
    "@playwright/test": "^1.49.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "dotenv-cli": "^7.4.2",
    "prisma": "7.8.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  }
}
