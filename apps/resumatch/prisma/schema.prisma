// ResuMatch — dedicated database schema.
//
// ResuMatch deliberately does NOT use the shared platform Prisma schema
// (packages/db). CV-derived data needs a stricter access boundary than
// identity traffic. This schema therefore lives on its own PostgreSQL
// instance (local port 55437) with its own credentials.
//
// Identity stays in the platform: ResuMatch stores an OPAQUE authenticated
// user id (the platform user id string) and never duplicates the platform
// User table, so there is no second place a candidate's identity can drift
// or leak from.
//
// ResuMatch pivoted from an earlier job-board-aggregation product
// (JobMatch): rather than ingesting postings from external sources and
// matching a candidate against them, it fetches the single job URL a
// candidate pastes and uses AI to tailor their existing CV to it. The
// ingestion/matching models that product used are gone; only the candidate
// document/profile pipeline and the AI provider boundary carried over.

generator client {
  provider      = "prisma-client-js"
  // Generated into the app rather than node_modules/@prisma/client: pnpm
  // symlinks that path to the shared store, where the PLATFORM client
  // already lives. Two schemas, two clients, no clobbering.
  output        = "../lib/db/generated"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

/// A candidate's ResuMatch workspace, keyed by the opaque platform user id.
/// Holds no name, email, or other platform profile data — those are read
/// from the session at request time and never persisted here.
model Workspace {
  id String @id @default(cuid())

  /// Opaque platform user id (Auth.js `session.user.id`). Unique: one
  /// workspace per authenticated user.
  platformUserId String @unique

  /// Per-workspace monthly AI budget in USD (issue #514). Null = no
  /// override: the Admin `resumatch.aiMonthlyBudgetUsd` setting, else
  /// `RESUMATCH_AI_MONTHLY_BUDGET_USD`, applies exactly as before. Zero is
  /// a valid override and freezes this workspace's AI spend. Set by an
  /// operator through /api/internal/workspace-ai-budget, never by the
  /// candidate. See lib/tailoring/ai/quota.ts.
  aiMonthlyBudgetUsd Decimal? @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditEvents     AuditEvent[]
  documents       CandidateDocument[]
  profile         CandidateProfile?
  targetJobs      TargetJob[]
  tailoredResumes TailoredResume[]
  applications    Application[]
  coverLetters    CoverLetter[]
  tailorPreviews  TailorPreview[]
  aiCostEvents    AiCostEvent[]
  profilePhoto    ProfilePhoto?
  documentPdfs    DocumentPdf[]
  emailDrafts     ApplicationEmailDraft[]
  sentEmails      SentApplicationEmail[]
  evidence        CandidateEvidence[]
  contactPreferences ContactPreferences?
  writingPreferenceRevisions WritingPreferenceRevision[]
  tailoringFeedback TailoringFeedback[]
  tailorDrafts    TailorDraft[]
  applicationEvents ApplicationEvent[]
  applicationEventAttachments ApplicationEventAttachment[]

  @@map("workspaces")
}

/// Append-only record of consequential actions inside a workspace.
///
/// M1 seeds the table and the write path so that every later milestone has
/// somewhere to record data-rights actions (JM-023) and connector runs
/// (JM-031) from day one. `metadata` is a redacted, allow-listed JSON blob:
/// CV text, extracted personal data, and secrets must never reach it.
model AuditEvent {
  id String @id @default(cuid())

  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  /// Stable dotted action name, e.g. "workspace.created".
  action String

  /// Redacted, allow-listed structured context. Never raw documents.
  metadata Json?

  createdAt DateTime @default(now())

  @@index([workspaceId, createdAt])
  @@index([action, createdAt])
  @@map("audit_events")
}

// ─── M2: candidate profile and CV pipeline ──────────────────────────────
//
// The organising rule for everything below: a document is untrusted until
// proven otherwise, and derived data is always traceable back to the exact
// document and parser version that produced it.
//
// Deliberately absent: any field that could hold or infer a protected
// attribute (age, gender, nationality, ethnicity, religion, health,
// disability, family status). A CV routinely contains these; ResuMatch's
// extraction contract drops them rather than storing them, so there is no
// column here for one to land in. See lib/profile/contract.ts.

/// Where an uploaded document is in the scan/extract pipeline. A document
/// moves forward only on evidence; there is no state that means "probably
/// fine".
enum DocumentStatus {
  /// Bytes stored, nothing verified yet. Never read by a parser.
  UPLOADED
  /// Handed to the scanner, awaiting a verdict.
  SCANNING
  /// Scanner said unsafe, or could not say. Terminal without operator action.
  QUARANTINED
  /// Scanned clean; extraction may run.
  CLEAN
  /// Text extraction in progress.
  EXTRACTING
  /// Text extracted and a draft profile produced.
  EXTRACTED
  /// Extraction failed after its retry budget.
  FAILED
}

/// Why a document was quarantined or failed. Stored as a code so the UI can
/// explain it without a parser or scanner message — those can embed file
/// content — reaching the user or the logs.
enum DocumentReasonCode {
  MALWARE_DETECTED
  SCANNER_UNAVAILABLE
  UNSUPPORTED_TYPE
  DECLARED_TYPE_MISMATCH
  FILE_TOO_LARGE
  EMPTY_FILE
  ENCRYPTED_DOCUMENT
  NO_TEXT_LAYER
  EXTRACTION_ERROR
  /// Text was read, but not in reading order — a multi-column or heavily
  /// designed document. Section-derived fields are deliberately left empty
  /// rather than filled from the wrong part of the page.
  LAYOUT_UNRELIABLE
  /// The row's stored-object key could not be read back during a rescan —
  /// the object is gone or the storage backend errored. Never left as
  /// SCANNING: that status is not eligible for another rescan attempt, so
  /// the document would otherwise be permanently stuck. Re-uploading is the
  /// only recovery, since rescanning cannot recreate missing bytes.
  BYTES_MISSING
}

/// An uploaded CV. The bytes live in private object storage; this row holds
/// only metadata and the audit trail.
model CandidateDocument {
  id String @id @default(cuid())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  /// Object-storage key. Always prefixed with the workspace id so a key
  /// cannot be guessed across tenants, and never exposed to the client.
  storageKey String @unique

  /// The user's own filename, kept for display only. Never used to build a
  /// storage key or a filesystem path.
  originalFilename String

  /// Content type as *sniffed from the bytes*, not as declared by the
  /// browser. See lib/documents/fileType.ts.
  contentType String
  byteSize    Int

  /// SHA-256 of the stored bytes — the anchor that makes a profile version
  /// reproducible, and the way a re-upload of the same CV is recognised.
  contentHash String

  status     DocumentStatus     @default(UPLOADED)
  reasonCode DocumentReasonCode?

  /// Scanner name and verdict time, so a stale "clean" is visible as stale.
  scannerName String?
  scannedAt   DateTime?

  /// Retry accounting for extraction. Bounded so a malformed document
  /// cannot be retried forever.
  extractionAttempts Int       @default(0)
  extractionStartedAt DateTime?

  /// When the stored bytes become eligible for deletion (JM-017 retention).
  retainUntil DateTime?

  uploadedAt DateTime  @default(now())
  deletedAt  DateTime?

  profileVersions CandidateProfileVersion[]

  @@index([workspaceId, uploadedAt])
  @@index([workspaceId, status])
  @@index([workspaceId, contentHash])
  @@map("candidate_documents")
}

/// The candidate's current profile pointer. One per workspace. Holds no
/// profile data itself — the data lives in immutable versions, and this row
/// only records which version is in force.
model CandidateProfile {
  id String @id @default(cuid())

  workspaceId String    @unique
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  /// The version the candidate has confirmed. Null until they confirm one:
  /// matching must never run on unreviewed extraction output.
  confirmedVersionId String?                  @unique
  confirmedVersion   CandidateProfileVersion? @relation("ConfirmedVersion", fields: [confirmedVersionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions CandidateProfileVersion[] @relation("ProfileVersions")

  @@map("candidate_profiles")
}

/// How a version's content came to exist.
enum ProfileVersionOrigin {
  /// Produced by the extraction pipeline from a document.
  EXTRACTED
  /// The candidate's corrections applied on top of an extracted version.
  CORRECTED
  /// Typed in by the candidate with no document at all.
  MANUAL
}

/// An immutable snapshot of a candidate profile.
///
/// Rows here are never updated after creation — a correction creates a new
/// version pointing at its parent. That is what makes a past match
/// explainable: the exact profile that produced it still exists, alongside
/// the document hash and parser version that produced *it*.
model CandidateProfileVersion {
  id String @id @default(cuid())

  profileId String
  profile   CandidateProfile @relation("ProfileVersions", fields: [profileId], references: [id], onDelete: Cascade)

  /// Monotonic per profile, so a version has a human-quotable reference
  /// ("v3") as well as an id.
  versionNumber Int

  origin ProfileVersionOrigin

  /// The version this one corrects, if any. Null for the first version.
  parentVersionId String?
  parentVersion   CandidateProfileVersion?  @relation("VersionLineage", fields: [parentVersionId], references: [id], onDelete: SetNull)
  children        CandidateProfileVersion[] @relation("VersionLineage")

  /// The document this was extracted from. Null for MANUAL versions.
  documentId String?
  document   CandidateDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  /// Copied from the document rather than joined, so the provenance survives
  /// the document's deletion under a retention or erasure request.
  sourceContentHash String?

  /// Which code produced this content. A profile extracted by parser v1 and
  /// one extracted by v2 are not comparable, and pretending otherwise is how
  /// a matching regression becomes invisible.
  extractorName    String
  extractorVersion String

  /// Schema-validated profile content (lib/profile/contract.ts). Stored as
  /// JSON so the contract can gain fields without a migration per field,
  /// and validated on read as well as on write.
  content Json

  /// Per-field extraction confidence, same key shape as `content`. Drives
  /// the "check this" markers in the review UI.
  confidence Json?

  createdAt DateTime @default(now())

  confirmedFor CandidateProfile? @relation("ConfirmedVersion")

  tailoredResumes TailoredResume[]
  coverLetters    CoverLetter[]

  @@unique([profileId, versionNumber])
  @@index([profileId, createdAt])
  @@map("candidate_profile_versions")
}

// ─── M3: single-URL job tailoring target ────────────────────────────────
//
// ResuMatch does not aggregate or ingest job boards. A candidate pastes one
// job posting URL they intend to apply to; that page is fetched once
// (lib/tailoring/fetchJob.ts), its readable text extracted and redacted the
// same way CV text is, and the result stored here as the tailoring target.
// There is no source registry, no agreement, no sync — just the one page a
// candidate explicitly pointed at.

enum TargetJobStatus {
  /// Fetched and extracted successfully.
  FETCHED
  /// The fetch or extraction failed (unreachable, blocked, no readable text).
  FETCH_FAILED
}

/// One job posting a candidate is tailoring their CV toward.
model TargetJob {
  id String @id @default(cuid())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  /// The URL the candidate pasted. Validated as public HTTPS before fetch —
  /// see lib/tailoring/fetchJob.ts's isPublicHttpsUrl.
  sourceUrl String

  /// Readable text extracted from the page, redacted the same way CV text
  /// is before it ever reaches a prompt. Null when the fetch failed.
  rawText String? @db.Text

  /// Best-effort title/employer read from the page, shown to the candidate
  /// to confirm before an AI call is spent. Both null when extraction
  /// could not identify them, or when the fetch failed outright.
  title    String?
  employer String?

  /// Structured fields from the manual job-details entry form (issue #461,
  /// part of #458) — location, work mode, employment type, salary range,
  /// deadline, responsibilities/requirements/preferred/benefits, contact,
  /// source. Null for every other intake path (fetched URL, pasted text,
  /// pasted email, uploaded file), which only ever produce `rawText`. Kept
  /// as JSON rather than individual columns since it is candidate-typed,
  /// optional-almost-everywhere data with no source to validate it against
  /// — see lib/tailoring/manualJob.ts for the shape.
  structuredFields Json?

  /// The files an uploaded job was read from, in upload order (0.6.18,
  /// lib/tailoring/jobFiles.ts's sourceFileSchema): name, sniffed type,
  /// size and characters read. Names only — the bytes are never stored.
  /// Null for every other intake path and for uploads from before 0.6.18.
  sourceFiles Json?

  /// Fetch-quality signal for a fetched URL (issue #520, see
  /// lib/tailoring/fetchQuality.ts): true when the page cleared the bare
  /// minimum but looks like a cookie wall, loading shell or other thin page.
  /// A warning shown before an AI call is spent, never a block. Null for
  /// rows from before #520, for failed fetches and for the other intake paths.
  fetchLooksIncomplete Boolean?
  /// Stable reason codes behind `fetchLooksIncomplete` (FetchQualityReason).
  /// Empty when the fetch looks complete or was never assessed.
  fetchQualityReasons String[] @default([])

  status TargetJobStatus

  fetchedAt DateTime  @default(now())
  createdAt DateTime  @default(now())

  tailoredResumes TailoredResume[]
  applications    Application[]
  coverLetters    CoverLetter[]
  evidence        CandidateEvidence[]
  draft           TailorDraft?

  @@index([workspaceId, createdAt])
  @@map("target_jobs")
}

// ─── M4: AI-tailored resumes ─────────────────────────────────────────────
//
// The organising rule carried over from the old matching product: structured
// JSON only, re-validated before persistence, and every reproducibility
// field (prompt/model version, degraded flag) recorded alongside the
// content itself — see lib/tailoring/ai/.

/// One AI tailoring result: a candidate's confirmed profile version,
/// rewritten and reprioritized toward one TargetJob.
model TailoredResume {
  id String @id @default(cuid())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  profileVersionId String
  profileVersion   CandidateProfileVersion @relation(fields: [profileVersionId], references: [id], onDelete: Restrict)

  targetJobId String
  targetJob   TargetJob @relation(fields: [targetJobId], references: [id], onDelete: Cascade)

  /// Schema-validated tailored content (lib/tailoring/ai/schema.ts's
  /// tailoredResumeSchema). Employer/dates/degrees are carried over
  /// verbatim from the source profile — never AI-generated — only wording
  /// and ordering are rewritten.
  content Json

  /// Which visual layout to render this with (components/tailoring/templates).
  /// Only one key exists today; kept as a field so a second template is an
  /// additive change, not a schema migration.
  templateKey String

  aiJobId       String?
  promptVersion String
  modelVersion  String
  /// True when this was produced by the degraded fallback (no provider /
  /// retries exhausted / budget out) rather than a real model call.
  degraded      Boolean @default(false)

  /// The candidate's own freeform steering text for this run (issue #431),
  /// e.g. "emphasize my backend work", capped at 1000 chars by the API
  /// route before it ever reaches the prompt. A preference signal only —
  /// see lib/tailoring/ai/prompts.ts's third fenced block — never a source
  /// of fact, so it's safe to keep here purely for provenance/audit even
  /// though it plays no role in re-deriving content.
  instructions String?

  /// The language the generated prose was written in (#641): one of
  /// lib/tailoring/language.ts's OUTPUT_LANGUAGES ("en" | "nl" | "fr" | "de").
  /// Null when no language was applied — a CV made before #641, a degraded
  /// run (profile carried over unchanged), or one where every suggestion
  /// was declined. Templates render null exactly as they always have.
  outputLanguage String?

  /// Whether this CV shows the candidate's profile photo. Null follows
  /// ProfilePhoto.includeByDefault, so a CV only stores a choice the
  /// candidate actually made on it. Rendering only — never part of
  /// `content`, never seen by a model.
  showPhoto Boolean?

  /// How this CV lays out its skills: "grouped" | "columns" | "paragraph"
  /// (lib/tailoring/skillsLayout.ts). Null is the automatic choice (grouped
  /// when the skills fit the categories, else columns). Rendering only.
  skillsLayout String?

  /// The fact-based skills paragraph for the "paragraph" layout, written on
  /// request by lib/tailoring/ai/skillsParagraph and checked before it is
  /// stored: only skills on this CV, no invented numbers or claims. Null
  /// until the candidate asks for one.
  skillsParagraph String?

  /// When the candidate last edited skillsParagraph by hand on the CV
  /// preview (lib/tailoring/ai/skillsParagraph/handEdit.ts). Null while the
  /// paragraph is the AI's checked text; a new AI paragraph clears it.
  /// Rewrite asks before replacing a hand edit. Rendering only.
  skillsParagraphEditedAt DateTime?

  /// What the candidate changed by hand on the review screen
  /// (lib/tailoring/candidateEdits.ts): skills added or removed for this
  /// CV only, and bullets they wrote or rewrote. Already applied to
  /// `content`; kept so "Edit and regenerate" can carry them over. Null on
  /// CVs saved before 0.4.0 or without hand edits.
  candidateEdits Json?

  /// The request context this CV was generated from (#928), copied from
  /// its TailorPreview without the job-text copy. Regenerate reads the
  /// letter tone/length from it. Null on CVs saved before 0.6.0.
  tailoringContext Json?

  createdAt DateTime @default(now())

  applications Application[]
  pdfs         DocumentPdf[]
  /// The cover letter generated alongside this CV in the same
  /// generate-confirm request, if the candidate opted in and approved one
  /// (issue #454). Null is a normal, common state — most tailored CVs
  /// never get a cover letter. See CoverLetter.tailoredResumeId's own
  /// comment for why this pairing needed its own column instead of being
  /// inferred from targetJobId.
  coverLetter CoverLetter?
  /// What the candidate did with each AI suggestion on the review (#932).
  /// Null for CVs saved before 0.6.11, from a legacy preview, or edited in
  /// place (an in-place edit has no preview to compare against).
  feedback    TailoringFeedback?

  @@index([workspaceId, createdAt])
  @@index([targetJobId])
  @@map("tailored_resumes")
}

/// The candidate's optional CV photo (one per workspace). Deliberately
/// outside the versioned profile content: it is never turned into prompt
/// text, never read by tailoring, and only joined in when a CV is rendered.
/// The bytes are a metadata-stripped square JPEG in private storage
/// (lib/profile/photo.ts, lib/profile/photoStore.ts).
model ProfilePhoto {
  id String @id @default(cuid())

  workspaceId String    @unique
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  /// Derived from the workspace id and a random UUID; never exposed.
  storageKey  String @unique
  contentType String
  byteSize    Int
  /// Side of the square, in pixels.
  pixelSize   Int
  contentHash String

  /// "circle" | "square" — how the CV crops it on display.
  shape String @default("circle")
  /// Whether CVs without their own choice show the photo.
  includeByDefault Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("profile_photos")
}

/// One AI-drafted cover letter, reviewed and confirmed the same way a
/// TailoredResume is (issue #454, part of #453's cover-letter tracking
/// issue) — a sibling row, not a field on TailoredResume, since declining
/// the letter is a valid independent outcome: the CV still saves even when
/// the candidate rejects the whole letter draft.
model CoverLetter {
  id String @id @default(cuid())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  profileVersionId String
  profileVersion   CandidateProfileVersion @relation(fields: [profileVersionId], references: [id], onDelete: Restrict)

  targetJobId String
  targetJob   TargetJob @relation(fields: [targetJobId], references: [id], onDelete: Cascade)

  /// The specific TailoredResume this letter was generated alongside, in
  /// the same generate-confirm request. Nullable, not because a letter can
  /// exist without one — generate-confirm always sets it on create — but
  /// because a candidate can re-tailor toward the same job multiple times,
  /// so targetJobId alone can't tell two CVs and a letter apart; without
  /// this column the CV preview page and history lists had no reliable way
  /// to show "this CV has a cover letter" once the URL that carried
  /// coverLetterId as a query param was gone. SetNull rather than Cascade:
  /// deleting the CV a letter was paired with should not silently delete
  /// the candidate's own drafted letter text too.
  tailoredResumeId String?       @unique
  tailoredResume   TailoredResume? @relation(fields: [tailoredResumeId], references: [id], onDelete: SetNull)

  /// Schema-validated content (lib/tailoring/ai/coverLetter/schema.ts).
  /// fullName is carried over from the source profile in code, never taken
  /// from provider output — see that schema's own doc comment.
  content Json

  promptVersion String
  modelVersion  String
  /// True when this was produced by the degraded fallback (no provider /
  /// retries exhausted / budget out) rather than a real model call.
  degraded      Boolean @default(false)
  /// The language the letter was written in (#642), one of
  /// lib/tailoring/language.ts's OUTPUT_LANGUAGES. Null for letters made
  /// before this existed and for degraded ones — nothing was written in a
  /// chosen language, so nothing is claimed.
  outputLanguage String?

  createdAt DateTime @default(now())

  pdfs DocumentPdf[]

  @@index([workspaceId, createdAt])
  @@index([targetJobId])
  @@map("cover_letters")
}

/// The server's own record of a `generate-preview` provider call, and the
/// only thing `generate-confirm` trusts for provenance (issue #525).
///
/// `generate-confirm` used to persist `promptVersion`/`modelVersion`/
/// `degraded` straight from the client's request body — nothing stopped a
/// client from calling confirm directly, skipping the provider call (and
/// its budget spend) entirely, and claiming a real model produced the
/// result. This row is written once, by `generate-preview`, right after the
/// actual provider call(s) it made; `generate-confirm` requires the row's id
/// back, re-derives provenance from it instead of the request body, and
/// consumes it so the same preview cannot back two different confirms.
///
/// A DB row, not a signed token: this app already persists every other
/// piece of short-lived request state this way, and a row avoids adding a
/// signing-key dependency for what is fundamentally a one-time-use claim
/// check, the same shape `CandidateDocument`'s atomic status claim already
/// uses.
model TailorPreview {
  id String @id @default(cuid())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  profileVersionId String
  targetJobId      String

  promptVersion String
  modelVersion  String
  degraded      Boolean

  /// Null when this preview did not include a cover letter (the candidate
  /// never opted in, or the request didn't ask for one) — confirm() then
  /// rejects a `coverLetter` block in the same way it rejects a
  /// `TailorPreview` that never existed.
  coverLetterPromptVersion String?
  coverLetterModelVersion  String?
  coverLetterDegraded      Boolean?
  /// The output language this preview's tailor call was asked for (#641).
  /// generate-confirm copies it onto the TailoredResume from here — the
  /// server's record — never from anything the client echoes back.
  outputLanguage           String?
  /// The language this preview's cover-letter call was asked for (#642).
  /// Null when no letter was requested. Copied onto the CoverLetter by
  /// generate-confirm, only when the letter was actually drafted.
  coverLetterOutputLanguage String?

  /// The server-resolved request context of this run (#928,
  /// lib/tailoring/context.ts): profile version, job, job-text fingerprint
  /// and capped copy, the candidate's note, languages, letter tone/length.
  /// Immutable once written. Null on previews made before 0.6.0, which
  /// confirm exactly as before.
  contextVersion     String?
  context            Json?
  /// sha256 over every output-affecting field of `context`, workspace
  /// included (tailoringContextFingerprint).
  contextFingerprint String?

  /// The CV suggestions exactly as the provider returned them (#932,
  /// tailorSuggestionsSchema), before the candidate touched anything. The
  /// server's own copy: generate-confirm derives the review feedback from
  /// it, never from what the client echoes. Null on a degraded run and on
  /// previews made before 0.6.11.
  suggestions           Json?
  /// The letter suggestion as generated (#932), after the grounding check.
  /// Null when no letter was requested or the call degraded.
  coverLetterSuggestion Json?

  createdAt  DateTime  @default(now())
  /// Set by generate-confirm on first (and only) use. A second confirm
  /// attempt against the same preview is rejected the same way an expired
  /// or unknown one is.
  consumedAt DateTime?

  @@index([workspaceId, createdAt])
  /// #933: the retention sweep reads by age across workspaces.
  @@index([createdAt])
  @@map("tailor_previews")
}

// ─── Per-application tracking (issue #432) ────────────────────────────────
//
// The pivot removed the old tracked-jobs workflow (see M6 below) because it
// was bound to aggregated job-board data. This is its lightweight
// replacement: every row is user-supplied (a TargetJob the candidate
// already created) or derived from a AI call the candidate already
// approved (a TailoredResume) — no ingestion, no scraping, zero licensing
// exposure.

enum ApplicationStatus {
  SAVED
  APPLIED
  INTERVIEWING
  OFFER
  REJECTED
}

/// One job application a candidate is tracking — a status, optional notes,
/// and a link to whichever tailored resume (if any) was used for it.
model Application {
  id String @id @default(cuid())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  targetJobId String
  targetJob   TargetJob @relation(fields: [targetJobId], references: [id], onDelete: Cascade)

  /// Optional: not every application is tied to an AI-tailored resume —
  /// the candidate may have applied with their base profile, or before
  /// this feature existed. Set null (not cascaded) if the tailored resume
  /// is ever removed, since the application record itself should outlive it.
  tailoredResumeId String?
  tailoredResume   TailoredResume? @relation(fields: [tailoredResumeId], references: [id], onDelete: SetNull)

  status ApplicationStatus @default(SAVED)

  /// Candidate's own freeform notes. Never AI-generated, never analyzed.
  notes String? @db.Text

  /// Optional reminder date the candidate set for themselves (e.g. "follow
  /// up if no response by"). Purely informational — nothing sends a
  /// notification from this field yet.
  followUpDate DateTime?

  /// When the candidate applied: set the first time the status becomes
  /// APPLIED, by hand or by a sent application email (lib/applications/
  /// status.ts). `status` stays the one source of truth for "Applied"; this
  /// only records when it happened. Null for rows from before it existed.
  appliedAt DateTime?

  /// The time zone the candidate named for `appliedAt` (an IANA zone such
  /// as "Europe/Brussels"), so it shows as the wall-clock time they typed.
  /// `appliedAt` itself is UTC. Null: shown in the viewer's own zone.
  appliedTimeZone String?

  /// An application submitted outside ResuMatch (Indeed, LinkedIn, the
  /// company's site...), recorded by the candidate. Separate from status
  /// and from email delivery: recording one never writes a
  /// SentApplicationEmail. Null: no external submission recorded. See
  /// lib/applications/timeline/ and internal docs
  /// ventures/resumatch/engineering/application-timeline.md.
  submissionChannel      SubmissionChannel?
  /// The candidate's own name for OTHER ("Jobat", "a recruiter's portal").
  submissionChannelLabel String?
  /// Where they applied. Opening it never changes the application.
  applicationUrl         String?
  /// Confirmation or reference number the site gave them.
  submissionReference    String?
  /// When the external submission was recorded in ResuMatch (record
  /// creation time), apart from when they applied (`appliedAt`).
  submissionRecordedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  emailDraft ApplicationEmailDraft?
  sentEmails SentApplicationEmail[]
  events     ApplicationEvent[]

  @@index([workspaceId, createdAt])
  @@index([workspaceId, status])
  @@map("applications")
}

enum SubmissionChannel {
  INDEED
  LINKEDIN
  COMPANY_WEBSITE
  OTHER
}

/// What one timeline entry records. Status is never implied by the kind:
/// only an explicit `toStatus` changes the application.
enum ApplicationEventKind {
  SUBMITTED
  CONFIRMATION_RECEIVED
  RECRUITER_REPLY
  RESPONSE_SENT
  INTERVIEW
  FOLLOW_UP
  OFFER
  REJECTION
  NOTE
}

enum ApplicationEventOrigin {
  /// Added with "Add update": editable and deletable on the timeline.
  MANUAL
  /// Written by "Mark as applied externally". The SUBMITTED entry is edited
  /// with the submission and removed only by undoing it; a confirmation
  /// recorded with it is an ordinary entry otherwise.
  EXTERNAL_SUBMISSION
}

/// One entry on an application's timeline (application-timeline.md).
/// Entries are separate rows in time order: new correspondence never
/// replaces an earlier message. Emails sent from ResuMatch are not copied
/// here; the timeline reads them from SentApplicationEmail as they are.
model ApplicationEvent {
  id String @id @default(cuid())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  kind   ApplicationEventKind
  origin ApplicationEventOrigin @default(MANUAL)

  /// When it happened, in UTC, and the IANA zone the candidate gave it in.
  occurredAt DateTime
  timeZone   String

  /// The message text or the candidate's summary. Never sent to a model.
  summary   String? @db.Text
  sender    String?
  recipient String?

  nextAction   String?
  /// A follow-up day (UTC midnight, follow-up-dates.md). Saving an entry
  /// with one also sets the application's follow-up date.
  followUpDate DateTime?

  /// The status change the candidate chose with this entry, as it was
  /// applied. Both null: the entry changed nothing.
  fromStatus ApplicationStatus?
  toStatus   ApplicationStatus?

  /// `<workspaceId>:<client key>`: a repeated Save finds this row instead
  /// of adding a second one.
  idempotencyKey String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attachments ApplicationEventAttachment[]

  @@index([applicationId, occurredAt])
  @@index([workspaceId])
  @@map("application_events")
}

enum ApplicationAttachmentKind {
  IMAGE
  PDF
  EMAIL
}

/// A screenshot, PDF or saved email (.eml) kept with one timeline entry.
/// Private: the key is derived, the object is private, the bytes are
/// streamed only to the owning workspace. Rows are deleted only after the
/// bytes are verified gone.
model ApplicationEventAttachment {
  id String @id @default(cuid())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  eventId String
  event   ApplicationEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  kind ApplicationAttachmentKind
  /// Sniffed from the bytes, never the browser's claim.
  contentType String
  /// Display only; never part of the storage key.
  filename    String
  byteSize    Int
  contentHash String
  storageKey  String @unique

  /// For an .eml: headers and plain text read once at upload
  /// (lib/applications/timeline/eml.ts). Shown as text, never as HTML.
  emailPreview Json?

  createdAt DateTime @default(now())

  @@unique([eventId, contentHash])
  @@index([workspaceId])
  @@map("application_event_attachments")
}

// ─── Send application by email ────────────────────────────────────────────
//
// See lib/applicationEmail/ and internal docs
// ventures/resumatch/engineering/send-application.md. Three rules:
// a sent email is a snapshot that never changes; it points at the exact
// PDFs that went out, which never change either; and only the provider's
// acceptance moves an application from Saved to Applied.

enum DocumentPdfKind {
  CV
  COVER_LETTER
}

/// A PDF of a CV or cover letter, rendered on the server from the same page
/// the candidate prints (lib/documentPdfs/). Immutable: a later change to
/// the CV makes a new row, never a new version of this one. UPDATE is
/// rejected by a trigger except for the two SetNull links.
model DocumentPdf {
  id String @id @default(cuid())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  kind DocumentPdfKind

  /// The CV (kind CV) or letter (kind COVER_LETTER) this was rendered from.
  /// SetNull so a PDF that was sent outlives its source document.
  tailoredResumeId String?
  tailoredResume   TailoredResume? @relation(fields: [tailoredResumeId], references: [id], onDelete: SetNull)
  coverLetterId    String?
  coverLetter      CoverLetter?    @relation(fields: [coverLetterId], references: [id], onDelete: SetNull)

  /// Plain column, not a FK, like AiCostEvent.targetJobId.
  targetJobId String

  /// sha256 of the stored inputs that shape the rendered document
  /// (lib/documentPdfs/fingerprint.ts). A different fingerprint on the
  /// source now means the document changed after this PDF was made.
  sourceFingerprint String

  /// Derived from the workspace id and a random UUID; never exposed.
  storageKey  String @unique
  filename    String
  byteSize    Int
  contentHash String

  createdAt DateTime @default(now())

  draftsAsCv          ApplicationEmailDraft[]      @relation("DraftCvPdf")
  draftsAsCoverLetter ApplicationEmailDraft[]      @relation("DraftCoverLetterPdf")
  sentAttachments     SentApplicationAttachment[]

  @@index([workspaceId, tailoredResumeId, createdAt])
  @@index([workspaceId, coverLetterId, createdAt])
  @@map("document_pdfs")
}

/// The candidate's unsent email for one application. Editable and saved
/// on request; sending copies it into a SentApplicationEmail and leaves it
/// here, so a failed send never loses a word.
model ApplicationEmailDraft {
  id String @id @default(cuid())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  applicationId String      @unique
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  /// The first recipient; the contact name belongs to it.
  toEmail     String?
  /// Up to two more "To" recipients (#944), in the order typed. Empty for
  /// a one-recipient draft, so older drafts read unchanged.
  additionalToEmails String[] @default([])
  contactName String?
  subject     String?
  body        String? @db.Text

  /// True once the candidate changed the AI's text by hand, so a
  /// regenerate asks before replacing it.
  subjectEdited Boolean @default(false)
  bodyEdited    Boolean @default(false)

  /// Bcc the candidate's own account address.
  sendCopyToSelf Boolean @default(true)

  /// Contact preferences for this email (#940): the saved defaults, values
  /// just for this email (contactOverride), or none.
  contactMode     ContactMode @default(DEFAULT)
  contactOverride Json?
  /// The contact paragraph this body holds, exactly as it was placed, so
  /// a reopened draft can still swap or remove it after the saved
  /// defaults change. Null: the body holds none.
  contactParagraph String?

  /// The exact PDFs this draft attaches. Pinned, never swapped for newer
  /// ones without the candidate choosing to.
  cvPdfId          String?
  cvPdf            DocumentPdf? @relation("DraftCvPdf", fields: [cvPdfId], references: [id], onDelete: SetNull)
  coverLetterPdfId String?
  coverLetterPdf   DocumentPdf? @relation("DraftCoverLetterPdf", fields: [coverLetterPdfId], references: [id], onDelete: SetNull)

  /// Optimistic concurrency: a save names the version it edited.
  version Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@map("application_email_drafts")
}

enum SentEmailStatus {
  /// Written before the provider call. Still SENDING after a few minutes
  /// means the outcome was never recorded: shown as unconfirmed.
  SENDING
  /// The provider accepted the message. Not proof of inbox delivery.
  ACCEPTED
  /// The provider refused it, or it never left: nothing was sent.
  FAILED
  /// The connection broke after the message may have been handed over.
  /// Never resent automatically.
  UNCERTAIN
}

/// One email sent (or attempted) for an application. The content columns
/// are a snapshot taken before the send and never change: a trigger
/// rejects any UPDATE to them (see the migration). Only the outcome and
/// delivery columns move.
model SentApplicationEmail {
  /// The sentId shown to the candidate.
  id String @id @default(cuid())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  /// `<workspaceId>:<client key>`: the same send intent, retried, finds
  /// this row instead of sending twice.
  idempotencyKey String @unique

  targetJobId String
  /// Normalized company name (lib/applicationEmail/normalize.ts), the
  /// filter key for "everything sent to this company".
  companyKey  String
  companyName String
  jobTitle    String?

  contactName            String?
  contactEmail           String
  /// Lower-cased, trimmed: the filter key for "everything sent to them".
  contactEmailNormalized String
  /// The other "To" recipients of the same message (#944), in order. The
  /// first stays in contactEmail, so a one-recipient email reads as before.
  additionalRecipients String[] @default([])
  /// Every recipient, lower-cased: the filter key for "everything sent to
  /// them" whichever position they had. Derived by an insert trigger from
  /// contactEmailNormalized and additionalRecipients; backfilled for older
  /// rows.
  recipientsNormalized String[] @default([])
  /// Recipients the mail server refused while it accepted the message for
  /// the others. Set once, with the outcome; never part of the snapshot.
  rejectedRecipients String[] @default([])

  /// Exactly as used: the verified sender, the Reply-To and the Bcc copy.
  fromAddress String
  replyTo     String?
  bccSelf     String?

  subject String
  body    String @db.Text
  /// RFC 5322 Message-ID header, built from this row's id.
  messageId String @unique

  status SentEmailStatus @default(SENDING)
  /// Provider response line, without message content, at most 300 chars.
  providerResponse  String?
  providerMessageId String?
  /// A stable code (lib/applicationEmail/mailer.ts), never a message.
  errorCode String?

  /// not_tracked | delivered | bounced | complained. SMTP reports nothing
  /// after acceptance, so this stays not_tracked unless a provider webhook
  /// is added; it is updated separately from the snapshot.
  deliveryStatus    String    @default("not_tracked")
  deliveryUpdatedAt DateTime?

  /// The application's submission time once this email was accepted (its
  /// appliedAt, which this email may have set), and the status change it
  /// made, e.g. "SAVED->APPLIED" or "INTERVIEWING (unchanged)".
  appliedAt        DateTime?
  statusTransition String?

  attemptedAt DateTime  @default(now())
  /// When the provider accepted it.
  sentAt      DateTime?

  attachments SentApplicationAttachment[]

  @@index([workspaceId, attemptedAt])
  @@index([workspaceId, companyKey])
  @@index([workspaceId, contactEmailNormalized])
  @@index([recipientsNormalized], type: Gin)
  @@index([applicationId, attemptedAt])
  @@map("sent_application_emails")
}

/// The PDFs one sent email carried, with the hash of the exact bytes.
/// Insert-only.
model SentApplicationAttachment {
  id String @id @default(cuid())

  sentEmailId String
  sentEmail   SentApplicationEmail @relation(fields: [sentEmailId], references: [id], onDelete: Cascade)

  documentPdfId String
  documentPdf   DocumentPdf @relation(fields: [documentPdfId], references: [id], onDelete: NoAction)

  kind        DocumentPdfKind
  filename    String
  contentHash String
  byteSize    Int

  @@unique([sentEmailId, kind])
  @@index([documentPdfId])
  @@map("sent_application_attachments")
}

// ─────────────────────────────────────────────────────────────────────────
// Model/prompt/budget controls & honest degraded mode
// ─────────────────────────────────────────────────────────────────────────

/// Append-only spend ledger for ResuMatch's AI provider calls. Mirrors
/// apps/tasks-ai/lib/ai/quota.ts's AiUsageLedger (see that schema's own
/// AiUsageLedger model), adapted to ResuMatch's isolated schema.
model AiUsageLedger {
  id          String   @id @default(cuid())
  workspaceId String
  /// One row per provider call — `tailor | extract | rewrite | fetch_job |
  /// cover_letter | categorize_skills | skills_paragraph | job_meta`. See lib/tailoring/ai/quota.ts.
  kind        String
  provider    String
  model       String
  promptVersion String?
  inputTokens Int      @default(0)
  outputTokens Int     @default(0)
  costUsd     Float    @default(0)
  createdAt   DateTime @default(now())

  @@index([workspaceId, createdAt])
  @@map("ai_usage_ledger")
}

/// One row per provider call that reached the shared runtime
/// (lib/ai/runProviderCall.ts, issue #512): success, degrade or hard
/// failure. Kept apart from AiUsageLedger / AiCostEvent so the spend ledgers
/// stay success-only and "did this call succeed cleanly" is queryable on its
/// own. Operational metadata only: never a prompt, response, CV text or
/// error message.
model AiCallOutcome {
  id           String   @id @default(cuid())
  workspaceId  String
  /// `ProviderCallKind`, as in AiUsageLedger.kind.
  kind         String
  /// `success | budget_refused | budget_check_failed | prepare_failed |
  /// non_retryable | exhausted | attempt_hook_failed`. See lib/ai/callOutcome.ts.
  outcome      String
  /// Provider attempts made; 0 when the call ended before the first one.
  attempts     Int
  degraded     Boolean
  /// Always false until a fallback provider exists (#511).
  usedFallback Boolean  @default(false)
  /// A stable error class or code (never a message), null on success.
  errorCode    String?
  createdAt    DateTime @default(now())

  @@index([kind, createdAt])
  @@index([workspaceId, createdAt])
  @@map("ai_call_outcomes")
}

// ─── AI cost ledger (milestone #31, issue #586) ───────────────────────────
//
// Implements the platform AI cost-event contract (@asafarim/ai-cost-ledger,
// docs/adr/0003-ai-cost-event-contract.md) inside this isolated database.
// Supersedes AiUsageLedger for new writes; legacy rows stay where they are
// and are read as "legacy / unattributed" history (lib/costs/read.ts) and
// still count toward the monthly budget (lib/tailoring/ai/quota.ts).

/// One immutable row per metered provider call, attributed at call time to
/// the most specific durable entity it served. UPDATE is rejected by a
/// database trigger (see the migration); corrections are new `adjustment`
/// rows pointing at `supersedesEventId`. Operational metadata only — no
/// CV text, job text, prompt, response or secret ever lands here.
model AiCostEvent {
  id             String   @id @default(cuid())
  /// `resumatch:<operation>:<provider request id | call id>`. Unique, so a
  /// retried write is a no-op (insert with skipDuplicates).
  idempotencyKey String   @unique
  schemaVersion  Int      @default(1)
  /// usage | adjustment
  entryType      String   @default("usage")

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Opaque platform user id of the candidate who triggered the call.
  actorId     String?

  /// tailor | extract | rewrite | fetch_job | cover_letter | categorize_skills | skills_paragraph | job_meta
  operation String
  /// succeeded | degraded | failed | cancelled
  outcome   String @default("succeeded")
  /// provisional | final
  finality  String @default("provisional")

  /// target_job | tailor_preview | tailored_resume | candidate_document | candidate_profile
  subjectType       String
  subjectId         String
  parentSubjectType String?
  parentSubjectId   String?
  /// Denormalized job link for job/application subtotals. Plain column, not
  /// a FK: deleting a job must not delete the record that money was spent.
  /// An Application resolves through its own targetJobId at read time, so
  /// an application saved after generation never rewrites an old event.
  targetJobId       String?
  /// Groups separate line items of one user action (tailor + cover letter
  /// in one preview share the preview id).
  workflowId        String?
  traceId           String?

  provider          String
  requestModel      String?
  responseModel     String
  providerRequestId String?
  promptVersion     String?
  pricingTier       String?

  /// Exclusive usage buckets: [{ bucket, unit, quantity }].
  usage        Json    @default("[]")
  /// Σ input-side / output-side token buckets, denormalized for cheap sums.
  inputTokens  Int     @default(0)
  outputTokens Int     @default(0)

  currency              String  @default("USD")
  /// Integer USD micros. null = unknown — never a placeholder 0.
  estimatedCostMicros   BigInt?
  actualCostMicros      BigInt?
  adjustmentDeltaMicros BigInt?
  /// provider_reported | registry_estimate | reconciled_adjustment | unknown
  costSource            String
  /// platform | user_byok | none
  credentialSource      String
  pricingSnapshot       Json?
  fixture               Boolean @default(false)

  supersedesEventId String?
  latencyMs         Int?
  metadata          Json    @default("{}")

  occurredAt  DateTime
  finalizedAt DateTime?
  recordedAt  DateTime @default(now())

  @@index([workspaceId, occurredAt(sort: Desc), id(sort: Desc)])
  @@index([workspaceId, targetJobId])
  @@index([workspaceId, workflowId])
  @@map("ai_cost_events")
}

// ─── #929: confirmed background evidence ────────────────────────────────
//
// Projects, achievements and responsibilities the candidate types in, plus
// their motivation for a job, kept apart from the profile. Only a
// CONFIRMED latest revision can reach a prompt (lib/evidence/store.ts).
// See internal docs ventures/resumatch/engineering/background-evidence.md.

enum EvidenceKind {
  /// Professional facts: may support CV and letter wording.
  PROJECT
  ACHIEVEMENT
  RESPONSIBILITY
  /// Why the candidate wants a job. Letter only, never a fact.
  MOTIVATION
}

enum EvidenceScope {
  /// Used only for `targetJobId`. The default.
  APPLICATION
  /// Confirmed background, used for every application.
  BACKGROUND
}

enum EvidenceStatus {
  /// Saved but not confirmed: never used in generation.
  DRAFT
  CONFIRMED
}

/// One evidence item, stable across edits. The content lives in immutable
/// revisions; this row holds only where the item applies.
model CandidateEvidence {
  id String @id @default(cuid())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  scope       EvidenceScope
  /// Set for APPLICATION scope, null for BACKGROUND.
  targetJobId String?
  targetJob   TargetJob?    @relation(fields: [targetJobId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  revisions CandidateEvidenceRevision[]

  @@index([workspaceId, scope])
  @@index([workspaceId, targetJobId])
  @@map("candidate_evidence")
}

/// An immutable revision of an evidence item. Editing creates a new one;
/// a saved CV names the revision ids it used (TailoringContext), so its
/// lineage never shifts. The only change a row ever sees is DRAFT →
/// CONFIRMED on the item's latest revision.
model CandidateEvidenceRevision {
  id String @id @default(cuid())

  evidenceId String
  evidence   CandidateEvidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  /// Copied from the item, so every lookup can be workspace-scoped.
  workspaceId String

  /// 1, 2, 3… per item. The highest is the item's current content.
  revisionNumber Int

  kind   EvidenceKind
  title  String
  detail String       @db.Text
  /// Optional source reference to a role in the profile:
  /// { title, employer, startedOn } (lib/evidence/contract.ts). Null: the
  /// item belongs to no single role.
  experienceRef Json?

  status      EvidenceStatus @default(DRAFT)
  confirmedAt DateTime?

  createdAt DateTime @default(now())

  @@unique([evidenceId, revisionNumber])
  @@index([workspaceId])
  @@map("candidate_evidence_revisions")
}

enum ContactMode {
  DEFAULT
  OVERRIDE
  OMIT
}

/// When and how the candidate likes to be contacted (#940). One row per
/// workspace; `content` is the ContactPreferences shape in
/// lib/contactPreferences/contract.ts, read leniently. The email composer
/// turns it into one paragraph in code; it is never sent to an AI provider.
model ContactPreferences {
  id String @id @default(cuid())

  workspaceId String    @unique
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  content Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("contact_preferences")
}

/// Saved writing preferences (#931): the candidate's reusable defaults for
/// tone, length, languages and a short style note, per artifact. One
/// immutable row per save; the highest `revisionNumber` is the current
/// preferences, and a reset is a save of empty content. A tailoring run
/// names the revision it used (`TailoringContext.preferenceRevisionId`) and
/// keeps the resolved values in its own snapshot, so a later save never
/// changes an existing preview or CV. `content` is the WritingPreferences
/// shape in lib/writingPreferences/contract.ts, read leniently.
model WritingPreferenceRevision {
  id String @id @default(cuid())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  /// 1, 2, 3… per workspace. Unique, so two saves from the same base
  /// cannot both land: the second one is refused as stale.
  revisionNumber Int

  content Json

  createdAt DateTime @default(now())

  @@unique([workspaceId, revisionNumber])
  @@map("writing_preference_revisions")
}

/// Review feedback for one saved CV (#932): the original AI suggestions,
/// what the candidate did with each (accepted, edited, rejected, with an
/// optional reason code) and anything they explicitly chose to remember.
/// Written once, with the CV, by generate-confirm; one row per preview and
/// per CV, so a retried or repeated confirm can never add a second record
/// or promote anything twice. Deleted with its CV. Never sent to an AI
/// provider and never used to train anything.
model TailoringFeedback {
  id String @id @default(cuid())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  tailoredResumeId String         @unique
  tailoredResume   TailoredResume @relation(fields: [tailoredResumeId], references: [id], onDelete: Cascade)

  /// The preview the suggestions came from. Unique: one record per preview.
  previewId String @unique

  feedbackVersion String
  /// { cv, coverLetter }: the suggestions as generated, copied from the
  /// preview (lib/tailoring/feedback.ts's OriginalSuggestions), with the
  /// prompt and model versions that wrote them.
  original  Json
  /// FeedbackItem[]: one per suggested field.
  decisions Json
  /// What the candidate explicitly chose to remember on this save and how
  /// it went: { preference, background[] } (lib/tailoring/feedbackScope.ts).
  /// Null when they kept everything to this application.
  promotions Json?

  createdAt DateTime @default(now())

  @@index([workspaceId, createdAt])
  /// #933: the retention sweep reads by age across workspaces.
  @@index([createdAt])
  @@map("tailoring_feedback")
}

/// An unfinished Tailor run, saved on the server so a candidate can leave
/// /tailor (or reload) and come back to it (lib/tailoring/drafts). One per
/// job: it is opened when a job lands (fetched, pasted, uploaded or typed
/// in), updated as the candidate fills in the options card and the review,
/// and deleted when the CV is saved or the candidate discards it. The job
/// itself (`target_jobs`) is never refetched to resume.
///
/// Holds the candidate's own text (the note, review edits) and a copy of
/// the AI suggestions under review, so it is exported, erased with the
/// workspace, and deleted `DRAFT_RETENTION_DAYS` after its last change.
model TailorDraft {
  id String @id @default(cuid())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  targetJobId String    @unique
  targetJob   TargetJob @relation(fields: [targetJobId], references: [id], onDelete: Cascade)

  /// "options" (the card under the job) or "review" (suggestions to check).
  step String @default("options")
  /// The options card's choices (draftOptionsSchema). Null until changed.
  options Json?
  /// The preview the review belongs to. Resuming a review whose preview is
  /// gone or already used falls back to the options card.
  previewId String?
  /// The review as the candidate left it (client shape, size-capped). Null
  /// on the options step.
  review Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId, updatedAt])
  /// Retention sweep reads by age across workspaces.
  @@index([updatedAt])
  @@map("tailor_drafts")
}
