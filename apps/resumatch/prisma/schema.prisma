// ResuMatch — dedicated database schema.
//
// ResuMatch deliberately does NOT use the shared platform Prisma schema
// (packages/db). CV-derived data needs a stricter access boundary than
// identity traffic. This schema therefore lives on its own PostgreSQL
// instance (local port 55437) with its own credentials.
//
// Identity stays in the platform: ResuMatch stores an OPAQUE authenticated
// user id (the platform user id string) and never duplicates the platform
// User table, so there is no second place a candidate's identity can drift
// or leak from.
//
// ResuMatch pivoted from an earlier job-board-aggregation product
// (JobMatch): rather than ingesting postings from external sources and
// matching a candidate against them, it fetches the single job URL a
// candidate pastes and uses AI to tailor their existing CV to it. The
// ingestion/matching models that product used are gone; only the candidate
// document/profile pipeline and the AI provider boundary carried over.

generator client {
  provider      = "prisma-client-js"
  // Generated into the app rather than node_modules/@prisma/client: pnpm
  // symlinks that path to the shared store, where the PLATFORM client
  // already lives. Two schemas, two clients, no clobbering.
  output        = "../lib/db/generated"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

/// A candidate's ResuMatch workspace, keyed by the opaque platform user id.
/// Holds no name, email, or other platform profile data — those are read
/// from the session at request time and never persisted here.
model Workspace {
  id String @id @default(cuid())

  /// Opaque platform user id (Auth.js `session.user.id`). Unique: one
  /// workspace per authenticated user.
  platformUserId String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditEvents     AuditEvent[]
  documents       CandidateDocument[]
  profile         CandidateProfile?
  targetJobs      TargetJob[]
  tailoredResumes TailoredResume[]
  applications    Application[]
  coverLetters    CoverLetter[]
  tailorPreviews  TailorPreview[]
  aiCostEvents    AiCostEvent[]

  @@map("workspaces")
}

/// Append-only record of consequential actions inside a workspace.
///
/// M1 seeds the table and the write path so that every later milestone has
/// somewhere to record data-rights actions (JM-023) and connector runs
/// (JM-031) from day one. `metadata` is a redacted, allow-listed JSON blob:
/// CV text, extracted personal data, and secrets must never reach it.
model AuditEvent {
  id String @id @default(cuid())

  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  /// Stable dotted action name, e.g. "workspace.created".
  action String

  /// Redacted, allow-listed structured context. Never raw documents.
  metadata Json?

  createdAt DateTime @default(now())

  @@index([workspaceId, createdAt])
  @@index([action, createdAt])
  @@map("audit_events")
}

// ─── M2: candidate profile and CV pipeline ──────────────────────────────
//
// The organising rule for everything below: a document is untrusted until
// proven otherwise, and derived data is always traceable back to the exact
// document and parser version that produced it.
//
// Deliberately absent: any field that could hold or infer a protected
// attribute (age, gender, nationality, ethnicity, religion, health,
// disability, family status). A CV routinely contains these; ResuMatch's
// extraction contract drops them rather than storing them, so there is no
// column here for one to land in. See lib/profile/contract.ts.

/// Where an uploaded document is in the scan/extract pipeline. A document
/// moves forward only on evidence; there is no state that means "probably
/// fine".
enum DocumentStatus {
  /// Bytes stored, nothing verified yet. Never read by a parser.
  UPLOADED
  /// Handed to the scanner, awaiting a verdict.
  SCANNING
  /// Scanner said unsafe, or could not say. Terminal without operator action.
  QUARANTINED
  /// Scanned clean; extraction may run.
  CLEAN
  /// Text extraction in progress.
  EXTRACTING
  /// Text extracted and a draft profile produced.
  EXTRACTED
  /// Extraction failed after its retry budget.
  FAILED
}

/// Why a document was quarantined or failed. Stored as a code so the UI can
/// explain it without a parser or scanner message — those can embed file
/// content — reaching the user or the logs.
enum DocumentReasonCode {
  MALWARE_DETECTED
  SCANNER_UNAVAILABLE
  UNSUPPORTED_TYPE
  DECLARED_TYPE_MISMATCH
  FILE_TOO_LARGE
  EMPTY_FILE
  ENCRYPTED_DOCUMENT
  NO_TEXT_LAYER
  EXTRACTION_ERROR
  /// Text was read, but not in reading order — a multi-column or heavily
  /// designed document. Section-derived fields are deliberately left empty
  /// rather than filled from the wrong part of the page.
  LAYOUT_UNRELIABLE
  /// The row's stored-object key could not be read back during a rescan —
  /// the object is gone or the storage backend errored. Never left as
  /// SCANNING: that status is not eligible for another rescan attempt, so
  /// the document would otherwise be permanently stuck. Re-uploading is the
  /// only recovery, since rescanning cannot recreate missing bytes.
  BYTES_MISSING
}

/// An uploaded CV. The bytes live in private object storage; this row holds
/// only metadata and the audit trail.
model CandidateDocument {
  id String @id @default(cuid())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  /// Object-storage key. Always prefixed with the workspace id so a key
  /// cannot be guessed across tenants, and never exposed to the client.
  storageKey String @unique

  /// The user's own filename, kept for display only. Never used to build a
  /// storage key or a filesystem path.
  originalFilename String

  /// Content type as *sniffed from the bytes*, not as declared by the
  /// browser. See lib/documents/fileType.ts.
  contentType String
  byteSize    Int

  /// SHA-256 of the stored bytes — the anchor that makes a profile version
  /// reproducible, and the way a re-upload of the same CV is recognised.
  contentHash String

  status     DocumentStatus     @default(UPLOADED)
  reasonCode DocumentReasonCode?

  /// Scanner name and verdict time, so a stale "clean" is visible as stale.
  scannerName String?
  scannedAt   DateTime?

  /// Retry accounting for extraction. Bounded so a malformed document
  /// cannot be retried forever.
  extractionAttempts Int       @default(0)
  extractionStartedAt DateTime?

  /// When the stored bytes become eligible for deletion (JM-017 retention).
  retainUntil DateTime?

  uploadedAt DateTime  @default(now())
  deletedAt  DateTime?

  profileVersions CandidateProfileVersion[]

  @@index([workspaceId, uploadedAt])
  @@index([workspaceId, status])
  @@index([workspaceId, contentHash])
  @@map("candidate_documents")
}

/// The candidate's current profile pointer. One per workspace. Holds no
/// profile data itself — the data lives in immutable versions, and this row
/// only records which version is in force.
model CandidateProfile {
  id String @id @default(cuid())

  workspaceId String    @unique
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  /// The version the candidate has confirmed. Null until they confirm one:
  /// matching must never run on unreviewed extraction output.
  confirmedVersionId String?                  @unique
  confirmedVersion   CandidateProfileVersion? @relation("ConfirmedVersion", fields: [confirmedVersionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions CandidateProfileVersion[] @relation("ProfileVersions")

  @@map("candidate_profiles")
}

/// How a version's content came to exist.
enum ProfileVersionOrigin {
  /// Produced by the extraction pipeline from a document.
  EXTRACTED
  /// The candidate's corrections applied on top of an extracted version.
  CORRECTED
  /// Typed in by the candidate with no document at all.
  MANUAL
}

/// An immutable snapshot of a candidate profile.
///
/// Rows here are never updated after creation — a correction creates a new
/// version pointing at its parent. That is what makes a past match
/// explainable: the exact profile that produced it still exists, alongside
/// the document hash and parser version that produced *it*.
model CandidateProfileVersion {
  id String @id @default(cuid())

  profileId String
  profile   CandidateProfile @relation("ProfileVersions", fields: [profileId], references: [id], onDelete: Cascade)

  /// Monotonic per profile, so a version has a human-quotable reference
  /// ("v3") as well as an id.
  versionNumber Int

  origin ProfileVersionOrigin

  /// The version this one corrects, if any. Null for the first version.
  parentVersionId String?
  parentVersion   CandidateProfileVersion?  @relation("VersionLineage", fields: [parentVersionId], references: [id], onDelete: SetNull)
  children        CandidateProfileVersion[] @relation("VersionLineage")

  /// The document this was extracted from. Null for MANUAL versions.
  documentId String?
  document   CandidateDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  /// Copied from the document rather than joined, so the provenance survives
  /// the document's deletion under a retention or erasure request.
  sourceContentHash String?

  /// Which code produced this content. A profile extracted by parser v1 and
  /// one extracted by v2 are not comparable, and pretending otherwise is how
  /// a matching regression becomes invisible.
  extractorName    String
  extractorVersion String

  /// Schema-validated profile content (lib/profile/contract.ts). Stored as
  /// JSON so the contract can gain fields without a migration per field,
  /// and validated on read as well as on write.
  content Json

  /// Per-field extraction confidence, same key shape as `content`. Drives
  /// the "check this" markers in the review UI.
  confidence Json?

  createdAt DateTime @default(now())

  confirmedFor CandidateProfile? @relation("ConfirmedVersion")

  tailoredResumes TailoredResume[]
  coverLetters    CoverLetter[]

  @@unique([profileId, versionNumber])
  @@index([profileId, createdAt])
  @@map("candidate_profile_versions")
}

// ─── M3: single-URL job tailoring target ────────────────────────────────
//
// ResuMatch does not aggregate or ingest job boards. A candidate pastes one
// job posting URL they intend to apply to; that page is fetched once
// (lib/tailoring/fetchJob.ts), its readable text extracted and redacted the
// same way CV text is, and the result stored here as the tailoring target.
// There is no source registry, no agreement, no sync — just the one page a
// candidate explicitly pointed at.

enum TargetJobStatus {
  /// Fetched and extracted successfully.
  FETCHED
  /// The fetch or extraction failed (unreachable, blocked, no readable text).
  FETCH_FAILED
}

/// One job posting a candidate is tailoring their CV toward.
model TargetJob {
  id String @id @default(cuid())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  /// The URL the candidate pasted. Validated as public HTTPS before fetch —
  /// see lib/tailoring/fetchJob.ts's isPublicHttpsUrl.
  sourceUrl String

  /// Readable text extracted from the page, redacted the same way CV text
  /// is before it ever reaches a prompt. Null when the fetch failed.
  rawText String? @db.Text

  /// Best-effort title/employer read from the page, shown to the candidate
  /// to confirm before an AI call is spent. Both null when extraction
  /// could not identify them, or when the fetch failed outright.
  title    String?
  employer String?

  /// Structured fields from the manual job-details entry form (issue #461,
  /// part of #458) — location, work mode, employment type, salary range,
  /// deadline, responsibilities/requirements/preferred/benefits, contact,
  /// source. Null for every other intake path (fetched URL, pasted text,
  /// pasted email, uploaded file), which only ever produce `rawText`. Kept
  /// as JSON rather than individual columns since it is candidate-typed,
  /// optional-almost-everywhere data with no source to validate it against
  /// — see lib/tailoring/manualJob.ts for the shape.
  structuredFields Json?

  status TargetJobStatus

  fetchedAt DateTime  @default(now())
  createdAt DateTime  @default(now())

  tailoredResumes TailoredResume[]
  applications    Application[]
  coverLetters    CoverLetter[]

  @@index([workspaceId, createdAt])
  @@map("target_jobs")
}

// ─── M4: AI-tailored resumes ─────────────────────────────────────────────
//
// The organising rule carried over from the old matching product: structured
// JSON only, re-validated before persistence, and every reproducibility
// field (prompt/model version, degraded flag) recorded alongside the
// content itself — see lib/tailoring/ai/.

/// One AI tailoring result: a candidate's confirmed profile version,
/// rewritten and reprioritized toward one TargetJob.
model TailoredResume {
  id String @id @default(cuid())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  profileVersionId String
  profileVersion   CandidateProfileVersion @relation(fields: [profileVersionId], references: [id], onDelete: Restrict)

  targetJobId String
  targetJob   TargetJob @relation(fields: [targetJobId], references: [id], onDelete: Cascade)

  /// Schema-validated tailored content (lib/tailoring/ai/schema.ts's
  /// tailoredResumeSchema). Employer/dates/degrees are carried over
  /// verbatim from the source profile — never AI-generated — only wording
  /// and ordering are rewritten.
  content Json

  /// Which visual layout to render this with (components/tailoring/templates).
  /// Only one key exists today; kept as a field so a second template is an
  /// additive change, not a schema migration.
  templateKey String

  aiJobId       String?
  promptVersion String
  modelVersion  String
  /// True when this was produced by the degraded fallback (no provider /
  /// retries exhausted / budget out) rather than a real model call.
  degraded      Boolean @default(false)

  /// The candidate's own freeform steering text for this run (issue #431),
  /// e.g. "emphasize my backend work", capped at 1000 chars by the API
  /// route before it ever reaches the prompt. A preference signal only —
  /// see lib/tailoring/ai/prompts.ts's third fenced block — never a source
  /// of fact, so it's safe to keep here purely for provenance/audit even
  /// though it plays no role in re-deriving content.
  instructions String?

  /// The language the generated prose was written in (#641): one of
  /// lib/tailoring/language.ts's OUTPUT_LANGUAGES ("en" | "nl" | "fr" | "de").
  /// Null when no language was applied — a CV made before #641, a degraded
  /// run (profile carried over unchanged), or one where every suggestion
  /// was declined. Templates render null exactly as they always have.
  outputLanguage String?

  createdAt DateTime @default(now())

  applications Application[]
  /// The cover letter generated alongside this CV in the same
  /// generate-confirm request, if the candidate opted in and approved one
  /// (issue #454). Null is a normal, common state — most tailored CVs
  /// never get a cover letter. See CoverLetter.tailoredResumeId's own
  /// comment for why this pairing needed its own column instead of being
  /// inferred from targetJobId.
  coverLetter CoverLetter?

  @@index([workspaceId, createdAt])
  @@index([targetJobId])
  @@map("tailored_resumes")
}

/// One AI-drafted cover letter, reviewed and confirmed the same way a
/// TailoredResume is (issue #454, part of #453's cover-letter tracking
/// issue) — a sibling row, not a field on TailoredResume, since declining
/// the letter is a valid independent outcome: the CV still saves even when
/// the candidate rejects the whole letter draft.
model CoverLetter {
  id String @id @default(cuid())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  profileVersionId String
  profileVersion   CandidateProfileVersion @relation(fields: [profileVersionId], references: [id], onDelete: Restrict)

  targetJobId String
  targetJob   TargetJob @relation(fields: [targetJobId], references: [id], onDelete: Cascade)

  /// The specific TailoredResume this letter was generated alongside, in
  /// the same generate-confirm request. Nullable, not because a letter can
  /// exist without one — generate-confirm always sets it on create — but
  /// because a candidate can re-tailor toward the same job multiple times,
  /// so targetJobId alone can't tell two CVs and a letter apart; without
  /// this column the CV preview page and history lists had no reliable way
  /// to show "this CV has a cover letter" once the URL that carried
  /// coverLetterId as a query param was gone. SetNull rather than Cascade:
  /// deleting the CV a letter was paired with should not silently delete
  /// the candidate's own drafted letter text too.
  tailoredResumeId String?       @unique
  tailoredResume   TailoredResume? @relation(fields: [tailoredResumeId], references: [id], onDelete: SetNull)

  /// Schema-validated content (lib/tailoring/ai/coverLetter/schema.ts).
  /// fullName is carried over from the source profile in code, never taken
  /// from provider output — see that schema's own doc comment.
  content Json

  promptVersion String
  modelVersion  String
  /// True when this was produced by the degraded fallback (no provider /
  /// retries exhausted / budget out) rather than a real model call.
  degraded      Boolean @default(false)
  /// The language the letter was written in (#642), one of
  /// lib/tailoring/language.ts's OUTPUT_LANGUAGES. Null for letters made
  /// before this existed and for degraded ones — nothing was written in a
  /// chosen language, so nothing is claimed.
  outputLanguage String?

  createdAt DateTime @default(now())

  @@index([workspaceId, createdAt])
  @@index([targetJobId])
  @@map("cover_letters")
}

/// The server's own record of a `generate-preview` provider call, and the
/// only thing `generate-confirm` trusts for provenance (issue #525).
///
/// `generate-confirm` used to persist `promptVersion`/`modelVersion`/
/// `degraded` straight from the client's request body — nothing stopped a
/// client from calling confirm directly, skipping the provider call (and
/// its budget spend) entirely, and claiming a real model produced the
/// result. This row is written once, by `generate-preview`, right after the
/// actual provider call(s) it made; `generate-confirm` requires the row's id
/// back, re-derives provenance from it instead of the request body, and
/// consumes it so the same preview cannot back two different confirms.
///
/// A DB row, not a signed token: this app already persists every other
/// piece of short-lived request state this way, and a row avoids adding a
/// signing-key dependency for what is fundamentally a one-time-use claim
/// check, the same shape `CandidateDocument`'s atomic status claim already
/// uses.
model TailorPreview {
  id String @id @default(cuid())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  profileVersionId String
  targetJobId      String

  promptVersion String
  modelVersion  String
  degraded      Boolean

  /// Null when this preview did not include a cover letter (the candidate
  /// never opted in, or the request didn't ask for one) — confirm() then
  /// rejects a `coverLetter` block in the same way it rejects a
  /// `TailorPreview` that never existed.
  coverLetterPromptVersion String?
  coverLetterModelVersion  String?
  coverLetterDegraded      Boolean?
  /// The output language this preview's tailor call was asked for (#641).
  /// generate-confirm copies it onto the TailoredResume from here — the
  /// server's record — never from anything the client echoes back.
  outputLanguage           String?
  /// The language this preview's cover-letter call was asked for (#642).
  /// Null when no letter was requested. Copied onto the CoverLetter by
  /// generate-confirm, only when the letter was actually drafted.
  coverLetterOutputLanguage String?

  createdAt  DateTime  @default(now())
  /// Set by generate-confirm on first (and only) use. A second confirm
  /// attempt against the same preview is rejected the same way an expired
  /// or unknown one is.
  consumedAt DateTime?

  @@index([workspaceId, createdAt])
  @@map("tailor_previews")
}

// ─── Per-application tracking (issue #432) ────────────────────────────────
//
// The pivot removed the old tracked-jobs workflow (see M6 below) because it
// was bound to aggregated job-board data. This is its lightweight
// replacement: every row is user-supplied (a TargetJob the candidate
// already created) or derived from a AI call the candidate already
// approved (a TailoredResume) — no ingestion, no scraping, zero licensing
// exposure.

enum ApplicationStatus {
  SAVED
  APPLIED
  INTERVIEWING
  OFFER
  REJECTED
}

/// One job application a candidate is tracking — a status, optional notes,
/// and a link to whichever tailored resume (if any) was used for it.
model Application {
  id String @id @default(cuid())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  targetJobId String
  targetJob   TargetJob @relation(fields: [targetJobId], references: [id], onDelete: Cascade)

  /// Optional: not every application is tied to an AI-tailored resume —
  /// the candidate may have applied with their base profile, or before
  /// this feature existed. Set null (not cascaded) if the tailored resume
  /// is ever removed, since the application record itself should outlive it.
  tailoredResumeId String?
  tailoredResume   TailoredResume? @relation(fields: [tailoredResumeId], references: [id], onDelete: SetNull)

  status ApplicationStatus @default(SAVED)

  /// Candidate's own freeform notes. Never AI-generated, never analyzed.
  notes String? @db.Text

  /// Optional reminder date the candidate set for themselves (e.g. "follow
  /// up if no response by"). Purely informational — nothing sends a
  /// notification from this field yet.
  followUpDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId, createdAt])
  @@index([workspaceId, status])
  @@map("applications")
}

// ─────────────────────────────────────────────────────────────────────────
// Model/prompt/budget controls & honest degraded mode
// ─────────────────────────────────────────────────────────────────────────

/// Append-only spend ledger for ResuMatch's AI provider calls. Mirrors
/// apps/tasks-ai/lib/ai/quota.ts's AiUsageLedger (see that schema's own
/// AiUsageLedger model), adapted to ResuMatch's isolated schema.
model AiUsageLedger {
  id          String   @id @default(cuid())
  workspaceId String
  /// One row per provider call — `tailor | extract | rewrite | fetch_job |
  /// cover_letter | categorize_skills | job_meta`. See lib/tailoring/ai/quota.ts.
  kind        String
  provider    String
  model       String
  promptVersion String?
  inputTokens Int      @default(0)
  outputTokens Int     @default(0)
  costUsd     Float    @default(0)
  createdAt   DateTime @default(now())

  @@index([workspaceId, createdAt])
  @@map("ai_usage_ledger")
}

// ─── AI cost ledger (milestone #31, issue #586) ───────────────────────────
//
// Implements the platform AI cost-event contract (@asafarim/ai-cost-ledger,
// docs/adr/0003-ai-cost-event-contract.md) inside this isolated database.
// Supersedes AiUsageLedger for new writes; legacy rows stay where they are
// and are read as "legacy / unattributed" history (lib/costs/read.ts) and
// still count toward the monthly budget (lib/tailoring/ai/quota.ts).

/// One immutable row per metered provider call, attributed at call time to
/// the most specific durable entity it served. UPDATE is rejected by a
/// database trigger (see the migration); corrections are new `adjustment`
/// rows pointing at `supersedesEventId`. Operational metadata only — no
/// CV text, job text, prompt, response or secret ever lands here.
model AiCostEvent {
  id             String   @id @default(cuid())
  /// `resumatch:<operation>:<provider request id | call id>`. Unique, so a
  /// retried write is a no-op (insert with skipDuplicates).
  idempotencyKey String   @unique
  schemaVersion  Int      @default(1)
  /// usage | adjustment
  entryType      String   @default("usage")

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Opaque platform user id of the candidate who triggered the call.
  actorId     String?

  /// tailor | extract | rewrite | fetch_job | cover_letter | categorize_skills | job_meta
  operation String
  /// succeeded | degraded | failed | cancelled
  outcome   String @default("succeeded")
  /// provisional | final
  finality  String @default("provisional")

  /// target_job | tailor_preview | tailored_resume | candidate_document | candidate_profile
  subjectType       String
  subjectId         String
  parentSubjectType String?
  parentSubjectId   String?
  /// Denormalized job link for job/application subtotals. Plain column, not
  /// a FK: deleting a job must not delete the record that money was spent.
  /// An Application resolves through its own targetJobId at read time, so
  /// an application saved after generation never rewrites an old event.
  targetJobId       String?
  /// Groups separate line items of one user action (tailor + cover letter
  /// in one preview share the preview id).
  workflowId        String?
  traceId           String?

  provider          String
  requestModel      String?
  responseModel     String
  providerRequestId String?
  promptVersion     String?
  pricingTier       String?

  /// Exclusive usage buckets: [{ bucket, unit, quantity }].
  usage        Json    @default("[]")
  /// Σ input-side / output-side token buckets, denormalized for cheap sums.
  inputTokens  Int     @default(0)
  outputTokens Int     @default(0)

  currency              String  @default("USD")
  /// Integer USD micros. null = unknown — never a placeholder 0.
  estimatedCostMicros   BigInt?
  actualCostMicros      BigInt?
  adjustmentDeltaMicros BigInt?
  /// provider_reported | registry_estimate | reconciled_adjustment | unknown
  costSource            String
  /// platform | user_byok | none
  credentialSource      String
  pricingSnapshot       Json?
  fixture               Boolean @default(false)

  supersedesEventId String?
  latencyMs         Int?
  metadata          Json    @default("{}")

  occurredAt  DateTime
  finalizedAt DateTime?
  recordedAt  DateTime @default(now())

  @@index([workspaceId, occurredAt(sort: Desc), id(sort: Desc)])
  @@index([workspaceId, targetJobId])
  @@index([workspaceId, workflowId])
  @@map("ai_cost_events")
}
