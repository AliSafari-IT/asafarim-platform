// JobMatch — dedicated database schema (M1 baseline).
//
// JobMatch deliberately does NOT use the shared platform Prisma schema
// (packages/db). Job listings are high-volume and frequently rewritten by
// ingestion, and CV-derived data needs a stricter access boundary than
// identity traffic — see apps/jobmatch/docs/business-plan.md §"Database
// recommendation". This schema therefore lives on its own PostgreSQL
// instance (local port 55437) with its own credentials.
//
// Identity stays in the platform: JobMatch stores an OPAQUE authenticated
// user id (the platform user id string) and never duplicates the platform
// User table, so there is no second place a candidate's identity can drift
// or leak from.
//
// M1 is a foundation milestone: only the tables needed to prove the
// boundary exist here. The ingestion, profile, and matching entities named
// in the business plan (JobSource, JobPosting, CandidateProfile, ...) land
// with M2/M3, each with its own migration and access review.

generator client {
  provider      = "prisma-client-js"
  // Generated into the app rather than node_modules/@prisma/client: pnpm
  // symlinks that path to the shared store, where the PLATFORM client
  // already lives. Two schemas, two clients, no clobbering.
  output        = "../lib/db/generated"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

/// A candidate's JobMatch workspace, keyed by the opaque platform user id.
/// Holds no name, email, or other platform profile data — those are read
/// from the session at request time and never persisted here.
model Workspace {
  id String @id @default(cuid())

  /// Opaque platform user id (Auth.js `session.user.id`). Unique: one
  /// workspace per authenticated user.
  platformUserId String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditEvents AuditEvent[]
  documents   CandidateDocument[]
  profile     CandidateProfile?

  @@map("workspaces")
}

/// Append-only record of consequential actions inside a workspace.
///
/// M1 seeds the table and the write path so that every later milestone has
/// somewhere to record data-rights actions (JM-023) and connector runs
/// (JM-031) from day one. `metadata` is a redacted, allow-listed JSON blob:
/// CV text, extracted personal data, and secrets must never reach it.
model AuditEvent {
  id String @id @default(cuid())

  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  /// Stable dotted action name, e.g. "workspace.created".
  action String

  /// Redacted, allow-listed structured context. Never raw documents.
  metadata Json?

  createdAt DateTime @default(now())

  @@index([workspaceId, createdAt])
  @@index([action, createdAt])
  @@map("audit_events")
}

// ─── M2: candidate profile and CV pipeline ──────────────────────────────
//
// The organising rule for everything below: a document is untrusted until
// proven otherwise, and derived data is always traceable back to the exact
// document and parser version that produced it.
//
// Deliberately absent: any field that could hold or infer a protected
// attribute (age, gender, nationality, ethnicity, religion, health,
// disability, family status). A CV routinely contains these; JobMatch's
// extraction contract drops them rather than storing them, so there is no
// column here for one to land in. See lib/profile/contract.ts.

/// Where an uploaded document is in the scan/extract pipeline. A document
/// moves forward only on evidence; there is no state that means "probably
/// fine".
enum DocumentStatus {
  /// Bytes stored, nothing verified yet. Never read by a parser.
  UPLOADED
  /// Handed to the scanner, awaiting a verdict.
  SCANNING
  /// Scanner said unsafe, or could not say. Terminal without operator action.
  QUARANTINED
  /// Scanned clean; extraction may run.
  CLEAN
  /// Text extraction in progress.
  EXTRACTING
  /// Text extracted and a draft profile produced.
  EXTRACTED
  /// Extraction failed after its retry budget.
  FAILED
}

/// Why a document was quarantined or failed. Stored as a code so the UI can
/// explain it without a parser or scanner message — those can embed file
/// content — reaching the user or the logs.
enum DocumentReasonCode {
  MALWARE_DETECTED
  SCANNER_UNAVAILABLE
  UNSUPPORTED_TYPE
  DECLARED_TYPE_MISMATCH
  FILE_TOO_LARGE
  EMPTY_FILE
  ENCRYPTED_DOCUMENT
  NO_TEXT_LAYER
  EXTRACTION_ERROR
  /// Text was read, but not in reading order — a multi-column or heavily
  /// designed document. Section-derived fields are deliberately left empty
  /// rather than filled from the wrong part of the page.
  LAYOUT_UNRELIABLE
}

/// An uploaded CV. The bytes live in private object storage; this row holds
/// only metadata and the audit trail.
model CandidateDocument {
  id String @id @default(cuid())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  /// Object-storage key. Always prefixed with the workspace id so a key
  /// cannot be guessed across tenants, and never exposed to the client.
  storageKey String @unique

  /// The user's own filename, kept for display only. Never used to build a
  /// storage key or a filesystem path.
  originalFilename String

  /// Content type as *sniffed from the bytes*, not as declared by the
  /// browser. See lib/documents/fileType.ts.
  contentType String
  byteSize    Int

  /// SHA-256 of the stored bytes — the anchor that makes a profile version
  /// reproducible, and the way a re-upload of the same CV is recognised.
  contentHash String

  status     DocumentStatus     @default(UPLOADED)
  reasonCode DocumentReasonCode?

  /// Scanner name and verdict time, so a stale "clean" is visible as stale.
  scannerName String?
  scannedAt   DateTime?

  /// Retry accounting for extraction. Bounded so a malformed document
  /// cannot be retried forever.
  extractionAttempts Int       @default(0)
  extractionStartedAt DateTime?

  /// When the stored bytes become eligible for deletion (JM-017 retention).
  retainUntil DateTime?

  uploadedAt DateTime  @default(now())
  deletedAt  DateTime?

  profileVersions CandidateProfileVersion[]

  @@index([workspaceId, uploadedAt])
  @@index([workspaceId, status])
  @@index([workspaceId, contentHash])
  @@map("candidate_documents")
}

/// The candidate's current profile pointer. One per workspace. Holds no
/// profile data itself — the data lives in immutable versions, and this row
/// only records which version is in force.
model CandidateProfile {
  id String @id @default(cuid())

  workspaceId String    @unique
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  /// The version the candidate has confirmed. Null until they confirm one:
  /// matching must never run on unreviewed extraction output.
  confirmedVersionId String?                  @unique
  confirmedVersion   CandidateProfileVersion? @relation("ConfirmedVersion", fields: [confirmedVersionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions CandidateProfileVersion[] @relation("ProfileVersions")

  @@map("candidate_profiles")
}

/// How a version's content came to exist.
enum ProfileVersionOrigin {
  /// Produced by the extraction pipeline from a document.
  EXTRACTED
  /// The candidate's corrections applied on top of an extracted version.
  CORRECTED
  /// Typed in by the candidate with no document at all.
  MANUAL
}

/// An immutable snapshot of a candidate profile.
///
/// Rows here are never updated after creation — a correction creates a new
/// version pointing at its parent. That is what makes a past match
/// explainable: the exact profile that produced it still exists, alongside
/// the document hash and parser version that produced *it*.
model CandidateProfileVersion {
  id String @id @default(cuid())

  profileId String
  profile   CandidateProfile @relation("ProfileVersions", fields: [profileId], references: [id], onDelete: Cascade)

  /// Monotonic per profile, so a version has a human-quotable reference
  /// ("v3") as well as an id.
  versionNumber Int

  origin ProfileVersionOrigin

  /// The version this one corrects, if any. Null for the first version.
  parentVersionId String?
  parentVersion   CandidateProfileVersion?  @relation("VersionLineage", fields: [parentVersionId], references: [id], onDelete: SetNull)
  children        CandidateProfileVersion[] @relation("VersionLineage")

  /// The document this was extracted from. Null for MANUAL versions.
  documentId String?
  document   CandidateDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  /// Copied from the document rather than joined, so the provenance survives
  /// the document's deletion under a retention or erasure request.
  sourceContentHash String?

  /// Which code produced this content. A profile extracted by parser v1 and
  /// one extracted by v2 are not comparable, and pretending otherwise is how
  /// a matching regression becomes invisible.
  extractorName    String
  extractorVersion String

  /// Schema-validated profile content (lib/profile/contract.ts). Stored as
  /// JSON so the contract can gain fields without a migration per field,
  /// and validated on read as well as on write.
  content Json

  /// Per-field extraction confidence, same key shape as `content`. Drives
  /// the "check this" markers in the review UI.
  confidence Json?

  createdAt DateTime @default(now())

  confirmedFor CandidateProfile? @relation("ConfirmedVersion")

  @@unique([profileId, versionNumber])
  @@index([profileId, createdAt])
  @@map("candidate_profile_versions")
}

// ─── M3: authorized job ingestion ───────────────────────────────────────
//
// The organising rule: nothing is fetched that is not covered by a recorded
// agreement, and nothing is shown that cannot be traced back to the exact
// bytes a source returned.
//
// JobMatch does not scrape. A source has to exist as a row, carry an
// agreement reference, and be explicitly enabled before a single request is
// made — see lib/ingestion/authorization.ts. That is a product rule from the
// business plan ("no unapproved scraping"), and giving it a schema of its
// own is what stops it eroding into a TODO.

/// How a source is reached. Deliberately small: each value is a different
/// legal and technical posture, so adding one is a decision rather than a
/// configuration change.
enum SourceKind {
  /// A JSON feed an employer or aggregator publishes for syndication.
  JSON_FEED
  /// An official API used under a partnership agreement.
  PARTNER_API
}

enum SourceStatus {
  /// Configured but never enabled. Cannot be synced.
  DRAFT
  /// Enabled and syncing.
  ACTIVE
  /// Temporarily stopped by an operator.
  PAUSED
  /// Agreement ended or withdrawn. Terminal, and its postings are hidden.
  TERMINATED
}

/// A job source, and the terms JobMatch may use it under.
///
/// The agreement fields are not documentation. A sync is refused unless they
/// are present and unexpired, so an unauthorised source cannot be fetched
/// even by mistake.
model JobSource {
  id  String @id @default(cuid())
  /// Stable operator-facing key, e.g. "example-employer-feed".
  key String @unique

  name String
  kind SourceKind

  /// Where the feed lives. Validated against the outbound allowlist on every
  /// request, never only at configuration time — see lib/ingestion/http.ts.
  endpoint String

  status SourceStatus @default(DRAFT)
  /// The master switch, kept separate from `status` so that pausing a source
  /// is not the same act as revoking its authorisation.
  syncEnabled Boolean @default(false)

  /// Reference to the signed agreement in the source-rights register
  /// (JM-003). Free text on purpose: that register lives outside this system.
  agreementReference String?
  /// After this, the source stops syncing on its own.
  agreementExpiresAt DateTime?
  /// Attribution the UI must show alongside every posting from here.
  attributionText String?
  /// Whether the agreement permits commercial reuse. Absent means unknown,
  /// which is treated as "no" everywhere it matters.
  commercialUse Boolean?

  /// Politeness controls, taken from the agreement rather than guessed.
  requestsPerMinute Int @default(20)
  /// How long raw payloads may be kept. Snapshots past this are deleted even
  /// though the normalized posting survives.
  snapshotRetentionDays Int @default(30)

  lastSyncStartedAt  DateTime?
  lastSyncFinishedAt DateTime?
  /// HTTP validators for conditional requests, so a sync that changes
  /// nothing costs the source nothing.
  lastEtag     String?
  lastModified String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  snapshots JobSnapshot[]
  postings  JobPosting[]
  runs      IngestionRun[]

  @@map("job_sources")
}

/// Raw bytes exactly as a source returned them.
///
/// Kept separate from the normalized posting so normalization is
/// reproducible: a parser fix can be replayed against the original payload
/// rather than needing a re-fetch, which an agreement may not even permit.
/// Retention is bounded by the source's own policy.
model JobSnapshot {
  id String @id @default(cuid())

  sourceId String
  source   JobSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  /// SHA-256 of the payload, so a repeat sync returning identical bytes is
  /// recognised without storing them twice.
  contentHash String
  /// The payload itself. Cleared when its retention window closes.
  payload  String?
  byteSize Int

  capturedAt  DateTime @default(now())
  retainUntil DateTime

  /// Which normalization produced postings from this snapshot, so a replay
  /// can tell old output from new.
  normalizerVersion String?

  postings JobPosting[]

  @@unique([sourceId, contentHash])
  @@index([sourceId, capturedAt])
  @@index([retainUntil])
  @@map("job_snapshots")
}

enum PostingStatus {
  ACTIVE
  /// Past its expiry, or gone from the feed. Not shown as current.
  EXPIRED
  /// A duplicate of another posting. Kept for provenance, never displayed.
  DUPLICATE
  /// Source authorisation ended. Hidden regardless of its own dates.
  WITHDRAWN
}

/// A normalized job posting.
///
/// Every field a candidate sees comes from here, and every one is traceable:
/// `sourceId` says where it came from, `snapshotId` from which exact
/// payload, and `canonicalUrl` sends the candidate to apply at the source
/// rather than through JobMatch.
model JobPosting {
  id String @id @default(cuid())

  sourceId String
  source   JobSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  snapshotId String?
  snapshot   JobSnapshot? @relation(fields: [snapshotId], references: [id], onDelete: SetNull)

  /// The source's own identifier, unique per source, and the first key
  /// deduplication tries.
  externalId String
  /// Where to apply. Always the source's page, never a JobMatch mirror.
  canonicalUrl String

  title       String
  employer    String
  description String  @db.Text
  /// The posting's language as stated or detected, for M4's filtering.
  language    String?

  locationRaw  String?
  isRemote     Boolean?
  contractType String?

  salaryMin      Int?
  salaryMax      Int?
  salaryCurrency String?
  salaryPeriod   String?

  /// Skills as the posting words them. Normalisation to a controlled
  /// vocabulary is M4's job and must not erase the original.
  skillsRaw String[]

  /// Hash over the fields that define the posting, to tell a genuine update
  /// from an unchanged re-fetch.
  contentHash String
  /// Stable key across sources, for cross-source deduplication.
  canonicalKey String

  /// The posting this duplicates, if any. The representative is the one with
  /// no parent, and it is the only one ever displayed.
  duplicateOfId String?
  duplicateOf   JobPosting?  @relation("Duplicates", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates    JobPosting[] @relation("Duplicates")

  status PostingStatus @default(ACTIVE)

  /// Freshness, all four kept separately: when the source says it was
  /// published, when it expires, when JobMatch first saw it, and when it was
  /// last confirmed still present. A stale listing is the most common way a
  /// job board wastes a candidate's time.
  publishedAt     DateTime?
  expiresAt       DateTime?
  firstSeenAt     DateTime  @default(now())
  lastSeenAt      DateTime  @default(now())
  sourceUpdatedAt DateTime?

  normalizerVersion String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sourceId, externalId])
  @@index([canonicalKey])
  @@index([status, lastSeenAt])
  @@index([sourceId, status])
  @@map("job_postings")
}

enum RunOutcome {
  SUCCEEDED
  /// Finished, but some records failed to normalize.
  PARTIAL
  FAILED
  /// Refused before any request was made — no agreement, expired, disabled.
  REFUSED
}

/// One sync attempt, and what it cost.
///
/// Exists so ingestion health is a query rather than a guess (JM-031):
/// success rate, records added and expired, duplicates, parse failures,
/// latency, and rate-limit responses are all recorded here.
model IngestionRun {
  id String @id @default(cuid())

  sourceId String
  source   JobSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  outcome    RunOutcome?
  /// Why a run was refused or failed, as a code. Never a raw error message:
  /// those carry URLs and credentials.
  reasonCode String?

  recordsFetched   Int @default(0)
  recordsAdded     Int @default(0)
  recordsUpdated   Int @default(0)
  recordsExpired   Int @default(0)
  duplicatesFound  Int @default(0)
  parseFailures    Int @default(0)
  rateLimitedCount Int @default(0)
  /// True when the source answered 304 and there was nothing to do.
  notModified Boolean @default(false)

  durationMs Int?

  @@index([sourceId, startedAt])
  @@map("ingestion_runs")
}
