# testora keeps its OWN database, separate from the platform's shared Postgres.
# Most vars below are already provided by the monorepo root .env.local / .env
# (loaded automatically by next.config.ts); set app-only overrides here in an
# apps/testora/.env.local if you need them.
TESTORA_DATABASE_URL=postgres://e2e_testora:e2e_testora@127.0.0.1:55434/e2e-testing-db
BASE_URL=http://localhost:3005

# Optional: AI-drafted issue content for the Results "Generate issue" flow.
# Without a key, issues fall back to a deterministic template. Server-only.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Secret used to sign the "unlock" cookie for private apps (server-side only).
# Set a long random value in any shared/production deployment — otherwise the
# unlock cookie falls back to a known dev secret and could be forged.
# TESTORA_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Apps under test — testora is generic, so nothing about a specific app is
# hard-coded; each app is its own project (see src/data/projects.ts).
# ─────────────────────────────────────────────────────────────────────────────

# Credentials of the shared ASafariM admin account the SSO suites (portal,
# EduMatch, Vionto, TimelineAI, …) sign in with via Hub.
ASAFARIM_ADMIN_EMAIL=
ASAFARIM_ADMIN_PASSWORD=

# ASafariM Hub — the central sign-in gateway every app's SSO suite goes through.
ASAFARIM_HUB_URL=http://localhost:3001
NEXT_PUBLIC_ASAFARIM_HUB_URL=http://localhost:3001

# TimelineAI — Local target is always http://localhost:3010 (its dev port);
# override the Remote preset surfaced on the Run page's environment selector.
ASAFARIM_TIMELINEAI_URL=https://tlai.asafarim.com
NEXT_PUBLIC_ASAFARIM_TIMELINEAI_URL=https://tlai.asafarim.com
