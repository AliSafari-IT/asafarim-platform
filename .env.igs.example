# igs-pharma.be staging (#822): the igs stack's env, read by
# infra/igs/docker-compose.yml through infra/scripts/igs-deploy.sh.
# Encrypted as .env.igs.age (pnpm env:encrypt:igs); placeholders only here.
# Never put these values in .env.production: the asafarim-com stack doesn't
# get them.

# Dedicated Postgres (igs-postgres, no host port). Use a hex password
# (openssl rand -hex 32) so it needs no escaping in DATABASE_URL.
IGS_POSTGRES_PASSWORD=REPLACE_ME_openssl_rand_hex_32
DATABASE_URL=postgresql://igs:REPLACE_ME_openssl_rand_hex_32@igs-postgres:5432/igs_pharma

# Better Auth: one secret, one canonical URL per app.
AUTH_SECRET=REPLACE_ME_openssl_rand_hex_32
AUTH_URL=https://igs-pharma.be
IGS_PLATFORM_AUTH_URL=https://platform.igs-pharma.be

# Audit ip/ua hashes (>= 32 chars) and the 32-byte hex encryption key.
AUDIT_HMAC_KEY=REPLACE_ME_openssl_rand_hex_32
ENCRYPTION_KEY=REPLACE_ME_openssl_rand_hex_32

# Storefront: coming-soon (closed, noindex) until it opens on purpose.
SITE_GATE=coming-soon

# platform.igs-pharma.be staff allow-list: IPs or CIDRs, space-separated.
# The Caddy that serves the site reads it from its own environment: before the
# edge cutover that is the asafarim-com Caddy, so it also goes in
# .env.production (and needs infra/scripts/caddy-recreate.sh --yes once).
IGS_PLATFORM_ALLOW_IPS=192.0.2.1/32
