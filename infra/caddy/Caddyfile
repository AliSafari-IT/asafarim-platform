  reverse_proxy web:3000
}

www.asafarim.com {
  reverse_proxy web:3000
}

hub.asafarim.com {
  reverse_proxy hub:3000
}

admin.asafarim.com {
  reverse_proxy admin:3000
}

showcase.asafarim.com {
  reverse_proxy showcase:3000
}

vionto.asafarim.com {
  # Media uploads can be large; give the proxy generous timeouts.
  reverse_proxy vionto:3000 {
    transport http {
      read_timeout 600s
      write_timeout 600s
    }
  }
}

edumatch.asafarim.com {
  reverse_proxy edumatch:3000 {
    transport http {
      read_timeout 600s
      write_timeout 600s
    }
  }
}

testora.asafarim.com {
  # Test runs stream progress over a long-lived connection; be generous.
  reverse_proxy testora:3000 {
    transport http {
      read_timeout 600s
      write_timeout 600s
    }
  }
}

appbuilder.asafarim.com {
  reverse_proxy appbuilder:3000
}

tlai.asafarim.com {
  # Puppeteer export requests (Task #10) can take several seconds; be generous.
  reverse_proxy timelineai:3000 {
    transport http {
      read_timeout 600s
      write_timeout 600s
    }
  }
}

# asafarim.be is a separate deployment (asafarim-devtools + logo-normalizer
# projects, each their own docker-compose project on this same VPS/Docker
# network) sharing this one Caddy instance for TLS termination.
asafarim.be {
  handle /apps/logo-normalizer* {
    reverse_proxy logo-normalizer:3202
  }
  handle {
    reverse_proxy devtools:3200
  }
}

www.asafarim.be {
  handle /apps/logo-normalizer* {
    reverse_proxy logo-normalizer:3202
  }
  handle {
    reverse_proxy devtools:3200
  }
}

# M11: wildcard managed-app hosting. Every `{app-slug}.apps.asafarim.com`
# host is routed to the SAME AppBuilder container as the builder itself —
# there is no per-app container or deployment target. AppBuilder's own
# proxy.ts (lib/routing/resolveAppHost.ts) does the real work: it normalizes
# and validates the Host header, rejects reserved/malformed slugs with a
# generic 404, and resolves the active production release server-side from
# the persisted `app_domains` table — Caddy's only job here is getting the
# request to the right container.
#
# DELIBERATELY COMMENTED OUT: a wildcard certificate requires a DNS-01
# challenge, which requires a Caddy build with a DNS provider module (the
# stock `caddy:latest` image used by docker-compose.prod.yml has none) —
# uncommenting this block against the current image would fail to parse and
# take down EVERY app behind this Caddy instance, not just AppBuilder. See
# docs/appbuilder-m11-releases-deployment.md#dns-and-tls for the required
# wildcard DNS record, the custom Caddy build (infra/caddy/Dockerfile),
# provider-module confirmation, secret handling, staging-cert testing, and
# the exact rollout sequence before uncommenting this in a real deployment.
#
# *.apps.asafarim.com {
#   reverse_proxy appbuilder:3000
#   tls {
#     # Replace <provider> with the DNS-01 module actually built into
#     # infra/caddy/Dockerfile for your DNS host.
#     dns <provider> {env.CADDY_DNS_API_TOKEN}
#   }
# }
