# igs-pharma.be staging env (asafarim-platform#822, roadmap IGS-D5). PLACEHOLDERS ONLY.
# The real file is infra/igs/.env.igs.age (age-encrypted to .age/key.pub). To edit on the VPS:
#   age -d -i .age/key.txt infra/igs/.env.igs.age > infra/igs/.env.igs
#   $EDITOR infra/igs/.env.igs
#   age -R .age/key.pub -o infra/igs/.env.igs.age infra/igs/.env.igs
# igs-deploy.sh refuses to deploy while any value below still contains CHANGE_ME.
# Separate from every other app's env: nothing here is shared with asafarim-com.

# --- Deploy-only (IGS_*): read by the compose file and igs-deploy.sh, NEVER passed to an app ---
# Password of the dedicated igs-postgres superuser `igs` (URL-safe, e.g. `openssl rand -hex 32`).
IGS_POSTGRES_PASSWORD=CHANGE_ME
# DDL-capable connection for igs-migrate only (the migrator role).
IGS_MIGRATOR_DATABASE_URL=postgres://igs:CHANGE_ME@igs-postgres:5432/igs
# Who may reach platform.igs-pharma.be: IPv4/IPv6 CIDRs with a prefix, comma- or space-separated,
# e.g. "203.0.113.7/32, 2001:db8:1234::/64". Rendered into the edge site file on the server only.
IGS_PLATFORM_ALLOW_IPS=CHANGE_ME

# --- App runtime (igs-web, igs-platform, igs-worker) ---
# The apps' connection (the igs_app login role once the DBA has created it, B-08).
DATABASE_URL=postgres://CHANGE_ME@igs-postgres:5432/igs
AUTH_SECRET=CHANGE_ME
# >= 32 characters (audit-log.md).
AUDIT_HMAC_KEY=CHANGE_ME
ENCRYPTION_KEY=CHANGE_ME
# Storefront gate: coming-soon (closed, noindex) until Gate 1. igs-web defaults to it.
SITE_GATE=coming-soon
# AUTH_URL is set per app in infra/igs/docker-compose.yml (https://igs-pharma.be and
# https://platform.igs-pharma.be): one env file serves both apps.
