{
  "name": "asafarim-platform",
  "version": "0.4.3",
  "private": true,
  "description": "ASafarIM Platform - unified monorepo for all ASafarIM Digital apps and services",
  "author": "Ali Safari",
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457",
  "scripts": {
    "dev": "tsx scripts/dev-start.mts",
    "clean": "rimraf node_modules .turbo && turbo clean",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test --filter=./packages/*",
    "typecheck": "turbo typecheck",
    "format": "prettier --write .",
    "env:status": "envage status",
    "env:check": "tsx scripts/check-env-safety.mts",
    "env:key:init": "envage init-key",
    "env:encrypt": "envage encrypt --all --env root",
    "env:decrypt": "envage decrypt --all --env root",
    "env:encrypt:local": "envage encrypt --all --env local",
    "env:decrypt:local": "envage decrypt --all --env local",
    "env:encrypt:production": "envage encrypt --all --env production",
    "env:decrypt:production": "envage decrypt --all --env production",
    "db:generate": "pnpm --filter @asafarim/db db:generate",
    "db:migrate": "pnpm --filter @asafarim/db db:migrate",
    "db:migrate:deploy": "pnpm --filter @asafarim/db db:migrate:deploy",
    "db:push": "pnpm --filter @asafarim/db db:push",
    "db:studio": "pnpm --filter @asafarim/db db:studio",
    "db:seed": "pnpm --filter @asafarim/db db:seed",
    "db:seed:prod": "pnpm --filter @asafarim/db db:seed:prod",
    "db:seed:edumatch": "pnpm --filter @asafarim/db db:seed:edumatch",
    "db:seed:timelineai": "pnpm --filter @asafarim/db db:seed:timelineai",
    "db:migrate:deploy:prod": "pnpm --filter @asafarim/db db:migrate:deploy:prod",
    "db:up": "docker compose --env-file .env.local up -d",
    "app:admin": "pnpm --filter @asafarim/admin dev",
    "app:appbuilder": "pnpm --filter @asafarim/appbuilder dev",
    "app:edumatch": "pnpm --filter edumatch dev",
    "app:hub": "pnpm --filter @asafarim/hub dev",
    "app:jobmatch": "pnpm --filter @asafarim/jobmatch dev",
    "app:labs": "pnpm --filter @asafarim/labs dev",
    "app:showcase": "pnpm --filter @asafarim/showcase dev",
    "app:tasksai": "pnpm --filter @asafarim/tasks-ai dev",
    "app:testora": "pnpm --filter testora dev",
    "app:timelineai": "pnpm --filter timelineai dev",
    "app:vionto": "pnpm --filter vionto dev",
    "app:web": "pnpm --filter @asafarim/web dev",
    "bench:testora": "pnpm --filter @asafarim/testora-benchmark test",
    "bench:testora:fixtures": "pnpm --filter @asafarim/testora-benchmark bench:generate",
    "bench:ai-eval": "pnpm --filter @asafarim/ai-eval-benchmark eval",
    "bench:ai-eval:fixtures": "pnpm --filter @asafarim/ai-eval-benchmark bench:generate",
    "bench:edumatch": "pnpm --filter @asafarim/edumatch-benchmark test",
    "bench:edumatch:fixtures": "pnpm --filter @asafarim/edumatch-benchmark bench:generate",
    "bench:vionto": "pnpm --filter @asafarim/vionto-benchmark test",
    "bench:vionto:fixtures": "pnpm --filter @asafarim/vionto-benchmark bench:generate",
    "deploy:prod": "bash ./infra/scripts/deploy-prod.sh",
    "runFromVPS": "bash ./infra/scripts/vps-deploy.sh",
    "runFromLocal": "pnpm deploy:prod",
    "inspectVpsStorage": "ssh vps \"df -h && docker system df\"",
    "inspectVpsDocker": "ssh vps \"docker ps\"",
    "inspectVpsDockerImages": "ssh vps \"docker images\"",
    "inspectVpsDockerContainers": "ssh vps \"docker container ls -a\"",
    "freeUnusedResources": "ssh vps \"cd /var/repos/asafarim-com && bash infra/scripts/cleanup-docker.sh\""
  },
  "devDependencies": {
    "@asafarim/envage": "^0.4.2",
    "@types/node": "^24.0.0",
    "kill-port": "^2.0.1",
    "prettier": "^3.5.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.0",
    "turbo": "^2.10.13",
    "typescript": "^5.7.0"
  }
}
