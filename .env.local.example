# Local development environment — copy to .env at the repo root.
# Apps load the root .env via next.config.ts; Prisma via dotenv-cli.
#
# DO NOT commit real secrets to version control.

NODE_ENV=development

# ─── Database (docker compose up -d postgres) ────────────────────────────────
POSTGRES_USER=asafarim
POSTGRES_PASSWORD=asafarim_dev
POSTGRES_DB=asafarim
# Host port 55435 — see docker-compose.yml (5432 often taken locally).
# Use 127.0.0.1, not `localhost` — on some Windows/Docker Desktop setups
# `localhost` resolves to IPv6 first and the IPv6 port-forward can silently
# drop queries after the TCP handshake succeeds (Prisma P1017 ConnectionClosed).
DATABASE_URL=postgresql://asafarim:asafarim_dev@127.0.0.1:55435/asafarim

# testora keeps its own database (drizzle/pg), separate from the shared Prisma
# Postgres above. Container: e2e-testora-db on host port 55434.
TESTORA_DATABASE_URL=postgres://e2e_testora:e2e_testora@127.0.0.1:55434/e2e-testing-db

# AppBuilder keeps its OWN database, separate from the platform's shared
# Prisma Postgres and from testora's. Container: appbuilder-db on host port
# 55436. See docker-compose.yml and apps/appbuilder/.env.local.example.
APPBUILDER_DB_PASSWORD=appbuilder_dev
APPBUILDER_DATABASE_URL=postgres://appbuilder:appbuilder_dev@127.0.0.1:55436/appbuilder
# DISTINCT scratch database for `pnpm test:integration` — required by
# lib/db/testDbGuard.ts. Never point this at the same database as above.
APPBUILDER_TEST_DATABASE_URL=postgres://appbuilder:appbuilder_dev@127.0.0.1:55436/appbuilder_test

# ─── Auth.js v5 ──────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
# (PowerShell: Add-Type -AssemblyName System.Web; [System.Web.Security.Membership]::GeneratePassword(32,0))
AUTH_SECRET=dev-secret-change-me-32-chars-minimum
AUTH_URL=http://localhost:3001
NEXTAUTH_URL=http://localhost:3001
AUTH_TRUST_HOST=true
# Leave empty in development (cookies default to localhost, shared across ports)
AUTH_COOKIE_DOMAIN=

# ─── Google OAuth (optional) ─────────────────────────────────────────────────
# Get from: https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/callback/google

# ─── Email One-Time Login Code (OTP) ─────────────────────────────────────────
# Duration a one-time login code is valid (minutes). Default: 10
EMAIL_LOGIN_CODE_TTL_MINUTES=10
# Max code requests per email per window before rate-limiting. Default: 5
EMAIL_CODE_MAX_REQUESTS=5
# Sliding window for request rate limit (minutes). Default: 15
EMAIL_CODE_REQUEST_WINDOW_MINUTES=15
# Max failed verify attempts per code before it is locked. Default: 5
EMAIL_CODE_MAX_ATTEMPTS=5
# Reserved for a future password-reset-by-email flow (not yet implemented).
PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# ─── SMTP (email delivery for OTP login codes) ───────────────────────────────
# Required for the "Email code" sign-in method to actually send mail locally.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="ASafarIM <no-reply@asafarim.com>"
SMTP_SECURE=true
SMTP_REQUIRE_TLS=false
SMTP_BCC=
# Optional verbose SMTP transport logging — leave off unless debugging delivery.
SMTP_DEBUG=false
SMTP_LOGGING=false

# ─── Database seed (pnpm db:seed) ────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@asafarim.com
SEED_ADMIN_PASSWORD=Admin+123456

# ─── Branding ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_COMPANY_NAME="ASafarIM Digital"
NEXT_PUBLIC_PLATFORM_NAME="ASafarIM Platform"
NEXT_PUBLIC_HUB_NAME="ASafarIM Hub"

# ─── App URLs (local dev ports) ──────────────────────────────────────────────
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_HUB_URL=http://localhost:3001
NEXT_PUBLIC_SHOWCASE_URL=http://localhost:3002
NEXT_PUBLIC_ADMIN_URL=http://localhost:3003
NEXT_PUBLIC_VIONTO_URL=http://localhost:3004
NEXT_PUBLIC_TESTORA_URL=http://localhost:3005
NEXT_PUBLIC_APPBUILDER_URL=http://localhost:3006
NEXT_PUBLIC_EDUMATCH_URL=http://localhost:3009
# DevTools is a separate deployment on asafarim.be, not part of the local dev monorepo.
NEXT_PUBLIC_DEVTOOLS_URL=https://asafarim.be
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# ─── Redis / BullMQ ──────────────────────────────────────────────────────────
# Host port 6390 — see docker-compose.yml (6379/6380 often taken locally).
REDIS_URL=redis://localhost:6390

# ─── AI providers ────────────────────────────────────────────────────────────
# Used by AppBuilder's generation pipeline and available for integration work.
APPBUILDER_AI_PROVIDER=openai
APPBUILDER_AI_OPENAI_API_KEY=
# Full-spec generation with structured output can exceed the 30s default,
# causing a misleading "provider was temporarily unavailable" error.
APPBUILDER_AI_REQUEST_TIMEOUT_MS=120000

# ─── OpenAI ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_MAX_OUTPUT_TOKENS=8000

# ─── Anthropic ───────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
ANTHROPIC_MAX_TOKENS=2000

# ─── Transactional email / misc third-party APIs ─────────────────────────────
# Get API key from https://resend.com
RESEND_API_KEY=
FROM_EMAIL="ASafarIM <noreply@asafarim.com>"
ELEVENLABS_API_KEY=
# Get API key from https://pixabay.com/api/
PIXABAY_API_KEY=

# ─── Vionto real-pipeline integrations ───────────────────────────────────────
# These only matter once Vionto grows past benchmarks/vionto's synthetic
# showcase into a real rendering pipeline.
VIONTO_STORAGE_DRIVER=local
WORKER_HEALTH_PORT=3007
FFMPEG_PATH=
KLING_API_KEY=
KLING_API_SECRET=
# Google Photos import — moved to apps/vionto/.env.local (separate OAuth client).
# See apps/vionto/.env.example and apps/vionto/docs/google-photos-import.md.
# GOOGLE_PHOTOS_CLIENT_ID=
# GOOGLE_PHOTOS_CLIENT_SECRET=
# GOOGLE_PHOTOS_REDIRECT_URI=
# GOOGLE_PHOTOS_SCOPES=https://www.googleapis.com/auth/photospicker.mediaitems.readonly
# 32-byte AES-256-GCM key for encrypting stored OAuth tokens (openssl rand -hex 32).
VIONTO_TOKEN_ENCRYPTION_KEY=

# ─── DigitalOcean Spaces (object storage) ────────────────────────────────────
DO_SPACES_ENDPOINT=https://fra1.digitaloceanspaces.com
DO_SPACES_PUBLIC_URL=https://asafarim-platform.fra1.digitaloceanspaces.com
DO_SPACES_ACCESS_KEY_ID=<your-spaces-access-key>
DO_SPACES_SECRET_ACCESS_KEY=<your-spaces-secret-key>
DO_SPACES_BUCKET_NAME=asafarim-platform
DO_SPACES_REGION=fra1
STORAGE_DRIVER=spaces

# ─── Tailscale ────────────────────────────────────────────────
#TailScale webhook secret
TAILSCALE_WEBHOOK_SECRET=tskey-webhook-kEaLFHkyym11CNTRL-Emw7KPS4waiwcPXss84uaivdKytnSwRST
# Create a Tailscale API credential (OAuth client is preferred over a personal API access token — it doesn't expire when you leave the account, and you can scope it tightly):
TAILSCALE_API_KEY=tskey-client-...
TAILSCALE_TAILNET=kGNQbsXkq111CNTRL