# Production environment — copy to .env.production, encrypt with Envage, and
# provision the private key on the VPS. Never commit the plaintext file.

NODE_ENV=production

# VPS address used by infra/scripts/deploy-prod.sh (exported SERVER_HOST wins).
SERVER_HOST=your_vps_ip_or_domain
NEXT_PUBLIC_SERVER_HOST=your_vps_ip_or_domain

# ─── Database (inside the compose network) ───────────────────────────────────
POSTGRES_USER=asafarim
POSTGRES_PASSWORD=change_me
POSTGRES_DB=asafarim
DATABASE_URL=postgresql://asafarim:change_me@postgres:5432/asafarim

# ─── Auth.js v5 ──────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=change_me
AUTH_URL=https://hub.asafarim.com
NEXTAUTH_URL=https://hub.asafarim.com
AUTH_TRUST_HOST=true
# Cross-subdomain SSO cookie domain
AUTH_COOKIE_DOMAIN=.asafarim.com

# ─── Google OAuth (optional) ─────────────────────────────────────────────────
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GOOGLE_CALLBACK_URL=https://hub.asafarim.com/api/auth/callback/google

# ─── Email One-Time Login Code (OTP) ─────────────────────────────────────────
EMAIL_LOGIN_CODE_TTL_MINUTES=10
EMAIL_CODE_MAX_REQUESTS=5
EMAIL_CODE_REQUEST_WINDOW_MINUTES=15
EMAIL_CODE_MAX_ATTEMPTS=5
# Reserved for a future password-reset-by-email flow (not yet implemented).
PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# ─── SMTP (email delivery for OTP login codes) ───────────────────────────────
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="ASafarIM <no-reply@asafarim.com>"
SMTP_SECURE=true
SMTP_REQUIRE_TLS=false
SMTP_BCC=
SMTP_DEBUG=false
SMTP_LOGGING=false

# ─── Branding ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_COMPANY_NAME="ASafarIM Digital"
NEXT_PUBLIC_PLATFORM_NAME="ASafarIM Platform"
NEXT_PUBLIC_HUB_NAME="ASafarIM Hub"
NEXT_PUBLIC_SHOWCASE_NAME="ASafarIM Showcases"
NEXT_PUBLIC_ADMIN_NAME="ASafarIM Admin Console"
NEXT_PUBLIC_VIONTO_NAME="ASafarIM Vionto"
NEXT_PUBLIC_TESTORA_NAME="ASafarIM Testora"
NEXT_PUBLIC_APPBUILDER_NAME="ASafarIM Appbuilder"

# ─── App URLs (production domains) ───────────────────────────────────────────
NEXT_PUBLIC_WEB_URL=https://asafarim.com
NEXT_PUBLIC_HUB_URL=https://hub.asafarim.com
NEXT_PUBLIC_SHOWCASE_URL=https://showcase.asafarim.com
NEXT_PUBLIC_ADMIN_URL=https://admin.asafarim.com
NEXT_PUBLIC_VIONTO_URL=https://vionto.asafarim.com
NEXT_PUBLIC_TESTORA_URL=https://testora.asafarim.com
NEXT_PUBLIC_APPBUILDER_URL=https://appbuilder.asafarim.com
NEXT_PUBLIC_EDUMATCH_URL=https://edumatch.asafarim.com
NEXT_PUBLIC_TIMELINEAI_URL=https://tlai.asafarim.com
NEXT_PUBLIC_LABS_URL=https://labs.asafarim.com
NEXT_PUBLIC_RESUMATCH_URL=https://resumatch.asafarim.com
NEXT_PUBLIC_TASKSAI_URL=https://tasks-ai.asafarim.com

# DevTools lives on a separate domain (asafarim.be), not a subdomain of asafarim.com.
NEXT_PUBLIC_DEVTOOLS_URL=https://asafarim.be
NEXT_PUBLIC_API_URL=https://api.asafarim.com

# ─── timelineai (guest identity) ──────────────────────────────────────────────
# HMAC key used to hash guest IPs before storing them — never store raw IPs.
# Generate once with: openssl rand -hex 32
TIMELINEAI_GUEST_IP_HASH_KEY=

# ─── testora (own database + private-app unlock) ─────────────────────────────
# Password for testora's own Postgres (compose interpolates this into the
# testora-postgres service and the TESTORA_DATABASE_URL connection string).
TESTORA_DB_PASSWORD=<openssl rand -hex 24>
# Signs the "unlock" cookie for private apps (openssl rand -hex 32).
TESTORA_SECRET=<openssl rand -hex 32>
# Default GitHub target for bug reports filed from Testora (any app without its
# own repo set in Apps). Every ASafarIM product reports to the platform repo.
# The token needs Issues read/write on that repo (fine-grained PAT) and is
# only ever used server-side. Leave both empty to disable GitHub reporting.
TESTORA_GITHUB_REPO=AliSafari-IT/asafarim-platform
TESTORA_GITHUB_TOKEN=<github fine-grained PAT with Issues: read & write>

# ─── appbuilder (own database) ────────────────────────────────────────────────
# Password for appbuilder's own Postgres (compose interpolates this into the
# appbuilder-postgres service and POSTGRES_PASSWORD). Never reuse
# DATABASE_URL for AppBuilder product data — see docs/appbuilder-architecture.md.
APPBUILDER_DB_PASSWORD=<openssl rand -hex 24>
# URL-encoded form of APPBUILDER_DB_PASSWORD above (chars like '/' are
# illegal unencoded in a URI userinfo). Used only for the
# APPBUILDER_DATABASE_URL connection string interpolation in
# docker-compose.prod.yml (appbuilder-migrate, appbuilder-worker, appbuilder).
# Regenerate with: node -e "console.log(encodeURIComponent(process.argv[1]))" '<password>'
APPBUILDER_DB_PASSWORD_URL=<url-encoded form of APPBUILDER_DB_PASSWORD>

# ─── resumatch ─────────────────────────────────────────────────────────────
# Password for resumatch's own Postgres (compose interpolates this into the
# resumatch-postgres service and POSTGRES_PASSWORD). Never reuse DATABASE_URL
# for ResuMatch data — CV-derived data needs a stricter boundary than identity
# traffic; see apps/resumatch/docs/threat-model.md.
RESUMATCH_DB_PASSWORD=<openssl rand -hex 24>
# URL-encoded form of RESUMATCH_DB_PASSWORD above, used for the
# RESUMATCH_DATABASE_URL interpolation in docker-compose.prod.yml.
# Regenerate with: node -e "console.log(encodeURIComponent(process.argv[1]))" '<password>'
RESUMATCH_DB_PASSWORD_URL=<url-encoded form of RESUMATCH_DB_PASSWORD>
# ClamAV sidecar for CV uploads (issue #203). No variable to set here: the
# clamav service and RESUMATCH_SCANNER_URL are both wired directly in
# docker-compose.prod.yml, since the sidecar's hostname and port are fixed
# by the compose file itself, not an operator choice. Until clamav reports
# healthy (a few minutes after every restart, while it downloads its virus
# database), ResuMatch quarantines every upload — a fail-closed default. See
# apps/resumatch/docs/threat-model.md.
# Bearer token for POST /api/retention, which deletes CV originals past
# their 90-day window. Unset disables the route entirely rather than
# leaving it unauthenticated.
RESUMATCH_RETENTION_TOKEN=<openssl rand -hex 32>

# AI env contract (JM-005 gate, issue #255). Leave at "fixture" — that's
# the only value that boots cleanly here without the two lines below.
# Flipping to a real provider in production is a config-only change (no
# code edit): set RESUMATCH_AI_PROVIDER to "openai"/"anthropic", set
# RESUMATCH_AI_CLASSIFICATION_SIGNED_OFF=true only once JM-005 is actually
# signed off, and make sure the matching OPENAI_API_KEY/ANTHROPIC_API_KEY
# is set below. Missing either half of the gate refuses startup and names
# RESUMATCH_AI_CLASSIFICATION_SIGNED_OFF, never a value. Note: both real
# adapters are currently unimplemented stubs regardless of this gate.
RESUMATCH_AI_PROVIDER=fixture
RESUMATCH_AI_CLASSIFICATION_SIGNED_OFF=false
RESUMATCH_AI_MONTHLY_BUDGET_USD=20

# ─── appbuilder M07 AI generation pipeline ────────────────────────────────────
# Read only by the appbuilder-worker service (docker-compose.prod.yml), never
# the Next.js app. See docs/appbuilder-m07-ai-generation.md. Defaults to the
# deterministic "fake" provider so this service is never billable until an
# operator deliberately sets APPBUILDER_AI_PROVIDER=openai.
APPBUILDER_AI_PROVIDER=fake
# Leave blank to fall back to the shared OPENAI_API_KEY/OPENAI_MODEL below.
APPBUILDER_AI_OPENAI_API_KEY=
APPBUILDER_WORKER_CONCURRENCY=2

# ─── AI providers (shared platform keys) ─────────────────────────────────────
# OPENAI_API_KEY/OPENAI_MODEL are shared across apps that opt in — appbuilder's
# worker falls back to these when APPBUILDER_AI_OPENAI_API_KEY is unset.
# Benchmarks in this repo (ai-eval, testora, edumatch, vionto) run in
# fixture-mode against committed synthetic data, not live provider calls.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_OUTPUT_TOKENS=8000
ANTHROPIC_API_KEY=sk-ant-api03-***
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_VISION_MODEL=claude-opus-5
ANTHROPIC_MAX_TOKENS=2048

# ─── Transactional email / misc third-party APIs (reserved) ─────────────────
RESEND_API_KEY=
FROM_EMAIL="ASafarIM <noreply@asafarim.com>"
ELEVENLABS_API_KEY=
PIXABAY_API_KEY=

# ─── Vionto real-pipeline integrations (reserved — benchmark is fixture-only)
REDIS_URL=redis://redis:6379
FFMPEG_PATH=
# Kling AI image-to-video (AI motion clips). JWT auth is built server-side
# from these keys — never expose them via NEXT_PUBLIC_*.
KLING_API_KEY=
KLING_API_SECRET=
# Optional overrides — defaults: https://api-singapore.klingai.com / kling-v1-6
KLING_API_BASE=
KLING_MODEL=
# AI-director provider keys (server env fallback; users may override via BYOK).
# Only set what you use — the app degrades gracefully when a provider is absent.
FAL_KEY=
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
GOOGLE_TTS_API_KEY=
# OAuth client in the "asafarim-platform-vionto" Google Cloud project
# (585671975647-…). Both this URI and the localhost dev URI are registered.
GOOGLE_PHOTOS_CLIENT_ID=
GOOGLE_PHOTOS_CLIENT_SECRET=
GOOGLE_PHOTOS_REDIRECT_URI=https://vionto.asafarim.com/api/integrations/google-photos/callback
GOOGLE_PHOTOS_SCOPES=https://www.googleapis.com/auth/photospicker.mediaitems.readonly
# 32-byte AES-256-GCM key for encrypting stored OAuth tokens (openssl rand -hex 32).
VIONTO_TOKEN_ENCRYPTION_KEY=

# DO Spaces bucket configuration
DO_SPACES_ENDPOINT=https://fra1.digitaloceanspaces.com
DO_SPACES_PUBLIC_URL=https://asafarim-platform.fra1.digitaloceanspaces.com
DO_SPACES_ACCESS_KEY_ID=DO00Y26UMAWPH22UR864
DO_SPACES_SECRET_ACCESS_KEY=<paste the full secret key from the modal>
DO_SPACES_BUCKET_NAME=asafarim-platform
DO_SPACES_REGION=fra1
# Optional: explicit public URL for loaded objects. Defaults to the bucket subdomain
# of the endpoint (e.g. https://asafarim-platform.fra1.digitaloceanspaces.com).
# DO_SPACES_PUBLIC_URL=https://asafarim-platform.fra1.digitaloceanspaces.com

# ─── Tailscale ────────────────────────────────────────────────
# TailScale webhook secret
TAILSCALE_WEBHOOK_SECRET=<tskey-webhook-...>
# Tailscale API access token for the admin Devices page (tskey-api-..., expires after max 90 days).
# Create at https://login.tailscale.com/admin/settings/keys -> API access tokens.
# NOT an auth key (tskey-auth-...) and NOT an OAuth client secret (tskey-client-...): both return 401.
TAILSCALE_API_KEY=<tskey-api-...>
TAILSCALE_TAILNET=<your-tailnet-id>

# Webhook secrets (optional)
WEBHOOK_SECRET_DISCORD=<Generate a secure random discord webhook secret>

# ─── EduMatch ────────────────────────────────────────────────
# seeding users credentials
EDUMATCH_SEED_USERS_PASSWORD=<your-seed-users-password>

# JSON array of emails granted the superadmin role on every sign-in, in
# addition to SEED_ADMIN_EMAIL's one-time bootstrap admin.
SUPERADMIN_EMAILS=["asafarim@gmail.com"]
# JSON array of emails (in addition to superadmins) allowed to view the
# EduMatch internal Business Plan at /admin/business-plan. The owner's own
# accounts that should see the strategy doc without holding a platform-wide
# role. Read server-side only (not NEXT_PUBLIC_*); see
# apps/edumatch/lib/business-plan-access.ts.
BUSINESS_PLAN_ALLOWLISTED_EMAILS=["asafarim@gmail.com"]


# ─── Admin console settings encryption ───────────────────────────────────────
# Encrypts "secret"-type PlatformSetting rows (Stripe/SMTP/AI keys). Separate
# from AUTH_SECRET on purpose — see docs/environment-management.md.
# Generate with: openssl rand -base64 32
SETTINGS_ENCRYPTION_KEY=change_me

# ─── Internal service-to-service auth ────────────────────────────────────────
# Shared bearer secret for server-to-server calls between apps (e.g. the
# admin console's User 360 explorer reading isolated-DB apps' own
# /api/internal/user-activity endpoint). Generate with: openssl rand -hex 32
INTERNAL_API_SECRET=change_me